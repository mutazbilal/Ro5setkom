@using ro5setkom.ViewModels.Auth
@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

@section Styles {
    <link rel="stylesheet" href="~/css/forgotpassword.css" asp-append-version="true" />
}

<main class="forgot-wrapper" aria-label="Forgot password page">
    <article class="auth-card forgot-card">
        <a asp-controller="Auth" asp-action="Login"
           class="auth-link"
           style="display:inline-flex;align-items:center;gap:8px;margin-bottom:8px;">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
            Back to Login
        </a>

        <h1 class="auth-card__title">Reset Your Password</h1>
        <p class="auth-card__subtitle">
            Enter your registered email address and we'll send you a reset link.
        </p>

        <div asp-validation-summary="ModelOnly"
             class="auth-error-banner"
             role="alert"
             aria-live="assertive"></div>

        <form asp-controller="Auth" asp-action="ForgotPassword" method="post"
              class="auth-form" novalidate>

            <div class="auth-field">
                <input asp-for="Email"
                       class="auth-input"
                       type="email"
                       placeholder=" "
                       autocomplete="email"
                       aria-required="true"
                       aria-describedby="resetEmailHelp" />
                <label asp-for="Email" class="auth-label">Email Address</label>
                <span id="resetEmailHelp" class="sr-only">Enter the email address tied to your account.</span>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <button class="auth-btn" type="submit">Send Reset Link</button>

            <a asp-controller="Auth" asp-action="Login"
               class="auth-link"
               style="text-align:center;display:block;margin-top:10px;">Back to Login</a>
        </form>
    </article>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
