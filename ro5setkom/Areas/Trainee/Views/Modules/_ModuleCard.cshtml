@model ro5setkom.Areas.Trainee.ViewModels.Modules.ModuleCardViewModel
@using ro5setkom.Resources
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResourceMarker> L

@{
    var borderClass = Model.Status switch
    {
        "completed" => "border-success",
        "in_progress" => "border-primary",
        _ => Model.IsLocked ? "border-secondary" : "border-light"
    };
}

<div class="card h-100 shadow-sm @borderClass border-2">
    <div class="card-body">

        <div class="d-flex justify-content-between align-items-start mb-2">
            <h6 class="card-title fw-bold mb-0">@Model.Title</h6>

            @if (Model.IsLocked)
            {
                <i class="bi bi-lock-fill text-secondary fs-5"
                   title="@L["Module_LockedTooltip"]"></i>
            }
            else if (Model.Status == "completed")
            {
                <i class="bi bi-check-circle-fill text-success fs-5"
                   title="@L["Module_CompletedTooltip"]"></i>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="card-text text-muted small">@Model.Description</p>
        }

        <div class="d-flex gap-2 flex-wrap mb-3">

            <span class="badge bg-light text-dark border">
                @(Model.Phase == "theoretical"
                    ? $"📘 {L["Module_Theory"]}"
                    : $"🚗 {L["Module_Practical"]}")
            </span>

            @{
                var statusBadge = Model.Status switch
                {
                    "completed" => ("bg-success", L["Status_Completed"]),
                    "in_progress" => ("bg-primary", L["Status_InProgress"]),
                    _ => ("bg-secondary", L["Status_NotStarted"])
                };
            }

            <span class="badge @statusBadge.Item1">@statusBadge.Item2</span>

            @if (Model.HasQuiz)
            {
                <span class="badge @(Model.QuizPassed ? "bg-success" : "bg-warning text-dark")">
                    @L["Quiz_Label"]:
                    @(Model.QuizPassed? L["Quiz_PassedShort"] : L["Quiz_NotPassedShort"])
                </span>
            }

        </div>
    </div>

    <div class="card-footer bg-transparent">

        @if (Model.IsLocked)
        {
            <button class="btn btn-secondary btn-sm w-100" disabled>
                <i class="bi bi-lock"></i> @L["Module_Locked"]
            </button>
        }
        else
        {
            <a asp-area="Trainee" asp-controller="Modules" asp-action="Detail"
                   asp-route-id="@Model.ModuleId"
                   class="btn btn-outline-primary btn-sm w-100">

                @(Model.Status == "not_started"
                    ? L["Module_Start"]
                    : Model.Status == "in_progress"
                        ? L["Module_Continue"]
                        : L["Module_Review"])
            </a>
        }

    </div>
</div>