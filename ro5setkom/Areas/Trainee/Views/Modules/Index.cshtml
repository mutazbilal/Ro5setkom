@using ro5setkom.Areas.Trainee.ViewModels.Modules
@using ro5setkom.Resources
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResourceMarker> L

@model ModuleListViewModel
@{
    ViewData["Title"] = L["Modules_Title"];
}

<div class="container py-4">

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">
            @L["Modules_Title"]
            <small class="text-muted fs-6">— @Model.LicenseTypeName</small>
        </h2>

        <a asp-area="Trainee" asp-controller="Dashboard" asp-action="Index"
               class="btn btn-outline-secondary btn-sm">
            @L["Nav_Dashboard"]
        </a>
    </div>

    <!-- Theoretical -->
    <h5 class="text-info fw-semibold mb-3">
        <i class="bi bi-journal-text"></i> @L["Modules_Theoretical"]
    </h5>

    <div class="row g-3 mb-5">
        @foreach (var m in Model.TheoreticalModules)
        {
            <div class="col-md-4">
                @await Html.PartialAsync("_ModuleCard", m)
            </div>
        }

        @if (!Model.TheoreticalModules.Any())
        {
            <p class="text-muted">@L["Modules_NoneTheoretical"]</p>
        }
    </div>

    <!-- Mock Exam -->
    @if (Model.IsMockExamAvailable)
    {
        <div class="alert @(Model.IsMockExamCompleted ? "alert-success" : "alert-warning") d-flex justify-content-between align-items-center mb-4">
            <span>
                <strong>@L["MockExam_Title"]:</strong>
                @(Model.IsMockExamCompleted
                    ? L["MockExam_Completed"]
                    : L["MockExam_UnlockMessage"])
            </span>

            <a asp-area="Trainee" asp-controller="Quiz" asp-action="MockExam"
                   class="btn btn-sm @(Model.IsMockExamCompleted ? "btn-outline-success" : "btn-warning")">
                @(Model.IsMockExamCompleted
                    ? L["MockExam_Retake"]
                    : L["MockExam_Start"])
            </a>
        </div>
    }

    <!-- Practical -->
    <h5 class="text-warning fw-semibold mb-3">
        <i class="bi bi-car-front-fill"></i> @L["Modules_Practical"]
    </h5>

    <div class="row g-3">
        @foreach (var m in Model.PracticalModules)
        {
            <div class="col-md-4">
                @await Html.PartialAsync("_ModuleCard", m)
            </div>
        }

        @if (!Model.PracticalModules.Any())
        {
            <p class="text-muted">@L["Modules_NonePractical"]</p>
        }
    </div>
</div>