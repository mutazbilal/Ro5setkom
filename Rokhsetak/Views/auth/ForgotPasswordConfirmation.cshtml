@{
    ViewData["Title"] = "Check Your Email";
}

@section Styles {
    <link rel="stylesheet" href="~/css/forgotpassword.css" asp-append-version="true" />
}

<main class="forgot-wrapper" aria-label="Password reset email sent">
    <article class="auth-card forgot-card" style="text-align:center;">
        <div class="forgot-envelope" aria-hidden="true">
            <i class="fa-regular fa-envelope"></i>
        </div>

        <h1 class="auth-card__title">Check Your Inbox</h1>
        <p class="auth-card__subtitle">
            If an account with that email exists, a password reset link has been sent.
            The link will expire in 1 hour.
        </p>

        <a asp-controller="Auth" asp-action="Login"
           class="auth-link"
           style="display:inline-block;margin-top:16px;">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
            Back to Login
        </a>
    </article>
</main>
