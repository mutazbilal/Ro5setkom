@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResourceMarker> L
@{
    ViewData["Title"] = L["Auth_CheckEmail_Title"];
}

@section Styles {
    <link rel="stylesheet" href="~/css/forgotpassword.css" asp-append-version="true" />
}

<main class="forgot-wrapper" aria-label="@L["Auth_CheckEmail_Title"]">
    <article class="auth-card forgot-card" style="text-align:center;">
        <div class="forgot-envelope" aria-hidden="true">
            <i class="fa-regular fa-envelope"></i>
        </div>

        <h1 class="auth-card__title">@L["Auth_CheckEmail_Title"]</h1>
        <p class="auth-card__subtitle">
            @L["Auth_CheckEmail_Message"]
        </p>

        <a asp-controller="Auth" asp-action="Login"
           class="auth-link"
           style="display:inline-block;margin-top:16px;">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
            @L["Auth_BackToLogin"]
        </a>
    </article>
</main>