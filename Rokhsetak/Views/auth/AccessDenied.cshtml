@using Microsoft.Extensions.Localization
@using Rokhsetak.Resources

@inject IStringLocalizer<Rokhsetak.Resources.SharedResourceMarker> L
@{
    ViewData["Title"] = L["Auth_AccessDenied_Title"];
}

<main style="min-height:100vh;display:grid;place-items:center;padding:24px;"
      aria-label="@L["Auth_AccessDenied_Title"]">
    <article class="auth-card" style="max-width:460px;text-align:center;">
        <div style="font-size:3rem;color:var(--color-secondary);margin-bottom:14px;" aria-hidden="true">
            <i class="fa-solid fa-lock"></i>
        </div>

        <h1 class="auth-card__title" style="margin-bottom:10px;">@L["Auth_AccessDenied_Title"]</h1>
        <p class="auth-card__subtitle">
            @L["Auth_AccessDenied_Message"]
        </p>

        <div style="display:grid;gap:10px;margin-top:20px;">
            @if (User.IsInRole("admin"))
            {
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                   class="auth-btn"
                   style="display:inline-flex;align-items:center;justify-content:center;gap:8px;text-decoration:none;">
                    <i class="fa-solid fa-gauge-high" aria-hidden="true"></i> @L["Auth_GoToDashboard"]
                </a>
            }
            else if (User.IsInRole("mentor"))
            {
                <a asp-area="Mentor" asp-controller="Dashboard" asp-action="Index"
                   class="auth-btn"
                   style="display:inline-flex;align-items:center;justify-content:center;gap:8px;text-decoration:none;">
                    <i class="fa-solid fa-gauge-high" aria-hidden="true"></i> @L["Auth_GoToDashboard"]
                </a>
            }
            else
            {
                <a asp-area="Trainee" asp-controller="Dashboard" asp-action="Index"
                   class="auth-btn"
                   style="display:inline-flex;align-items:center;justify-content:center;gap:8px;text-decoration:none;">
                    <i class="fa-solid fa-gauge-high" aria-hidden="true"></i> @L["Auth_GoToDashboard"]
                </a>
            }

            @* Logout must be POST — never a plain link *@
            <form asp-controller="Auth" asp-action="Logout" method="post">
                <button type="submit" class="auth-btn-ghost"
                        style="width:100%;display:inline-flex;align-items:center;justify-content:center;gap:8px;">
                    <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i> @L["Auth_Logout"]
                </button>
            </form>
        </div>
    </article>
</main>