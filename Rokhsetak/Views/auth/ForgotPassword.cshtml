@using Rokhsetak.ViewModels.Auth
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResourceMarker> L
@model ForgotPasswordViewModel
@{
    ViewData["Title"] = L["Auth_ForgotPassword_Title"];
}

@section Styles {
    <link rel="stylesheet" href="~/css/forgotpassword.css" asp-append-version="true" />
}

<main class="forgot-wrapper" aria-label="@L["Auth_ForgotPassword_Title"]">
    <article class="auth-card forgot-card">
        <a asp-controller="Auth" asp-action="Login"
           class="auth-link"
           style="display:inline-flex;align-items:center;gap:8px;margin-bottom:8px;">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
            @L["Auth_BackToLogin"]
        </a>

        <h1 class="auth-card__title">@L["Auth_ForgotPassword_Title"]</h1>
        <p class="auth-card__subtitle">
            @L["Auth_ForgotPassword_Subtitle"]
        </p>

        <div asp-validation-summary="ModelOnly"
             class="auth-error-banner"
             role="alert"
             aria-live="assertive"></div>

        <form asp-controller="Auth" asp-action="ForgotPassword" method="post"
              class="auth-form" novalidate>

            <div class="auth-field">
                <input asp-for="Email"
                       class="auth-input"
                       type="email"
                       placeholder=" "
                       autocomplete="email"
                       aria-required="true"
                       aria-describedby="resetEmailHelp" />
                <label asp-for="Email" class="auth-label">@L["Auth_ForgotPassword_EmailLabel"]</label>
                <span id="resetEmailHelp" class="sr-only">@L["Auth_ForgotPassword_EmailHelp"]</span>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <button class="auth-btn" type="submit">@L["Auth_ForgotPassword_SendLink"]</button>

            <a asp-controller="Auth" asp-action="Login"
               class="auth-link"
               style="text-align:center;display:block;margin-top:10px;">@L["Auth_BackToLogin"]</a>
        </form>
    </article>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}