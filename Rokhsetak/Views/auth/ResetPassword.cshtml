@using Rokhsetak.ViewModels.Auth
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResourceMarker> L
@model ResetPasswordViewModel
@{
    ViewData["Title"] = L["Auth_ResetPassword_Title"];
}

@section Styles {
    <link rel="stylesheet" href="~/css/forgotpassword.css" asp-append-version="true" />
}

<main class="forgot-wrapper" aria-label="@L["Auth_ResetPassword_Title"]">
    <article class="auth-card forgot-card">
        <h1 class="auth-card__title">@L["Auth_ResetPassword_Title"]</h1>
        <p class="auth-card__subtitle">@L["Auth_ResetPassword_Subtitle"]</p>

        <div asp-validation-summary="ModelOnly"
             class="auth-error-banner"
             role="alert"
             aria-live="assertive"></div>

        <form asp-controller="Auth" asp-action="ResetPassword" method="post"
              class="auth-form" novalidate>

            @* Mandatory — without this the POST fails server-side validation *@
            <input asp-for="Token" type="hidden" />

            <div class="auth-field">
                <input asp-for="NewPassword"
                       class="auth-input"
                       type="password"
                       placeholder=" "
                       autocomplete="new-password"
                       aria-required="true" />
                <label asp-for="NewPassword" class="auth-label">@L["Auth_NewPassword"]</label>
                <button type="button" class="auth-password-toggle"
                        data-password-toggle data-target="NewPassword"
                        aria-label="@L["Auth_ShowPassword"]">
                    <i class="fa-solid fa-eye" aria-hidden="true"></i>
                </button>
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <div class="auth-field">
                <input asp-for="ConfirmPassword"
                       class="auth-input"
                       type="password"
                       placeholder=" "
                       autocomplete="new-password"
                       aria-required="true" />
                <label asp-for="ConfirmPassword" class="auth-label">@L["Auth_ConfirmPassword"]</label>
                <button type="button" class="auth-password-toggle"
                        data-password-toggle data-target="ConfirmPassword"
                        aria-label="@L["Auth_ShowConfirmPassword"]">
                    <i class="fa-solid fa-eye" aria-hidden="true"></i>
                </button>
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button class="auth-btn" type="submit">@L["Auth_ResetPassword_Button"]</button>
        </form>
    </article>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}