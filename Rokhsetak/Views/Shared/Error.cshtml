@using Rokhsetak.ViewModels
@using Rokhsetak.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResourceMarker> L
@model ErrorViewModel
@{
    ViewData["Title"] = L["Error_GeneralTitle"];
}

<h1 class="text-danger">@L["Error_GeneralTitle"]</h1>
<h2 class="text-danger">@L["Error_General"]</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@L["Error_RequestId"]:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>@L["Error_DevelopmentMode"]</h3>
<p>
    @Html.Raw(string.Format(L["Error_DevelopmentModeDesc"], "<strong>Development</strong>"))
</p>
<p>
    <strong>@L["Error_DevelopmentModeWarning"]</strong>
    @L["Error_DevelopmentModeWarningDesc"]
</p>