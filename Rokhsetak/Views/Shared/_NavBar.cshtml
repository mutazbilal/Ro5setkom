@*
    Rokhsetak — Top navigation partial.
*@

@using System.Security.Claims
@using Microsoft.Extensions.Localization
@using Rokhsetak.Resources
@inject IStringLocalizer<Rokhsetak.Resources.SharedResourceMarker> L
@inject Rokhsetak.Services.Interfaces.INotificationService NotificationService

@{
    var isAuth = User.Identity != null && User.Identity.IsAuthenticated;
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString() ?? "";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString() ?? "";
    var currentLang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;

    if (returnUrl.Contains("/Trainee/Quiz/Submit"))
        returnUrl = "trainee/modules";

    bool IsActive(string area, string controller, string action) =>
        string.Equals(currentArea, area, System.StringComparison.OrdinalIgnoreCase) &&
        string.Equals(currentController, controller, System.StringComparison.OrdinalIgnoreCase) &&
        string.Equals(currentAction, action, System.StringComparison.OrdinalIgnoreCase);

    string ActiveClass(string area, string controller, string action) =>
        IsActive(area, controller, action) ? "is-active" : null;

    string ActiveAria(string area, string controller, string action) =>
        IsActive(area, controller, action) ? "page" : null;

    // Controller-scoped variant: true whenever the user is anywhere inside the given controller.
    // Used for multi-page sections (e.g. Profile/Index, Profile/Edit, Profile/ChangeLicense).
    bool IsActiveController(string area, string controller) =>
        string.Equals(currentArea, area, System.StringComparison.OrdinalIgnoreCase) &&
        string.Equals(currentController, controller, System.StringComparison.OrdinalIgnoreCase);

    string ActiveControllerClass(string area, string controller) =>
        IsActiveController(area, controller) ? "is-active" : null;

    string ActiveControllerAria(string area, string controller) =>
        IsActiveController(area, controller) ? "page" : null;

    // Notifications
    var userIdClaim = User.FindFirstValue(ClaimTypes.NameIdentifier);
    int userId = 0;

    if (!string.IsNullOrEmpty(userIdClaim))
        int.TryParse(userIdClaim, out userId);

    var notifications = new List<Rokhsetak.Models.Notification>();
    var unreadCount = 0;

    if (userId > 0)
    {
        notifications = await NotificationService.GetUserNotificationsAsync(userId);
        unreadCount = await NotificationService.GetUnreadCountAsync(userId);
    }
}

<header class="landing-nav">

    <a asp-area=""
       asp-controller="Home"
       asp-action="Index"
       class="landing-brand"
       aria-label="Rokhsetak — @L["Nav_Home"]">
        <span class="landing-brand__logo" aria-hidden="true">
            <i class="fa-solid fa-shield-halved"></i>
        </span>
        <span class="landing-brand__name">Rokhsetak</span>
    </a>

    @if (isAuth)
    {
        <input type="checkbox"
               id="rk-nav-toggle"
               class="landing-nav__check"
               aria-label="@L["Nav_ToggleMenu"]"
               aria-controls="rk-nav-cluster" />

        <label for="rk-nav-toggle" class="landing-nav__toggle">
            <i class="fa-solid fa-bars landing-nav__toggle-open" aria-hidden="true"></i>
            <i class="fa-solid fa-xmark landing-nav__toggle-close" aria-hidden="true"></i>
        </label>
    }

    <div id="rk-nav-cluster" class="landing-nav__cluster">

        @if (isAuth)
        {
            <nav aria-label="Primary">
                <ul class="landing-nav__list">

                    @if (User.IsInRole("trainee"))
                    {
                        <li>
                            <a asp-area="Trainee" asp-controller="Dashboard" asp-action="Index"
                               class="landing-nav__link @ActiveClass("Trainee", "Dashboard", "index")"
                               aria-current="@ActiveAria("Trainee", "Dashboard", "index")">
                                <i class="fa-solid fa-gauge-high" aria-hidden="true"></i>
                                <span>@L["Nav_Dashboard"]</span>
                            </a>
                        </li>

                        <li>
                            <a asp-area="Trainee" asp-controller="Modules" asp-action="Index"
                               class="landing-nav__link @ActiveClass("Trainee", "Modules", "index")"
                               aria-current="@ActiveAria("Trainee", "Modules", "index")">
                                <i class="fa-solid fa-book-open" aria-hidden="true"></i>
                                <span>@L["Nav_Modules"]</span>
                            </a>
                        </li>

                        <li>
                            <a asp-area="Trainee" asp-controller="Booking" asp-action="Browse"
                               class="landing-nav__link @ActiveClass("Trainee", "Booking", "browse")"
                               aria-current="@ActiveAria("Trainee", "Booking", "browse")">
                                <i class="fa-solid fa-user-group" aria-hidden="true"></i>
                                <span>@L["Nav_FindMentor"]</span>
                            </a>
                        </li>

                        <li>
                            <a asp-area="Trainee" asp-controller="Booking" asp-action="Index"
                               class="landing-nav__link @ActiveClass("Trainee", "Booking", "index")"
                               aria-current="@ActiveAria("Trainee", "Booking", "index")">
                                <i class="fa-solid fa-calendar-check" aria-hidden="true"></i>
                                <span>@L["Nav_MyBookings"]</span>
                            </a>
                        </li>

                        <li>
                            <a asp-area="Trainee" asp-controller="Exam" asp-action="Index"
                               class="landing-nav__link @ActiveClass("Trainee", "Exam", "index")"
                               aria-current="@ActiveAria("Trainee", "Exam", "index")">
                                <i class="fa-solid fa-clipboard-check" aria-hidden="true"></i>
                                <span>@L["Nav_Exams"]</span>
                            </a>
                        </li>

                        <li>
                            <a asp-area="Trainee" asp-controller="Calendar" asp-action="Index"
                               class="landing-nav__link @ActiveClass("Trainee", "Calendar", "index")"
                               aria-current="@ActiveAria("Trainee", "Calendar", "index")">
                                <i class="fa-regular fa-calendar" aria-hidden="true"></i>
                                <span>@L["Nav_Calendar"]</span>
                            </a>
                        </li>
                    }

                    else if (User.IsInRole("mentor"))
                    {
                        <li>
                            <a asp-area="Mentor" asp-controller="Dashboard" asp-action="Index"
                               class="landing-nav__link @ActiveClass("Mentor", "Dashboard", "index")"
                               aria-current="@ActiveAria("Mentor", "Dashboard", "index")">
                                <i class="fa-solid fa-user-tie" aria-hidden="true"></i>
                                <span>@L["Mentor_Dashboard"]</span>
                            </a>
                        </li>
                    }

                    @if (User.IsInRole("admin"))
                    {
                        <li>
                            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                               class="landing-nav__link @ActiveClass("Admin", "Dashboard", "index")"
                               aria-current="@ActiveAria("Admin", "Dashboard", "index")">
                                <i class="fa-solid fa-gauge-high" aria-hidden="true"></i>
                                <span>@L["Admin_Nav_Dashboard"]</span>
                            </a>
                        </li>
                    }
                </ul>
            </nav>

            <div class="landing-nav__actions">

                @* ── Notifications dropdown ── *@
                @if (User.IsInRole("mentor") || User.IsInRole("trainee"))
                {
                    <div class="nav-notification dropdown">
                        <a class="landing-nav__link position-relative" data-bs-toggle="dropdown" aria-label="@L["Nav_Notifications"]">
                            <i class="fa-solid fa-bell" aria-hidden="true"></i>

                            @if (unreadCount > 0)
                            {
                                <span class="nav-notification__badge" aria-label="@unreadCount @L["Nav_UnreadNotifications"]">
                                    @unreadCount
                                </span>
                            }
                        </a>

                        <ul class="dropdown-menu dropdown-menu-end shadow"
                            style="width: 360px; max-height: 400px; overflow-y: auto;">

                            <li class="dropdown-header fw-bold">
                                @L["Nav_Notifications"]
                            </li>

                            @if (notifications.Any())
                            {
                                foreach (var n in notifications)
                                {
                                    <li>
                                        <div class="dropdown-item notification-item @(n.IsRead ? "is-read" : "is-unread") d-flex justify-content-between align-items-start">

                                            <div>
                                                <div class="fw-bold">@n.Title</div>
                                                <small>@n.Message</small><br />
                                                <small class="text-muted">@n.CreatedAt?.ToString("g")</small>
                                            </div>

                                            @if (!n.IsRead)
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-light border ms-2"
                                                        title="@L["Nav_MarkAsRead"]"
                                                        data-notification-id="@n.NotificationId"
                                                        aria-label="@L["Nav_MarkAsReadAria"]">
                                                    ✓
                                                </button>
                                            }
                                        </div>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                }
                            }
                            else
                            {
                                <li class="dropdown-item text-center text-muted">
                                    @L["Nav_NoNotifications"]
                                </li>
                            }

                        </ul>
                    </div>
                }

                @* ── Language switch ── *@
                <div class="lang-switch" role="group" aria-label="Language">
                    <form asp-area="" asp-controller="Profile" asp-action="ChangeLanguage" method="post" class="lang-switch__form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="language" value="en" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button type="submit"
                                class="lang-switch__btn @(currentLang == "en" ? "is-active" : null)"
                                aria-pressed="@(currentLang == "en" ? "true" : "false")">
                            EN
                        </button>
                    </form>

                    <form asp-area="" asp-controller="Profile" asp-action="ChangeLanguage" method="post" class="lang-switch__form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="language" value="ar" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button type="submit"
                                class="lang-switch__btn @(currentLang == "ar" ? "is-active" : null)"
                                aria-pressed="@(currentLang == "ar" ? "true" : "false")">
                            AR
                        </button>
                    </form>
                </div>

                @* ── Profile ── *@
                <a asp-area=""
                   asp-controller="Profile"
                   asp-action="Index"
                   class="landing-nav__cta landing-nav__cta--ghost @ActiveControllerClass("", "Profile")"
                   aria-current="@ActiveControllerAria("", "Profile")">
                    <i class="fa-solid fa-user" aria-hidden="true"></i>
                    <span>@L["Nav_Profile"]</span>
                </a>

                @* ── Logout ── *@
                <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post" class="landing-nav__form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="landing-nav__cta landing-nav__cta--ghost">
                        <i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i>
                        <span>@L["Nav_Logout"]</span>
                    </button>
                </form>

            </div>
        }

        else if (ViewData["HideAuthNav"] as bool? != true)
        {
            <div class="landing-nav__actions">
                <a asp-controller="Auth" asp-action="Login" class="landing-nav__link">
                    @L["Nav_Login"]
                </a>
                <a asp-controller="Registration" asp-action="SelectRole" class="landing-nav__cta">
                    @L["Nav_Register"]
                </a>
            </div>
        }

    </div>
</header>

@* ── Notification mark-as-read handler (unchanged) ── *@
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const markButtons = document.querySelectorAll('[data-notification-id]');
        markButtons.forEach(btn => {
            btn.addEventListener('click', function() {
                const id = this.dataset.notificationId;
                fetch('/Notification/MarkAsRead', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded'
                    },
                    body: 'id=' + id
                })
                .then(res => {
                    if (res.ok) {
                        location.reload();
                    } else {
                        console.error("Failed to mark notification as read");
                    }
                })
                .catch(err => console.error(err));
            });
        });
    });
</script>