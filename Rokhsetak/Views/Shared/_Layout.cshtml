@using System.Globalization

@using System.Globalization
@{
    var culture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var dir = culture == "ar" ? "rtl" : "ltr";
}

<!DOCTYPE html>
<html lang="@culture" dir="@dir">

<head>
    <meta charset="utf-8" />
    <meta encoding="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | Rokhsetak</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/auth-shared.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<body>
    <partial name="_NavBar" />

    @* ── TempData global alerts ── *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="auth-success-banner is-visible"
             role="status" aria-live="polite"
             style="position:fixed;top:16px;left:50%;transform:translateX(-50%);z-index:9999;min-width:320px;max-width:90vw;">
            <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="auth-error-banner is-visible"
             role="alert" aria-live="assertive"
             style="position:fixed;top:16px;left:50%;transform:translateX(-50%);z-index:9999;min-width:320px;max-width:90vw;">
            <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    @RenderBody()

    <script src="~/js/auth-shared.js" asp-append-version="true"></script>
    <script src="~/js/shared.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
