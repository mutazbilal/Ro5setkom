@using Rokhsetak.ViewModels.Registration
@using Rokhsetak.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResourceMarker> L
@model MentorRegistrationViewModel
@{
    ViewData["Title"] = L["Reg_MentorRegistration_Title"];
}

@section Styles {
    <link rel="stylesheet" href="~/css/register.css" asp-append-version="true" />
}

<div class="auth-mobile-header">
    <span class="auth-mobile-header__logo"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i></span>
    <span>Rokhsetak</span>
</div>

<main class="auth-page" aria-label="@L["Reg_Mentor_AriaLabel"]">
    <section class="auth-brand" aria-hidden="true">
        <div class="auth-brand__logo"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i></div>
        <h1 class="auth-brand__title">@L["Reg_MentorRegistration_Title"]</h1>
        <p class="auth-brand__tagline">@L["Reg_Mentor_Tagline"]</p>

        <span class="auth-floating-shape auth-floating-shape--circle"></span>
        <span class="auth-floating-shape auth-floating-shape--hex"></span>
        <span class="auth-floating-shape auth-floating-shape--diamond"></span>

        <svg class="auth-brand__art" viewBox="0 0 800 240" xmlns="http://www.w3.org/2000/svg"
             role="img" aria-label="@L["Reg_RoadIllustration"]">
            <path d="M0 90 C150 22, 275 168, 430 116 C578 67, 696 48, 800 90 L800 240 L0 240 Z"
                  fill="rgba(22,53,96,.95)"/>
            <path d="M100 172 C240 120, 380 158, 540 130 C625 116, 700 112, 760 122"
                  stroke="#f5d486" stroke-width="6" stroke-dasharray="18 14" fill="none" stroke-linecap="round"/>
            <path d="M0 130 C180 220, 250 115, 430 166 C580 202, 670 136, 800 175 L800 240 L0 240 Z"
                  fill="rgba(255,255,255,.07)"/>
        </svg>
        <svg class="auth-brand__art" viewBox="0 0 1200 120" preserveAspectRatio="none"
             xmlns="http://www.w3.org/2000/svg">
            <path d="M0,64L40,80C80,96,160,128,240,117.3C320,107,400,53,480,37.3C560,21,640,43,720,64C800,85,880,107,960,96C1040,85,1120,43,1160,21.3L1200,0L1200,120L1160,120C1120,120,1040,120,960,120C880,120,800,120,720,120C640,120,560,120,480,120C400,120,320,120,240,120C160,120,80,120,40,120L0,120Z"
                  fill="#f5f7fa"/>
        </svg>
    </section>

    <section class="auth-form-wrap">
        <article class="auth-card register-card" aria-live="polite">
            <h2 class="auth-card__title">@L["Reg_MentorRegistration_Title"]</h2>
            <p class="auth-card__subtitle">@L["Reg_Step3"]</p>

            <div class="auth-stepper" aria-label="@L["Reg_Step3Aria"]">
                <div class="auth-step is-complete"></div>
                <div class="auth-step is-complete"></div>
                <div class="auth-step is-active" aria-current="step"></div>
            </div>

            <div class="auth-info-banner is-visible" role="note" style="margin-bottom:14px;">
                <i class="fa-solid fa-hourglass-half" aria-hidden="true"></i>
                <span>@L["Reg_Mentor_ReviewNotice"]</span>
            </div>

            <div asp-validation-summary="All"
                 class="auth-error-banner"
                 role="alert"
                 aria-live="assertive"></div>

            @* enctype="multipart/form-data" is MANDATORY — without it CertificationFile is always null *@
            <form asp-controller="Registration" asp-action="CompleteMentor" method="post"
                  enctype="multipart/form-data"
                  class="auth-form" novalidate>
                @* ── Section A: Locked government fields ── *@
                <div class="auth-info-banner is-visible" role="note" style="margin-bottom:12px;">
                    <i class="fa-solid fa-lock" aria-hidden="true"></i>
                    <span>@L["Reg_LockedGovFields"]</span>
                </div>

                <div class="auth-field register-locked">
                    <input asp-for="NationalId" class="auth-input" type="text" placeholder=" " readonly />
                    <label asp-for="NationalId" class="auth-label">@L["Reg_NationalId"]</label>
                    <span class="register-lock" aria-hidden="true"><i class="fa-solid fa-lock"></i></span>
                </div>
                <input asp-for="NationalId" type="hidden" />

                <div class="auth-field register-locked">
                    <input asp-for="FirstName" class="auth-input" type="text" placeholder=" " readonly />
                    <label asp-for="FirstName" class="auth-label">@L["Reg_FirstName"]</label>
                    <span class="register-lock" aria-hidden="true"><i class="fa-solid fa-lock"></i></span>
                </div>
                <input asp-for="FirstName" type="hidden" />

                <div class="auth-field register-locked">
                    <input asp-for="LastName" class="auth-input" type="text" placeholder=" " readonly />
                    <label asp-for="LastName" class="auth-label">@L["Reg_LastName"]</label>
                    <span class="register-lock" aria-hidden="true"><i class="fa-solid fa-lock"></i></span>
                </div>
                <input asp-for="LastName" type="hidden" />

                <div class="auth-field register-locked">
                    <input asp-for="DateOfBirth" class="auth-input" type="text" placeholder=" " readonly />
                    <label asp-for="DateOfBirth" class="auth-label">@L["Reg_DateOfBirth"]</label>
                    <span class="register-lock" aria-hidden="true"><i class="fa-solid fa-lock"></i></span>
                </div>
                <input asp-for="DateOfBirth" type="hidden" />

                <div class="auth-field register-locked">
                    <input asp-for="Gender" class="auth-input" type="text" placeholder=" " readonly />
                    <label asp-for="Gender" class="auth-label">@L["Reg_Gender"]</label>
                    <span class="register-lock" aria-hidden="true"><i class="fa-solid fa-lock"></i></span>
                </div>
                <input asp-for="Gender" type="hidden" />
                @* ── Section B: Editable fields ── *@

                <div class="auth-field">
                    <label asp-for="ProvinceId"
                           style="position:static;font-size:.92rem;font-weight:600;color:var(--color-text);margin-bottom:4px;display:block;">
                        @L["Reg_Province"]
                    </label>

                    <select asp-for="ProvinceId"
                            asp-items="@(new SelectList(Model.Provinces, "ProvinceId", "DisplayName"))"
                            class="auth-input auth-select"
                            id="provinceSelect"
                            aria-required="true">

                        <option value="">@L["Reg_SelectProvince"]</option>
                    </select>

                    <span asp-validation-for="ProvinceId" class="text-danger"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="CityId"
                           style="position:static;font-size:.92rem;font-weight:600;color:var(--color-text);margin-bottom:4px;display:block;">
                        @L["Reg_City"]
                    </label>

                    <select asp-for="CityId"
                            class="auth-input auth-select"
                            id="citySelect"
                            aria-required="true">

                        <option value="">@L["Reg_SelectCity"]</option>

                        @foreach (var city in Model.Cities)
                        {
                            <option value="@city.CityId"
                                    data-province-id="@city.ProvinceId">
                                @city.DisplayName
                            </option>
                        }
                    </select>

                    <span asp-validation-for="CityId" class="text-danger"></span>
                </div>

                <div class="auth-field">
                    <input asp-for="AddressLine1" class="auth-input" type="text" placeholder=" " />
                    <label asp-for="AddressLine1" class="auth-label">@L["Reg_AddressLine1"]</label>
                    <span asp-validation-for="AddressLine1" class="text-danger"></span>
                </div>

                @if (Model.AddressLine2 != null)
                {
                    <div class="auth-field">
                        <input asp-for="AddressLine2" class="auth-input" type="text" placeholder=" " />
                        <label asp-for="AddressLine2" class="auth-label">@L["Reg_AddressLine2"]</label>
                        <span asp-validation-for="AddressLine2" class="text-danger"></span>
                    </div>
                }

                @if (Model.PostalCode != null)
                {
                    <div class="auth-field">
                        <input asp-for="PostalCode" class="auth-input" type="text" placeholder=" " />
                        <label asp-for="PostalCode" class="auth-label">@L["Reg_PostalCode"]</label>
                        <span asp-validation-for="PostalCode" class="text-danger"></span>
                    </div>
                }
                
                <div class="auth-field">
                    <input asp-for="Email" class="auth-input" type="email" placeholder=" "
                           autocomplete="email" aria-required="true" />
                    <label asp-for="Email" class="auth-label">@L["Reg_Email"]</label>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="auth-field">
                    <input asp-for="PhoneNumber" class="auth-input" type="tel" placeholder=" "
                           autocomplete="tel" aria-required="true" />
                    <label asp-for="PhoneNumber" class="auth-label">@L["Reg_PhoneNumber"]</label>
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>

                <div class="auth-field">
                    <input asp-for="Password" class="auth-input" type="password" placeholder=" "
                           autocomplete="new-password" aria-required="true" />
                    <label asp-for="Password" class="auth-label">@L["Reg_Password"]</label>
                    <button type="button" class="auth-password-toggle"
                            data-password-toggle data-target="Password" aria-label="@L["Auth_ShowPassword"]">
                        <i class="fa-solid fa-eye" aria-hidden="true"></i>
                    </button>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="auth-field">
                    <input asp-for="ConfirmPassword" class="auth-input" type="password" placeholder=" "
                           autocomplete="new-password" aria-required="true" />
                    <label asp-for="ConfirmPassword" class="auth-label">@L["Reg_ConfirmPassword"]</label>
                    <button type="button" class="auth-password-toggle"
                            data-password-toggle data-target="ConfirmPassword" aria-label="@L["Auth_ShowConfirmPassword"]">
                        <i class="fa-solid fa-eye" aria-hidden="true"></i>
                    </button>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="LicenseTypeId"
                           style="position:static;font-size:.92rem;font-weight:600;color:var(--color-text);margin-bottom:4px;display:block;">
                        @L["Reg_LicenseTypeYouTeach"]
                    </label>
                    <select asp-for="LicenseTypeId"
                            asp-items="@(new SelectList(Model.AvailableLicenseTypes, "Id", "Name"))"
                            class="auth-input auth-select"
                            aria-required="true">
                        <option value="">@L["Reg_SelectLicenseType"]</option>
                    </select>
                    <span asp-validation-for="LicenseTypeId" class="text-danger"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="TrainingCenterId"
                           style="position:static;font-size:.92rem;font-weight:600;color:var(--color-text);margin-bottom:4px;display:block;">
                        @L["Reg_TrainingCenter"]
                    </label>
                    <select asp-for="TrainingCenterId"
                            asp-items="@(new SelectList(Model.AvailableTrainingCenters, "Id", "Name"))"
                            class="auth-input auth-select"
                            aria-required="true">
                        <option value="">@L["Reg_SelectTrainingCenter"]</option>
                    </select>
                    <span asp-validation-for="TrainingCenterId" class="text-danger"></span>
                </div>

                <div class="auth-field">
                    <input asp-for="VehicleType" class="auth-input" type="text" placeholder=" " />
                    <label asp-for="VehicleType" class="auth-label">@L["Reg_VehicleType_Optional"]</label>
                    <span asp-validation-for="VehicleType" class="text-danger"></span>
                </div>

                <div class="auth-field">
                    <input asp-for="PricePerSession" class="auth-input" type="number"
                           placeholder=" " min="0" step="0.01" />
                    <label asp-for="PricePerSession" class="auth-label">@L["Reg_PricePerSession_Optional"]</label>
                    <span asp-validation-for="PricePerSession" class="text-danger"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="CertificationFile"
                           style="position:static;font-size:.92rem;font-weight:600;color:var(--color-text);margin-bottom:4px;display:block;">
                        @L["Reg_CertificationDocument"] <span style="color:var(--color-error);" aria-hidden="true">*</span>
                    </label>
                    <div class="register-dropzone" id="certDropzone"
                         aria-describedby="certZoneDesc">
                        <input asp-for="CertificationFile"
                               type="file"
                               accept=".pdf,.jpg,.jpeg,.png"
                               aria-required="true"
                               aria-describedby="certZoneDesc"
                               id="certFileInput" />
                        <div>
                            <div class="register-dropzone__icon">
                                <i class="fa-solid fa-file-circle-check" aria-hidden="true"></i>
                            </div>
                            <p><strong>@L["Reg_CertificationDocument"]</strong></p>
                            <p id="certZoneDesc">@L["Reg_UploadCert"]</p>
                            <p style="font-size:.82rem;color:var(--color-muted);">@L["Reg_MaxFileSize"]</p>
                            <div data-file-error class="auth-error-banner" style="margin-top:8px;display:none;"></div>
                            <div class="register-dropzone__meta">
                                <span><span data-file-name></span> • <span data-file-size></span></span>
                                <button class="register-dropzone__remove" type="button"
                                        aria-label="@L["Reg_RemoveFile"]">&times;</button>
                            </div>
                        </div>
                    </div>
                    <span asp-validation-for="CertificationFile" class="text-danger"></span>
                </div>

                @* ── Section C: Consent ── *@
                <label class="auth-custom-check" for="AcceptedTerms" style="margin-top:6px;">
                    <input asp-for="AcceptedTerms" type="checkbox" aria-required="true" />
                    <span class="auth-custom-check__box" aria-hidden="true"></span>
                    <span>
                        @Html.Raw(L["Reg_AcceptTermsFull"])
                    </span>
                </label>
                <span asp-validation-for="AcceptedTerms" class="text-danger"></span>

                <button class="auth-btn" type="submit" style="margin-top:8px;">
                    @L["Reg_SubmitApplication"]
                </button>
            </form>
        </article>
    </section>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/register.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {

        AuthShared.wireDependentCityDropdown(
        '#provinceSelect',
        '#citySelect'
        );

        });
    </script>
}