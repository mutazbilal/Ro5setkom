@{
    ViewData["Title"] = "Welcome";
}

@section Styles {
    <link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
}

<div class="landing-body">

<main class="landing-page" aria-label="Landing page">

    @* ─────────────────  HERO  ───────────────── *@
    <section class="landing-hero">
        <div class="landing-hero__content">
            <p class="landing-badge">Official Training &amp; Licensing Journey</p>
            <h1>Your Road to a Driving License Starts Here</h1>
            <p class="landing-subtitle">
                A modern, secure gateway for trainees and mentors with guided onboarding,
                identity verification, and exam-ready learning.
            </p>

            <div class="landing-cta-row">
                <a asp-controller="Auth" asp-action="Login" class="auth-btn landing-cta">
                    Login to Continue
                </a>
                <a asp-controller="Registration" asp-action="SelectRole"
                   class="auth-btn-ghost landing-cta-ghost">
                    New User? Register
                </a>
            </div>

            @* ─── Blue glass card moved here, under the left content ─── *@
            <div class="landing-glass-card landing-glass-card--inline">
                <h3><i class="fa-solid fa-road" aria-hidden="true"></i> Roadmap to License</h3>
                <ul>
                    <li><span>1</span> Verify your identity securely</li>
                    <li><span>2</span> Complete profile and legal consents</li>
                    <li><span>3</span> Choose training track and schedule</li>
                    <li><span>4</span> Track progress to final exam</li>
                </ul>
            </div>
        </div>

        @* ─── Right panel now holds the uploaded illustration ─── *@
        <div class="landing-hero__panel" aria-hidden="true">
            <div class="landing-floating landing-floating--circle"></div>
            <div class="landing-floating landing-floating--hex"></div>
            <div class="landing-floating landing-floating--diamond"></div>

            <figure class="landing-hero__image-frame">
                <img src="images/driving-lesson.png"
                     alt="Driving mentor instructing a trainee next to a yellow training vehicle"
                     class="landing-hero__image"
                     loading="eager" />
                <figcaption class="landing-hero__image-caption">
                    <i class="fa-solid fa-car-side" aria-hidden="true"></i>
                    Real instructors. Real practice. Real progress.
                </figcaption>
            </figure>
        </div>
    </section>

    @* ─────────────────  ORANGE HIGHLIGHTS CARD  ───────────────── *@
    <section class="landing-highlights" aria-label="Why choose ro5setkom">
        <div class="landing-highlights__card reveal-on-scroll">
            <header class="landing-highlights__header">
                <p class="landing-highlights__eyebrow">Why ro5setkom</p>
                <h2 class="landing-highlights__title">Built for trust, designed for the road</h2>
                <p class="landing-highlights__lead">
                    Three pillars that make our platform the safest and smartest way
                    to earn your license.
                </p>
            </header>

            <div class="landing-highlights__grid">
                <article class="landing-highlight">
                    <span class="landing-highlight__icon" aria-hidden="true">
                        <i class="fa-solid fa-id-card"></i>
                    </span>
                    <h3>Government Verification</h3>
                    <p>
                        Every National ID is checked in real time against the official
                        civil registry. Your name, date of birth, and address are pulled
                        directly from government records — so there is no paperwork to
                        forge and no identity to fake.
                    </p>
                </article>

                <article class="landing-highlight">
                    <span class="landing-highlight__icon" aria-hidden="true">
                        <i class="fa-solid fa-user-check"></i>
                    </span>
                    <h3>Certified Mentors</h3>
                    <p>
                        Mentors only appear in our marketplace after their teaching
                        license and certification documents are reviewed and approved
                        by an administrator. You will never be matched with an
                        unqualified instructor — every profile is vetted before it goes live.
                    </p>
                </article>

                <article class="landing-highlight">
                    <span class="landing-highlight__icon" aria-hidden="true">
                        <i class="fa-solid fa-calendar-check"></i>
                    </span>
                    <h3>Smart Scheduling</h3>
                    <p>
                        Browse mentor availability by day and time, book sessions in a
                        single tap, and receive automatic reminders before each lesson.
                        Need to reschedule? Cancel up to 12 hours in advance with no
                        penalty — the calendar adapts to your life.
                    </p>
                </article>
            </div>
        </div>
    </section>

    @* ─────────────────  EXISTING FEATURES  ───────────────── *@
    <section class="landing-features" id="features" aria-label="Platform features">
        <article class="landing-feature-card reveal-on-scroll">
            <i class="fa-solid fa-book-open" aria-hidden="true"></i>
            <h3>Learning Modules</h3>
            <p>Theory and practical preparation content, tailored by license type.</p>
        </article>
        <article class="landing-feature-card reveal-on-scroll">
            <i class="fa-solid fa-chalkboard-user" aria-hidden="true"></i>
            <h3>Mentor Matching</h3>
            <p>Find, compare, and book verified mentors that fit your schedule.</p>
        </article>
        <article class="landing-feature-card reveal-on-scroll">
            <i class="fa-solid fa-shield" aria-hidden="true"></i>
            <h3>Secure Access</h3>
            <p>Protected workflows with identity checks and trusted account controls.</p>
        </article>
    </section>

    @* ─────────────────  CONTACT  ───────────────── *@
    <section class="landing-contact" id="contact" aria-label="Contact information">
        <header class="landing-contact__header">
            <p class="landing-contact__eyebrow">Contact</p>
            <h2 class="landing-contact__title">We're here to help</h2>
            <p class="landing-contact__lead">
                Questions about registration, mentor approval, or your training plan?
                Reach out — our support team responds within one business day.
            </p>
        </header>

        <div class="landing-contact__grid">
            <article class="landing-contact-card reveal-on-scroll">
                <span class="landing-contact-card__icon" aria-hidden="true">
                    <i class="fa-solid fa-envelope"></i>
                </span>
                <h3>Email</h3>
                <p class="landing-contact-card__lead">
                    For account, registration, and general inquiries.
                </p>
                <ul class="landing-contact-card__list">
                    <li>
                        <a href="mailto:support@ro5setkom.jo" class="landing-contact-card__link">
                            support@ro5setkom.jo
                        </a>
                    </li>
                    <li>
                        <a href="mailto:mentors@ro5setkom.jo" class="landing-contact-card__link">
                            mentors@ro5setkom.jo
                        </a>
                    </li>
                    <li>
                        <a href="mailto:info@ro5setkom.jo" class="landing-contact-card__link">
                            info@ro5setkom.jo
                        </a>
                    </li>
                </ul>
            </article>

            <article class="landing-contact-card reveal-on-scroll">
                <span class="landing-contact-card__icon" aria-hidden="true">
                    <i class="fa-solid fa-phone"></i>
                </span>
                <h3>Phone</h3>
                <p class="landing-contact-card__lead">
                    Speak directly with our support team.
                </p>
                <ul class="landing-contact-card__list">
                    <li>
                        <a href="tel:+96265551234" class="landing-contact-card__link">
                            +962 6 555 1234
                        </a>
                        <span class="landing-contact-card__meta">Office</span>
                    </li>
                    <li>
                        <a href="tel:+962791234567" class="landing-contact-card__link">
                            +962 79 123 4567
                        </a>
                        <span class="landing-contact-card__meta">Mobile / WhatsApp</span>
                    </li>
                </ul>
            </article>

            <article class="landing-contact-card reveal-on-scroll">
                <span class="landing-contact-card__icon" aria-hidden="true">
                    <i class="fa-solid fa-location-dot"></i>
                </span>
                <h3>Visit Us</h3>
                <p class="landing-contact-card__lead">
                    Drop by our headquarters during office hours.
                </p>
                <address class="landing-contact-card__address">
                    Abdali Boulevard, 4th Floor<br />
                    Amman, Jordan
                </address>
                <p class="landing-contact-card__hours">
                    <i class="fa-regular fa-clock" aria-hidden="true"></i>
                    Sunday – Thursday &middot; 9:00 AM – 6:00 PM
                </p>
            </article>
        </div>

        <p class="landing-contact__note">
            For urgent issues outside business hours, please email
            <a href="mailto:support@ro5setkom.jo" class="auth-link">support@ro5setkom.jo</a>
            and we will get back to you on the next business day.
        </p>
    </section>

</main>

</div>

@section Scripts {
    <script src="~/js/index.js" asp-append-version="true"></script>
}
