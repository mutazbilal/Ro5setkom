@using Microsoft.Extensions.Localization
@using Rokhsetak.Resources
@inject IStringLocalizer<Rokhsetak.Resources.SharedResourceMarker> L
@{
    ViewData["Title"] = L["Home_Welcome"];
    var isAuth = User.Identity != null && User.Identity.IsAuthenticated;
}

@section Styles {
    <link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
}

<div class="landing-body">

<main class="landing-page" aria-label="@L["Home_LandingPageAria"]">

    @* ─────────────────  HERO  ───────────────── *@
    <section class="landing-hero">
        <div class="landing-hero__content">
            <p class="landing-badge">@L["Home_HeroBadge"]</p>
            <h1>@L["Home_HeroTitle"]</h1>
            <p class="landing-subtitle">
                @L["Home_HeroSubtitle"]
            </p>

            @if (!isAuth)
            {
                <div class="landing-cta-row">
                    <a asp-controller="Auth" asp-action="Login" class="auth-btn landing-cta">
                        @L["Home_LoginButton"]
                    </a>
                    <a asp-controller="Registration" asp-action="SelectRole"
                       class="auth-btn-ghost landing-cta-ghost">
                        @L["Home_RegisterButton"]
                    </a>
                </div>
            }

            @* ─── Blue glass card moved here, under the left content ─── *@
            <div class="landing-glass-card landing-glass-card--inline">
                <h3><i class="fa-solid fa-road" aria-hidden="true"></i> @L["Home_RoadmapTitle"]</h3>
                <ul>
                    <li><span>1</span> @L["Home_RoadmapStep1"]</li>
                    <li><span>2</span> @L["Home_RoadmapStep2"]</li>
                    <li><span>3</span> @L["Home_RoadmapStep3"]</li>
                    <li><span>4</span> @L["Home_RoadmapStep4"]</li>
                </ul>
            </div>
        </div>

        @* ─── Right panel now holds the uploaded illustration ─── *@
        <div class="landing-hero__panel" aria-hidden="true">
            <div class="landing-floating landing-floating--circle"></div>
            <div class="landing-floating landing-floating--hex"></div>
            <div class="landing-floating landing-floating--diamond"></div>

            <figure class="landing-hero__image-frame">
                <img src="images/driving-lesson.png"
                     alt="@L["Home_HeroImageAlt"]"
                     class="landing-hero__image"
                     loading="eager" />
                <figcaption class="landing-hero__image-caption">
                    <i class="fa-solid fa-car-side" aria-hidden="true"></i>
                    @L["Home_ImageCaption"]
                </figcaption>
            </figure>
        </div>
    </section>

    @* ─────────────────  ORANGE HIGHLIGHTS CARD  ───────────────── *@
    <section class="landing-highlights" aria-label="@L["Home_HighlightsAria"]">
        <div class="landing-highlights__card reveal-on-scroll">
            <header class="landing-highlights__header">
                <p class="landing-highlights__eyebrow">@L["Home_WhyUsEyebrow"]</p>
                <h2 class="landing-highlights__title">@L["Home_WhyUsTitle"]</h2>
                <p class="landing-highlights__lead">
                    @L["Home_WhyUsLead"]
                </p>
            </header>

            <div class="landing-highlights__grid">
                <article class="landing-highlight">
                    <span class="landing-highlight__icon" aria-hidden="true">
                        <i class="fa-solid fa-id-card"></i>
                    </span>
                    <h3>@L["Home_FeatureGovTitle"]</h3>
                    <p>
                        @L["Home_FeatureGovDesc"]
                    </p>
                </article>

                <article class="landing-highlight">
                    <span class="landing-highlight__icon" aria-hidden="true">
                        <i class="fa-solid fa-user-check"></i>
                    </span>
                    <h3>@L["Home_FeatureMentorsTitle"]</h3>
                    <p>
                        @L["Home_FeatureMentorsDesc"]
                    </p>
                </article>

                <article class="landing-highlight">
                    <span class="landing-highlight__icon" aria-hidden="true">
                        <i class="fa-solid fa-calendar-check"></i>
                    </span>
                    <h3>@L["Home_FeatureScheduleTitle"]</h3>
                    <p>
                        @L["Home_FeatureScheduleDesc"]
                    </p>
                </article>
            </div>
        </div>
    </section>

    @* ─────────────────  EXISTING FEATURES  ───────────────── *@
    <section class="landing-features" id="features" aria-label="@L["Home_FeaturesAria"]">
        <article class="landing-feature-card reveal-on-scroll">
            <i class="fa-solid fa-book-open" aria-hidden="true"></i>
            <h3>@L["Home_FeatureModulesTitle"]</h3>
            <p>@L["Home_FeatureModulesDesc"]</p>
        </article>
        <article class="landing-feature-card reveal-on-scroll">
            <i class="fa-solid fa-chalkboard-user" aria-hidden="true"></i>
            <h3>@L["Home_FeatureMatchingTitle"]</h3>
            <p>@L["Home_FeatureMatchingDesc"]</p>
        </article>
        <article class="landing-feature-card reveal-on-scroll">
            <i class="fa-solid fa-shield" aria-hidden="true"></i>
            <h3>@L["Home_FeatureSecureTitle"]</h3>
            <p>@L["Home_FeatureSecureDesc"]</p>
        </article>
    </section>

    @* ─────────────────  CONTACT  ───────────────── *@
    <section class="landing-contact" id="contact" aria-label="@L["Home_ContactAria"]">
        <header class="landing-contact__header">
            <p class="landing-contact__eyebrow">@L["Home_ContactEyebrow"]</p>
            <h2 class="landing-contact__title">@L["Home_ContactTitle"]</h2>
            <p class="landing-contact__lead">
                @L["Home_ContactLead"]
            </p>
        </header>

        <div class="landing-contact__grid">
            <article class="landing-contact-card reveal-on-scroll">
                <span class="landing-contact-card__icon" aria-hidden="true">
                    <i class="fa-solid fa-envelope"></i>
                </span>
                <h3>@L["Home_ContactEmailTitle"]</h3>
                <p class="landing-contact-card__lead">
                    @L["Home_ContactEmailLead"]
                </p>
                <ul class="landing-contact-card__list">
                    <li>
                        <a href="mailto:support@ro5setkom.jo" class="landing-contact-card__link">
                            support@ro5setkom.jo
                        </a>
                    </li>
                    <li>
                        <a href="mailto:mentors@ro5setkom.jo" class="landing-contact-card__link">
                            mentors@ro5setkom.jo
                        </a>
                    </li>
                    <li>
                        <a href="mailto:info@ro5setkom.jo" class="landing-contact-card__link">
                            info@ro5setkom.jo
                        </a>
                    </li>
                </ul>
            </article>

            <article class="landing-contact-card reveal-on-scroll">
                <span class="landing-contact-card__icon" aria-hidden="true">
                    <i class="fa-solid fa-phone"></i>
                </span>
                <h3>@L["Home_ContactPhoneTitle"]</h3>
                <p class="landing-contact-card__lead">
                    @L["Home_ContactPhoneLead"]
                </p>
                <ul class="landing-contact-card__list">
                    <li>
                        <a href="tel:+96265551234" class="landing-contact-card__link">
                            +962 6 555 1234
                        </a>
                        <span class="landing-contact-card__meta">@L["Home_ContactOffice"]</span>
                    </li>
                    <li>
                        <a href="tel:+962791234567" class="landing-contact-card__link">
                            +962 79 123 4567
                        </a>
                        <span class="landing-contact-card__meta">@L["Home_ContactMobile"]</span>
                    </li>
                </ul>
            </article>

            <article class="landing-contact-card reveal-on-scroll">
                <span class="landing-contact-card__icon" aria-hidden="true">
                    <i class="fa-solid fa-location-dot"></i>
                </span>
                <h3>@L["Home_ContactVisitTitle"]</h3>
                <p class="landing-contact-card__lead">
                    @L["Home_ContactVisitLead"]
                </p>
                <address class="landing-contact-card__address">
                    @L["Home_AddressLine1"]<br />
                    @L["Home_AddressLine2"]
                </address>
                <p class="landing-contact-card__hours">
                    <i class="fa-regular fa-clock" aria-hidden="true"></i>
                    @L["Home_OfficeHours"]
                </p>
            </article>
        </div>

        <p class="landing-contact__note">
            @L["Home_ContactNotePrefix"]
            <a href="mailto:support@ro5setkom.jo" class="auth-link">support@ro5setkom.jo</a>
            @L["Home_ContactNoteSuffix"]
        </p>
    </section>

</main>

</div>

@section Scripts {
    <script src="~/js/index.js" asp-append-version="true"></script>
}