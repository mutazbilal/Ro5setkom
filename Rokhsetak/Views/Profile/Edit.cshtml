@using Rokhsetak.ViewModels.Profile
@using Rokhsetak.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResourceMarker> L
@model EditProfileViewModel
@{
    ViewData["Title"] = L["Profile_EditProfile"];
}

@section Styles {
    <link rel="stylesheet" href="~/css/profile.css" />
}

<div class="profile-page">
    <div class="profile-page__inner">
        @if (TempData["Error"] != null)
        {
            <div class="alert dashboard-alert dashboard-alert--error" role="alert">
                <i class="fa-solid fa-triangle-exclamation dashboard-alert__icon" aria-hidden="true"></i>
                <span class="dashboard-alert__message">@TempData["Error"]</span>
                <button type="button" class="dashboard-alert__close" data-bs-dismiss="alert" aria-label="@L["Alert_Close"]">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert dashboard-alert dashboard-alert--success" role="alert">
                <i class="fa-solid fa-circle-check dashboard-alert__icon" aria-hidden="true"></i>
                <span class="dashboard-alert__message">@TempData["Success"]</span>
                <button type="button" class="dashboard-alert__close" data-bs-dismiss="alert" aria-label="@L["Alert_Close"]">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
        }

        <!-- ============ Hero ============ -->
        <section class="profile-hero profile-hero--compact" aria-labelledby="edit-page-title">
            <div class="profile-hero__main">
                <span class="profile-hero__badge" aria-hidden="true">
                    <i class="fa-solid fa-pen-to-square"></i>
                </span>
                <div class="profile-hero__intro">
                    <span class="profile-hero__eyebrow">@L["Profile_Account"]</span>
                    <h1 id="edit-page-title" class="profile-hero__title">@L["Profile_EditProfile"]</h1>
                    <p class="profile-hero__description">
                        @L["Profile_EditProfile_Desc"]
                    </p>
                </div>
            </div>

            <div class="profile-hero__cta">
                <a asp-controller="Profile"
                   asp-action="Index"
                   class="btn-action btn-action--ghost">
                    <i class="fa-solid fa-arrow-left-long" aria-hidden="true"></i>
                    <span>@L["Profile_BackToProfile"]</span>
                </a>
            </div>
        </section>
        <form asp-action="Edit" method="post" class="profile-form" novalidate>
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert dashboard-alert dashboard-alert--error" role="alert"></div>

            <!-- ============ Personal (locked) ============ -->
            <section class="profile-card" aria-labelledby="edit-personal-title">
                <header class="profile-card__header profile-card__header--locked">
                    <span class="profile-card__icon" aria-hidden="true">
                        <i class="fa-solid fa-shield-halved"></i>
                    </span>
                    <div class="profile-card__headings">
                        <p class="profile-card__eyebrow">@L["Profile_Section01"]</p>
                        <h2 id="edit-personal-title" class="profile-card__title">@L["Profile_PersonalInfo"]</h2>
                    </div>
                    <span class="profile-card__lock-badge" aria-hidden="true">
                        <i class="fa-solid fa-lock"></i>
                        <span>@L["Profile_ReadOnly"]</span>
                    </span>
                </header>

                <div class="profile-card__body">
                    <div class="profile-card__notice">
                        <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                        <span>@L["Profile_SourcedFromGov"]</span>
                    </div>

                    <div class="form-grid">
                        <div class="form-field">
                            <label asp-for="FirstName" class="form-field__label">@L["Profile_FirstName"]</label>
                            <input asp-for="FirstName" class="form-input form-input--readonly" readonly />
                        </div>

                        <div class="form-field">
                            <label asp-for="LastName" class="form-field__label">@L["Profile_LastName"]</label>
                            <input asp-for="LastName" class="form-input form-input--readonly" readonly />
                        </div>

                        <div class="form-field">
                            <label asp-for="DateOfBirth" class="form-field__label">@L["Profile_DateOfBirth"]</label>
                            <input asp-for="DateOfBirth" class="form-input form-input--readonly" readonly />
                        </div>

                        <div class="form-field">
                            <label asp-for="Gender" class="form-field__label">@L["Profile_Gender"]</label>
                            <input asp-for="Gender" class="form-input form-input--readonly" readonly />
                        </div>

                        <div class="form-field form-field--full">
                            <label asp-for="NationalId" class="form-field__label">@L["Profile_NationalId"]</label>
                            <input asp-for="NationalId" class="form-input form-input--readonly" readonly />
                        </div>
                    </div>
                </div>
            </section>

            <!-- ============ Contact (editable) ============ -->
            <section class="profile-card" aria-labelledby="edit-contact-title">
                <header class="profile-card__header">
                    <span class="profile-card__icon" aria-hidden="true">
                        <i class="fa-solid fa-address-card"></i>
                    </span>
                    <div class="profile-card__headings">
                        <p class="profile-card__eyebrow">@L["Profile_Section02"]</p>
                        <h2 id="edit-contact-title" class="profile-card__title">@L["Profile_ContactInfo"]</h2>
                    </div>
                </header>

                <div class="profile-card__body">
                    <div class="form-grid">
                        <div class="form-field">
                            <label asp-for="Email" class="form-field__label">@L["Profile_Email"]</label>
                            <input asp-for="Email" class="form-input" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger form-field__error"></span>
                        </div>

                        <div class="form-field">
                            <label asp-for="PhoneNumber" class="form-field__label">@L["Profile_PhoneNumber"]</label>
                            <input asp-for="PhoneNumber" class="form-input" autocomplete="tel" />
                            <span asp-validation-for="PhoneNumber" class="text-danger form-field__error"></span>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ============ Address (editable) ============ -->
            <section class="profile-card" aria-labelledby="edit-address-title">
                <header class="profile-card__header">
                    <span class="profile-card__icon" aria-hidden="true">
                        <i class="fa-solid fa-location-dot"></i>
                    </span>
                    <div class="profile-card__headings">
                        <p class="profile-card__eyebrow">@L["Profile_Section03"]</p>
                        <h2 id="edit-address-title" class="profile-card__title">@L["Profile_Address"]</h2>
                    </div>
                </header>

                <div class="profile-card__body">
                    <div class="form-grid">
                        <div class="form-field">
                            <label asp-for="ProvinceId"
                                   style="position:static;font-size:.92rem;font-weight:600;color:var(--color-text);margin-bottom:4px;display:block;">
                                @L["Reg_Province"]
                            </label>

                            <select asp-for="ProvinceId"
                                    asp-items="@(new SelectList(Model.Provinces, "ProvinceId", "DisplayName"))"
                                    class="auth-input auth-select"
                                    id="provinceSelect"
                                    aria-required="true">

                                <option value="">@L["Profile_SelectProvince"]</option>
                            </select>

                            <span asp-validation-for="ProvinceId" class="text-danger"></span>
                        </div>

                        <div class="auth-field">
                            <label asp-for="CityId"
                                   style="position:static;font-size:.92rem;font-weight:600;color:var(--color-text);margin-bottom:4px;display:block;">
                                @L["Reg_City"]
                            </label>

                            <select asp-for="CityId"
                                    class="auth-input auth-select"
                                    id="citySelect"
                                    aria-required="true">

                                <option value="">@L["Profile_SelectCity"]</option>

                                @foreach (var city in Model.Cities)
                                {
                                    <option value="@city.CityId"
                                            data-province-id="@city.ProvinceId">
                                        @city.DisplayName
                                    </option>
                                }
                            </select>

                            <span asp-validation-for="CityId" class="text-danger"></span>
                        </div>

                        <div class="form-field form-field--full">
                            <label asp-for="AddressLine1" class="form-field__label">@L["Reg_AddressLine1"]</label>
                            <input asp-for="AddressLine1" class="form-input" autocomplete="address-line1" />
                            <span asp-validation-for="AddressLine1" class="text-danger form-field__error"></span>
                        </div>

                        <div class="form-field form-field--full">
                            <label asp-for="AddressLine2" class="form-field__label">@L["Reg_AddressLine2"]</label>
                            <input asp-for="AddressLine2" class="form-input" autocomplete="address-line2" />
                            <span asp-validation-for="AddressLine2" class="text-danger form-field__error"></span>
                        </div>

                        <div class="form-field">
                            <label asp-for="PostalCode" class="form-field__label">@L["Reg_PostalCode"]</label>
                            <input asp-for="PostalCode" class="form-input" autocomplete="postal-code" />
                            <span asp-validation-for="PostalCode" class="text-danger form-field__error"></span>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ============ Submit bar ============ -->
            <div class="profile-form__actions">
                <a asp-controller="Profile"
                   asp-action="Index"
                   class="btn-action btn-action--ghost">
                    <span>@L["Profile_Cancel"]</span>
                </a>
                <button type="submit" class="btn-action btn-action--success">
                    <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
                    <span>@L["Profile_SaveChanges"]</span>
                </button>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', () => {

            AuthShared.wireDependentCityDropdown(
                '#provinceSelect',
                '#citySelect'
            );

        });
    </script>
}