@using Rokhsetak.ViewModels.Profile
@model ChangeLicenseViewModel

<h2>Change License</h2>

<form method="post">
    @Html.AntiForgeryToken()
    <div class="auth-field">
        <label asp-for="NewLicenseTypeId"
               style="position:static;font-size:.92rem;font-weight:600;color:var(--color-text);margin-bottom:4px;display:block;">
            License Type
        </label>
        <select asp-for="NewLicenseTypeId"
                asp-items="@(new SelectList(Model.AvailableLicenseTypes, "Id", "Name"))"
                class="auth-input auth-select"
                aria-required="true">
            <option value="">-- Select License Type --</option>
        </select>
        <span asp-validation-for="NewLicenseTypeId" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="ConfirmChange" class="form-check-input" />
        <label asp-for="ConfirmChange" class="form-check-label">
            I understand that changing my license will cancel future bookings.
        </label>
        <span asp-validation-for="ConfirmChange" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-danger">
        Change License
    </button>
</form>