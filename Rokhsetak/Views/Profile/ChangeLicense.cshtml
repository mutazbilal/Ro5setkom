@using Rokhsetak.ViewModels.Profile
@using Rokhsetak.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResourceMarker> L
@model ChangeLicenseViewModel
@{
    ViewData["Title"] = L["Profile_ChangeLicense"];
}

@section Styles {
    <link rel="stylesheet" href="~/css/profile.css" />
}

<div class="profile-page">
    <div class="profile-page__inner">

        @if (TempData["Error"] != null)
        {
            <div class="alert dashboard-alert dashboard-alert--error" role="alert">
                <i class="fa-solid fa-triangle-exclamation dashboard-alert__icon" aria-hidden="true"></i>
                <span class="dashboard-alert__message">@TempData["Error"]</span>
                <button type="button" class="dashboard-alert__close" data-bs-dismiss="alert" aria-label="@L["Alert_Close"]">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert dashboard-alert dashboard-alert--success" role="alert">
                <i class="fa-solid fa-circle-check dashboard-alert__icon" aria-hidden="true"></i>
                <span class="dashboard-alert__message">@TempData["Success"]</span>
                <button type="button" class="dashboard-alert__close" data-bs-dismiss="alert" aria-label="@L["Alert_Close"]">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
        }

        <!-- ============ Hero ============ -->
        <section class="profile-hero profile-hero--compact profile-hero--danger" aria-labelledby="change-license-title">
            <div class="profile-hero__main">
                <span class="profile-hero__badge profile-hero__badge--danger" aria-hidden="true">
                    <i class="fa-solid fa-id-card-clip"></i>
                </span>
                <div class="profile-hero__intro">
                    <span class="profile-hero__eyebrow profile-hero__eyebrow--danger">@L["Profile_AccountManagement"]</span>
                    <h1 id="change-license-title" class="profile-hero__title">@L["Profile_ChangeLicense"]</h1>
                    <p class="profile-hero__description">
                        @L["Profile_ChangeLicense_Desc"]
                    </p>
                </div>
            </div>

            <div class="profile-hero__cta">
                <a asp-controller="Profile"
                   asp-action="Index"
                   class="btn-action btn-action--ghost">
                    <i class="fa-solid fa-arrow-left-long" aria-hidden="true"></i>
                    <span>@L["Profile_BackToProfile"]</span>
                </a>
            </div>
        </section>

        <!-- ============ Warning callout ============ -->
        <aside class="callout callout--warning" role="note">
            <span class="callout__icon" aria-hidden="true">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </span>
            <div class="callout__body">
                <p class="callout__title">@L["Profile_ChangeLicense_Warning"]</p>
                <p class="callout__text">
                    @L["Profile_ChangeLicense_WarningText"]
                </p>
            </div>
        </aside>

        <!-- ============ Form ============ -->
        <form asp-action="ChangeLicense" method="post" class="profile-form">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert dashboard-alert dashboard-alert--error" role="alert"></div>

            <section class="profile-card" aria-labelledby="change-license-card-title">
                <header class="profile-card__header">
                    <span class="profile-card__icon" aria-hidden="true">
                        <i class="fa-solid fa-id-card-clip"></i>
                    </span>
                    <div class="profile-card__headings">
                        <p class="profile-card__eyebrow">@L["Profile_LicenseSelection"]</p>
                        <h2 id="change-license-card-title" class="profile-card__title">@L["Profile_PickNewLicense"]</h2>
                    </div>
                </header>

                <div class="profile-card__body">
                    <div class="form-field form-field--full">
                        <label asp-for="NewLicenseTypeId" class="form-field__label form-field__label--required">
                            @L["Profile_NewLicenseType"]
                        </label>
                        <select asp-for="NewLicenseTypeId"
                                asp-items="@(new SelectList(Model.AvailableLicenseTypes, "Id", "Name"))"
                                class="form-select"
                                aria-required="true">
                            <option value="">@L["Profile_SelectLicenseType"]</option>
                        </select>
                        <span asp-validation-for="NewLicenseTypeId" class="text-danger form-field__error"></span>
                    </div>

                    <label class="form-confirm" for="ConfirmChange">
                        <input asp-for="ConfirmChange"
                               id="ConfirmChange"
                               type="checkbox"
                               class="form-confirm__input"
                               aria-required="true" />
                        <span class="form-confirm__box" aria-hidden="true"></span>
                        <span class="form-confirm__label">
                            @L["Profile_ConfirmChange"]
                        </span>
                    </label>
                    <span asp-validation-for="ConfirmChange" class="text-danger form-field__error"></span>
                </div>
            </section>

            <div class="profile-form__actions">
                <a asp-controller="Profile"
                   asp-action="Index"
                   class="btn-action btn-action--ghost">
                    <span>@L["Profile_Cancel"]</span>
                </a>
                <button type="submit" class="btn-action btn-action--danger">
                    <i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i>
                    <span>@L["Profile_ChangeLicense"]</span>
                </button>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}