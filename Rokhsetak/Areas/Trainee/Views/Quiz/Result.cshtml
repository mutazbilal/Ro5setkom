@using Rokhsetak.Areas.Trainee.ViewModels.Quiz
@model QuizResultViewModel
@{
    ViewData["Title"] = "Quiz Result";

    // Drive the hero state class + iconography off the ViewModel.
    string heroState;
    string heroIcon;
    string heroHeading;
    string heroSubhead;
    if (Model.Passed)
    {
        heroState   = "passed";
        heroIcon    = "fa-solid fa-trophy";
        heroHeading = "Passed!";
        heroSubhead = "Excellent work. You’ve cleared the passing threshold and can move on with confidence.";
    }
    else if (Model.IsMockExam)
    {
        heroState   = "mock";
        heroIcon    = "fa-solid fa-clipboard-check";
        heroHeading = "Mock exam completed";
        heroSubhead = "Passing isn’t required for the mock — you’re cleared to book your theory test whenever you’re ready.";
    }
    else
    {
        heroState   = "retry";
        heroIcon    = "fa-solid fa-book-open-reader";
        heroHeading = "Not passed yet";
        heroSubhead = "Review the material and try again — there’s no limit on attempts.";
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/quiz.css" asp-append-version="true" />
}

<div class="quiz-page">
    <div class="quiz-shell">

        <!-- Result hero -->
        <section class="quiz-result quiz-result--@heroState">
            <div class="quiz-result-hero quiz-result-hero--@heroState">
                <div class="quiz-result__icon" aria-hidden="true">
                    <i class="@heroIcon"></i>
                </div>

                <h1 class="quiz-result__heading">@heroHeading</h1>
                <p class="quiz-result__subhead">@heroSubhead</p>

                <div class="quiz-score"
                     data-quiz-score="@Model.Score"
                     role="img"
                     aria-label="Score: @Model.Score percent. Passing score: @Model.PassingScore percent.">
                    <div class="quiz-score__inner">
                        <span class="quiz-score__value">@Model.Score%</span>
                        <span class="quiz-score__label">Pass @Model.PassingScore%</span>
                    </div>
                </div>

                <div class="quiz-stats">
                    <div class="quiz-stat quiz-stat--correct">
                        <div class="quiz-stat__value">@Model.CorrectCount</div>
                        <div class="quiz-stat__label">Correct</div>
                    </div>
                    <div class="quiz-stat quiz-stat--incorrect">
                        <div class="quiz-stat__value">@Model.IncorrectCount</div>
                        <div class="quiz-stat__label">Incorrect</div>
                    </div>
                    <div class="quiz-stat">
                        <div class="quiz-stat__value">@Model.TotalQuestions</div>
                        <div class="quiz-stat__label">Total</div>
                    </div>
                </div>

                <div class="quiz-result__cta">
                    @if (!Model.IsMockExam)
                    {
                        <a asp-area="Trainee"
                           asp-controller="Quiz"
                           asp-action="Take"
                           asp-route-moduleId="@Model.ModuleId"
                           class="quiz-btn quiz-btn--outline">
                            <i class="fa-solid fa-rotate-right" aria-hidden="true"></i>
                            Retake quiz
                        </a>
                        <a asp-area="Trainee"
                           asp-controller="Modules"
                           asp-action="Detail"
                           asp-route-id="@Model.ModuleId"
                           class="quiz-btn quiz-btn--ghost">
                            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
                            Back to module
                        </a>
                    }
                    else
                    {
                        <a asp-area="Trainee"
                           asp-controller="Quiz"
                           asp-action="MockExam"
                           class="quiz-btn quiz-btn--gold">
                            <i class="fa-solid fa-rotate-right" aria-hidden="true"></i>
                            Retake mock exam
                        </a>
                    }
                    <a asp-area="Trainee"
                       asp-controller="Dashboard"
                       asp-action="Index"
                       class="quiz-btn quiz-btn--primary">
                        <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                        Go to dashboard
                    </a>
                </div>
            </div>
        </section>

        <!-- Question breakdown -->
        <h2 class="quiz-section-title">Question breakdown</h2>

        @for (int i = 0; i < Model.Questions.Count; i++)
        {
            var q = Model.Questions[i];
            var statusModifier = q.IsCorrect ? "correct" : "incorrect";

            <article class="quiz-breakdown quiz-breakdown--@statusModifier">
                <header class="quiz-breakdown__head">
                    <div class="quiz-breakdown__head-left">
                        <span class="quiz-question__number" aria-hidden="true">@(i + 1)</span>
                        <span class="quiz-breakdown__qtext">@Html.Raw(q.QuestionText)</span>
                    </div>
                    <span class="quiz-breakdown__status quiz-breakdown__status--@statusModifier"
                          aria-label="@(q.IsCorrect ? "Answered correctly" : "Answered incorrectly")">
                        <i class="fa-solid @(q.IsCorrect ? "fa-check" : "fa-xmark")" aria-hidden="true"></i>
                    </span>
                </header>

                <ul class="quiz-breakdown__options">
                    @foreach (var opt in q.Options)
                    {
                        string optClass;
                        string optIcon;
                        if (opt.IsCorrect && opt.WasSelected)
                        {
                            optClass = "quiz-breakdown__option--correct-selected";
                            optIcon  = "fa-solid fa-check";
                        }
                        else if (opt.IsCorrect)
                        {
                            optClass = "quiz-breakdown__option--correct";
                            optIcon  = "fa-solid fa-check";
                        }
                        else if (opt.WasSelected)
                        {
                            optClass = "quiz-breakdown__option--wrong-selected";
                            optIcon  = "fa-solid fa-xmark";
                        }
                        else
                        {
                            optClass = "";
                            optIcon  = "fa-regular fa-circle";
                        }

                        <li class="quiz-breakdown__option @optClass">
                            <span class="quiz-breakdown__opt-icon" aria-hidden="true">
                                <i class="@optIcon"></i>
                            </span>
                            <span class="quiz-breakdown__opt-text">@Html.Raw(opt.OptionText)</span>

                            @if (opt.WasSelected && !opt.IsCorrect)
                            {
                                <span class="quiz-tag quiz-tag--danger">Your answer</span>
                            }
                            @if (opt.IsCorrect)
                            {
                                <span class="quiz-tag quiz-tag--success">Correct</span>
                            }
                        </li>
                    }
                </ul>
            </article>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/quiz.js" asp-append-version="true"></script>
}
