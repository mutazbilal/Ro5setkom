@using Rokhsetak.Areas.Trainee.ViewModels.Quiz
@model QuizViewModel
@{
    ViewData["Title"] = "Mock Exam";
    int totalSeconds = Model.TimeLimitMinutes * 60;
}

<div class="container py-4">
    <!-- Timer bar -->
    <div class="sticky-top bg-white shadow-sm py-2 mb-4" style="z-index:1000;">
        <div class="container d-flex justify-content-between align-items-center">
            <h4 class="fw-bold mb-0">@Model.Title</h4>
            <div class="d-flex align-items-center gap-3">
                <span class="badge bg-danger fs-6" id="timerDisplay">
                    @Model.TimeLimitMinutes:00
                </span>
                <span class="text-muted small">@Model.Questions.Count questions</span>
            </div>
        </div>
        <div class="progress mt-2" style="height:4px;">
            <div class="progress-bar bg-danger" id="timerBar" style="width:100%"></div>
        </div>
    </div>

    <div class="alert alert-warning mb-4">
        <strong>Mock Exam Rules:</strong> This is a timed simulation. You have
        <strong>@Model.TimeLimitMinutes minutes</strong>. The exam will submit automatically
        when time runs out. Passing is not required to proceed.
    </div>

    <form asp-area="Trainee" asp-controller="Quiz" asp-action="SubmitMockExam"
          method="post" id="mockExamForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="QuizId" value="@Model.QuizId" />
        <input type="hidden" name="TraineeLicenseId" value="@Model.TraineeLicenseId" />
        <input type="hidden" name="ModuleId" value="0" />

        @for (int i = 0; i < Model.Questions.Count; i++)
        {
            var q = Model.Questions[i];
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <p class="fw-semibold mb-3">
                        <span class="badge bg-secondary me-2">@(i + 1)</span>
                        @q.QuestionText
                    </p>
                    <div class="d-flex flex-column gap-2">
                        @foreach (var opt in q.Options)
                        {
                            <div class="form-check quiz-option p-2 rounded border">
                                <input class="form-check-input" type="radio"
                                       name="Answers[@q.QuestionId]"
                                       id="opt-@opt.OptionId"
                                       value="@opt.OptionId" />
                                <label class="form-check-label w-100" for="opt-@opt.OptionId">
                                    @opt.OptionText
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <div class="d-flex justify-content-end mt-4">
            <button type="submit" class="btn btn-danger px-4" id="submitMockBtn">
                <i class="bi bi-send-check"></i> Submit Mock Exam
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        let totalSeconds = @totalSeconds;
        const display   = document.getElementById('timerDisplay');
        const bar       = document.getElementById('timerBar');
        const form      = document.getElementById('mockExamForm');
        const btn       = document.getElementById('submitMockBtn');

        function updateTimer() {
            if (totalSeconds <= 0) {
                display.textContent = '0:00';
                bar.style.width = '0%';
                btn.disabled = true;
                btn.textContent = 'Time is up — submitting...';
                form.submit();
                return;
            }
            const m = Math.floor(totalSeconds / 60);
            const s = totalSeconds % 60;
            display.textContent = `${m}:${s.toString().padStart(2, '0')}`;
            const pct = (totalSeconds / @totalSeconds) * 100;
            bar.style.width = pct + '%';
            if (totalSeconds <= 60) {
                display.classList.remove('bg-danger');
                display.classList.add('bg-warning', 'text-dark');
            }
            totalSeconds--;
        }

        updateTimer();
        setInterval(updateTimer, 1000);

        form.addEventListener('submit', function () {
            btn.disabled = true;
        });

        document.querySelectorAll('.quiz-option').forEach(function (opt) {
            opt.querySelector('input').addEventListener('change', function () {
                const name = this.name;
                document.querySelectorAll(`input[name="${name}"]`).forEach(function (r) {
                    r.closest('.quiz-option').classList.remove('border-primary', 'bg-primary', 'bg-opacity-10');
                });
                this.closest('.quiz-option').classList.add('border-primary', 'bg-primary', 'bg-opacity-10');
            });
        });
    </script>
}