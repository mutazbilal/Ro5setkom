@using Rokhsetak.Areas.Trainee.ViewModels.Quiz
@model QuizViewModel
@{
    ViewData["Title"] = Model.Title;
}

@section Styles {
    <link rel="stylesheet" href="~/css/quiz.css" asp-append-version="true" />
}

<div class="quiz-page">
    <div class="quiz-shell">

        <header class="quiz-header">
            <div class="quiz-header__row">
                <h1 class="quiz-header__title">@Model.Title</h1>
                <div class="quiz-header__meta">
                    <span class="quiz-chip" aria-label="@Model.Questions.Count questions in this quiz">
                        <i class="fa-solid fa-list-check" aria-hidden="true"></i>
                        @Model.Questions.Count Questions
                    </span>
                </div>
            </div>
        </header>

        <div class="quiz-banner" role="note">
            <span class="quiz-banner__icon" aria-hidden="true">
                <i class="fa-solid fa-circle-info"></i>
            </span>
            <span>
                <span class="quiz-banner__title">Passing score: @Model.PassingScore%</span>
                Take your time. If you don’t pass on this attempt, you can retake the quiz as many times as you need.
            </span>
        </div>

        <div asp-validation-summary="ModelOnly" class="quiz-validation"></div>

        <form asp-area="Trainee"
              asp-controller="Quiz"
              asp-action="Submit"
              method="post"
              data-quiz-form
              novalidate>
            @Html.AntiForgeryToken()

            @* Bound to QuizViewModel — names match SubmitQuizViewModel so model binding works on POST. *@
            <input type="hidden" asp-for="QuizId" />
            <input type="hidden" asp-for="TraineeLicenseId" />
            <input type="hidden" asp-for="ModuleId" />

            @for (int i = 0; i < Model.Questions.Count; i++)
            {
                var q = Model.Questions[i];
                var legendId = $"q-legend-{q.QuestionId}";

                <fieldset class="quiz-question" id="q-@q.QuestionId" aria-labelledby="@legendId">
                    <legend class="quiz-question__legend">
                        <span class="quiz-question__number" aria-hidden="true">@(i + 1)</span>
                        <span class="quiz-question__text" id="@legendId">@q.QuestionText</span>
                    </legend>

                    <div class="quiz-options" role="radiogroup" aria-labelledby="@legendId">
                        @foreach (var opt in q.Options)
                        {
                            var optId = $"opt-{q.QuestionId}-{opt.OptionId}";

                            <label class="quiz-option" for="@optId">
                                @*
                                    NOTE: The radio name must be "Answers[QuestionId]" so that
                                    ASP.NET binds it to SubmitQuizViewModel.Answers (Dictionary<int,int>).
                                    asp-for cannot express a dictionary key based on a dynamic loop
                                    variable, so the literal name attribute is intentional here.
                                *@
                                <input class="quiz-option__input"
                                       type="radio"
                                       id="@optId"
                                       name="Answers[@q.QuestionId]"
                                       value="@opt.OptionId"
                                       required
                                       aria-required="true" />
                                <span class="quiz-option__dot" aria-hidden="true"></span>
                                <span class="quiz-option__label">@opt.OptionText</span>
                            </label>
                        }
                    </div>
                </fieldset>
            }

            <div class="quiz-actions">
                <a asp-area="Trainee"
                   asp-controller="Modules"
                   asp-action="Detail"
                   asp-route-id="@Model.ModuleId"
                   class="quiz-btn quiz-btn--ghost">
                    <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
                    Cancel
                </a>

                <button type="submit"
                        class="quiz-btn quiz-btn--primary"
                        data-quiz-submit>
                    <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
                    <span data-quiz-submit-label data-loading-text="Submitting…">Submit Quiz</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/quiz.js" asp-append-version="true"></script>
}
