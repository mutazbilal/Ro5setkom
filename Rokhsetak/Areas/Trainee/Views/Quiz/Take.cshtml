@using Rokhsetak.Areas.Trainee.ViewModels.Quiz;
@model QuizViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold mb-0">@Model.Title</h3>
        <span class="badge bg-info text-dark">@Model.Questions.Count Questions</span>
    </div>

    <div class="alert alert-light border mb-4">
        Passing score: <strong>@Model.PassingScore%</strong>. You may reattempt if you do not pass.
    </div>

    <form asp-area="Trainee" asp-controller="Quiz" asp-action="Submit" method="post"
          id="quizForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="QuizId" value="@Model.QuizId" />
        <input type="hidden" name="TraineeLicenseId" value="@Model.TraineeLicenseId" />
        <input type="hidden" name="ModuleId" value="@Model.ModuleId" />

        @for (int i = 0; i < Model.Questions.Count; i++)
        {
            var q = Model.Questions[i];
            <div class="card shadow-sm mb-3" id="q-@q.QuestionId">
                <div class="card-body">
                    <p class="fw-semibold mb-3">
                        <span class="badge bg-secondary me-2">@(i + 1)</span>
                        @q.QuestionText
                    </p>
                    <div class="d-flex flex-column gap-2">
                        @foreach (var opt in q.Options)
                        {
                            <div class="form-check quiz-option p-2 rounded border">
                                <input class="form-check-input"
                                       type="radio"
                                       name="Answers[@q.QuestionId]"
                                       id="opt-@opt.OptionId"
                                       value="@opt.OptionId"
                                       required />
                                <label class="form-check-label w-100" for="opt-@opt.OptionId">
                                    @opt.OptionText
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <div class="d-flex justify-content-between mt-4">
            <a asp-area="Trainee" asp-controller="Modules" asp-action="Detail"
                   asp-route-id="@Model.ModuleId" class="btn btn-outline-secondary">
                ← Cancel
            </a>
            <button type="submit" class="btn btn-primary px-4" id="submitBtn">
                <i class="bi bi-send-check"></i> Submit Quiz
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // Prevent accidental double-submit
        document.getElementById('quizForm').addEventListener('submit', function () {
            document.getElementById('submitBtn').disabled = true;
            document.getElementById('submitBtn').textContent = 'Submitting...';
        });

        // Highlight selected option
        document.querySelectorAll('.quiz-option').forEach(function (label) {
            label.querySelector('input').addEventListener('change', function () {
                const name = this.name;
                document.querySelectorAll(`input[name="${name}"]`).forEach(function (r) {
                    r.closest('.quiz-option').classList.remove('border-primary', 'bg-primary', 'bg-opacity-10');
                });
                this.closest('.quiz-option').classList.add('border-primary', 'bg-primary', 'bg-opacity-10');
            });
        });
    </script>
}