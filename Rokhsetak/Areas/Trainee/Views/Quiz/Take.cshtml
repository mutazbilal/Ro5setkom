@using Rokhsetak.Areas.Trainee.ViewModels.Quiz
@using System.Text.RegularExpressions;
@using Rokhsetak.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResourceMarker> L
@model QuizViewModel
@{
    ViewData["Title"] = Regex.Replace(Model.Title, "<.*?>", string.Empty);
}

@section Styles {
    <link rel="stylesheet" href="~/css/quiz.css" asp-append-version="true" />
}

<div class="quiz-page">
    <div class="quiz-shell">

        <header class="quiz-header">
            <div class="quiz-header__row">
                <h1 class="quiz-header__title">@Html.Raw(Model.Title)</h1>
                <div class="quiz-header__meta">
                    <span class="quiz-chip" aria-label="@string.Format(L["Quiz_QuestionsInQuizAria"], Model.Questions.Count)">
                        <i class="fa-solid fa-list-check" aria-hidden="true"></i>
                        @string.Format(L["Quiz_QuestionsCount"], Model.Questions.Count)
                    </span>
                </div>
            </div>
        </header>

        <div class="quiz-banner" role="note">
            <span class="quiz-banner__icon" aria-hidden="true">
                <i class="fa-solid fa-circle-info"></i>
            </span>
            <span>
                <span class="quiz-banner__title">@string.Format(L["Quiz_PassingScoreLabel"], Model.PassingScore)</span>
                @L["Quiz_RetakeUnlimitedMessage"]
            </span>
        </div>

        <div asp-validation-summary="ModelOnly" class="quiz-validation"></div>

        <form asp-area="Trainee"
              asp-controller="Quiz"
              asp-action="Submit"
              method="post"
              data-quiz-form
              novalidate>
            @Html.AntiForgeryToken()

            @* Bound to QuizViewModel — names match SubmitQuizViewModel so model binding works on POST. *@
            <input type="hidden" asp-for="QuizId" />
            <input type="hidden" asp-for="TraineeLicenseId" />
            <input type="hidden" asp-for="ModuleId" />

            @for (int i = 0; i < Model.Questions.Count; i++)
            {
                var q = Model.Questions[i];
                var legendId = $"q-legend-{q.QuestionId}";

                <div class="quiz-question" id="q-@q.QuestionId" aria-labelledby="@legendId">
                    <div class="quiz-question__legend">
                        <span class="quiz-question__number" aria-hidden="true">@(i + 1)</span>
                        <div class="quiz-question__text" id="@legendId">
                            @Html.Raw(q.QuestionText)
                        </div>
                    </div>

                    <div class="quiz-options" role="radiogroup" aria-labelledby="@legendId">
                        @foreach (var opt in q.Options)
                        {
                            var optId = $"opt-{q.QuestionId}-{opt.OptionId}";

                            <label class="quiz-option" for="@optId">
                                <input class="quiz-option__input"
                                       type="radio"
                                       id="@optId"
                                       name="Answers[@q.QuestionId]"
                                       value="@opt.OptionId"
                                       required
                                       aria-required="true" />
                                <span class="quiz-option__dot" aria-hidden="true"></span>
                                <span class="quiz-option__label">@Html.Raw(opt.OptionText)</span>
                            </label>
                        }
                    </div>
                </div>
            }

            <div class="quiz-actions">
                <a asp-area="Trainee"
                   asp-controller="Modules"
                   asp-action="Detail"
                   asp-route-id="@Model.ModuleId"
                   class="quiz-btn quiz-btn--ghost">
                    <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
                    @L["Common_Cancel"]
                </a>

                <button type="submit"
                        class="quiz-btn quiz-btn--primary"
                        data-quiz-submit>
                    <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
                    <span data-quiz-submit-label data-loading-text="@L["Quiz_Submitting"]">@L["Quiz_Submit"]</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/quiz.js" asp-append-version="true"></script>
}