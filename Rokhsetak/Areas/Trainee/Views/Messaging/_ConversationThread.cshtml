@* This partial is used by BOTH Mentor and Trainee areas.
   It accepts either ConversationDetailViewModel.
   The send endpoint URL is resolved via ViewData["SendUrl"] set by the controller,
   or falls back to a data-attribute approach driven by chat.js. *@

@using Rokhsetak.ViewModels.Messaging

@{
    // Duck-type: both area detail VMs expose ConversationId + Messages + the "other" name
    dynamic model      = ViewData.Model;
    int convId         = (int)model.ConversationId;
    string otherName   = (string)(model.MentorName ?? model.TraineeName ?? "");
    var messages       = (IReadOnlyList<MessageItemViewModel>)model.Messages;

    // Detect which area we're in
    var area     = ViewContext.RouteData.Values["area"]?.ToString() ?? "";
    var sendUrl  = area == "Mentor"
        ? Url.Action("Send", "Messaging", new { Area = "Mentor" })
        : Url.Action("Send", "Messaging", new { Area = "Trainee" });
}

<div class="thread-header">
    <div class="thread-avatar">@(otherName.Length > 0 ? otherName[0].ToString() : "?")</div>
    <div class="thread-identity">
        <span class="thread-name">@otherName</span>
        <span class="thread-status">Active</span>
    </div>
</div>

<div class="thread-messages" id="threadMessages" data-conv-id="@convId">

    @foreach (var msg in messages)
    {
        <div class="msg @(msg.IsMine ? "msg-mine" : "msg-theirs")" data-id="@msg.MessageId">
            @if (!msg.IsMine)
            {
                <div class="msg-avatar">@(otherName.Length > 0 ? otherName[0].ToString() : "?")</div>
            }
            <div class="msg-body">
                @if (msg.IsFile)
                {
                    @if (msg.FileType == "pdf")
                    {
                        <a class="msg-file msg-file-pdf" href="@msg.FileUrl" target="_blank" rel="noopener noreferrer">
                            <span class="file-icon">📄</span>
                            <span class="file-name">@msg.FileName</span>
                            <span class="file-action">Download PDF</span>
                        </a>
                    }
                    else
                    {
                        <div class="msg-file msg-file-image">
                            <img src="@msg.FileUrl" alt="@msg.FileName" loading="lazy"
                                 onclick="openImageModal(this.src)" />
                            <span class="file-name">@msg.FileName</span>
                        </div>
                    }
                }
                else
                {
                    <p class="msg-text">@msg.Text</p>
                }
                <div class="msg-meta">
                    <span class="msg-time">@msg.SentAt.ToString("HH:mm")</span>
                    @if (msg.IsMine)
                    {
                        <span class="msg-read-tick @(msg.IsRead == true ? "read" : "")">✓✓</span>
                    }
                </div>
            </div>
        </div>
    }

    @if (!messages.Any())
    {
        <div class="thread-no-msgs">
            <p>No messages yet. Say hello! 👋</p>
        </div>
    }

</div>
<form class="compose-bar" id="composeForm"
      action="@sendUrl" method="post"
      enctype="multipart/form-data"
      data-conv-id="@convId">
    @Html.AntiForgeryToken()
    <input type="hidden" name="conversationId" value="@convId" />

    <label class="compose-file-btn" for="fileInput" title="Attach file (PDF or image, max 10 MB)">
        📎
        <input type="file" id="fileInput" name="file"
               accept=".pdf,.png,.jpg,.jpeg,.webp"
               style="display:none" />
    </label>

    <div class="compose-input-wrap">
        <textarea id="composeText" name="text"
                  placeholder="Type a message…"
                  rows="1" maxlength="4000"
                  autocomplete="off"></textarea>
        <div class="file-preview" id="filePreview" style="display:none">
            <span id="filePreviewName"></span>
            <button type="button" id="clearFile" title="Remove file">✕</button>
        </div>
    </div>

    <button class="compose-send-btn" type="submit" title="Send">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="22" y1="2" x2="11" y2="13"/>
            <polygon points="22 2 15 22 11 13 2 9 22 2"/>
        </svg>
    </button>
</form>
<div class="img-modal" id="imgModal" style="display:none" onclick="closeImageModal()">
    <img id="imgModalSrc" src="" alt="Preview" />
</div>
