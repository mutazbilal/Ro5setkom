@using Rokhsetak.Areas.Trainee.ViewModels.Dashboard
@model TraineeDashboardViewModel
@{
    ViewData["Title"] = "My Dashboard";

    var langClaim = Context.User.FindFirst("language")?.Value;
    var isRtl     = !string.IsNullOrEmpty(langClaim) && langClaim == "ar";
    var dirAttr   = isRtl ? "rtl" : "ltr";

    // ---- Per-track derived values ----
    // Lists are limited to 3 modules on the dashboard (canonical order).
    // The full Count is preserved for the "x of N" stat in the header strip.
    var theoryAll       = Model.TheoreticalModules.ToList();
    var theoryShown     = theoryAll.Take(3).ToList();
    var theoryCompleted = theoryAll.Count(m => m.Status == "completed");
    var theoryTotal     = theoryAll.Count;
    var theoryPct       = theoryTotal > 0
                            ? (int)Math.Round(100.0 * theoryCompleted / theoryTotal)
                            : 0;
    var theoryUpNextIdx = theoryShown.FindIndex(m => m.Status != "completed");

    var practicalAll       = Model.PracticalModules.ToList();
    var practicalShown     = practicalAll.Take(3).ToList();
    var practicalCompleted = practicalAll.Count(m => m.Status == "completed");
    var practicalTotal     = practicalAll.Count;
    var practicalPct       = practicalTotal > 0
                                ? (int)Math.Round(100.0 * practicalCompleted / practicalTotal)
                                : 0;
    var practicalUpNextIdx = practicalShown.FindIndex(m => m.Status != "completed");
}

@functions {
    /// <summary>
    /// Picks the FA icon, BEM modifier, and human label for a module's status.
    /// </summary>
    (string iconClass, string modifier, string label) StatusPresentation(string status, bool isLocked)
    {
        var key = isLocked ? "locked" : status;
        return key switch
        {
            "completed"   => ("fa-solid fa-circle-check", "completed",   "completed"),
            "in_progress" => ("fa-solid fa-circle-play",  "in-progress", "in progress"),
            "locked"      => ("fa-solid fa-lock",         "locked",      "locked"),
            _             => ("fa-regular fa-circle",     "pending",     status?.Replace("_", " ") ?? "pending")
        };
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" />
}

<div class="trainee-dashboard">
    <div class="trainee-dashboard__inner">

        @if (TempData["Error"] != null)
        {
            <div class="alert dashboard-alert dashboard-alert--error" role="alert">
                <i class="fa-solid fa-triangle-exclamation dashboard-alert__icon" aria-hidden="true"></i>
                <span class="dashboard-alert__message">@TempData["Error"]</span>
                <button type="button"
                        class="dashboard-alert__close"
                        data-alert-dismiss
                        aria-label="Close">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert dashboard-alert dashboard-alert--success" role="alert">
                <i class="fa-solid fa-circle-check dashboard-alert__icon" aria-hidden="true"></i>
                <span class="dashboard-alert__message">@TempData["Success"]</span>
                <button type="button"
                        class="dashboard-alert__close"
                        data-alert-dismiss
                        aria-label="Close">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
        }

        <!-- ============ Hero ============ -->
        <section class="dashboard-hero" aria-labelledby="dashboard-title">
            <div class="dashboard-hero__intro">
                <span class="dashboard-hero__eyebrow">Trainee Dashboard</span>
                <h1 id="dashboard-title" class="dashboard-hero__title">My License Journey</h1>
                <div class="dashboard-hero__meta">
                    <span class="chip chip--primary" aria-label="License type">
                        <i class="fa-solid fa-id-card" aria-hidden="true"></i>
                        @Model.LicenseTypeName
                    </span>
                    <span class="chip chip--soft" aria-label="Current stage">
                        <i class="fa-solid fa-route" aria-hidden="true"></i>
                        @Model.Stage.Replace("_", " ")
                    </span>
                </div>
            </div>

            <div class="dashboard-hero__cta">
                <a asp-area="Trainee"
                   asp-controller="Modules"
                   asp-action="Index"
                   class="btn-action btn-action--outline">
                    <i class="fa-solid fa-book-open" aria-hidden="true"></i>
                    <span>View Modules</span>
                </a>
            </div>
        </section>

        <!-- ============ Overall Progress ============ -->
        <section class="progress-card" aria-labelledby="progress-card-label">
            <div class="progress-card__head">
                <div>
                    <span id="progress-card-label" class="progress-card__label">Overall Progress</span>
                    <p class="progress-card__sublabel">Your full journey from theory to licensed driver</p>
                </div>
                <div class="progress-card__percent" aria-hidden="true">
                    <span class="progress-card__percent-num">@Model.OverallProgressPercentage</span><span class="progress-card__percent-sym">%</span>
                </div>
            </div>

            <div class="progress-card__bar"
                 role="progressbar"
                 aria-valuenow="@Model.OverallProgressPercentage"
                 aria-valuemin="0"
                 aria-valuemax="100"
                 aria-label="Overall completion">
                <div class="progress-card__bar-fill" style="--progress-value: @(Model.OverallProgressPercentage)%"></div>
            </div>

            <div class="progress-card__next">
                <span class="progress-card__next-icon" aria-hidden="true">
                    <i class="fa-solid fa-flag-checkered"></i>
                </span>
                <span class="progress-card__next-text">
                    <span class="progress-card__next-label">Next milestone</span>
                    <span class="progress-card__next-value">@Model.NextMilestone</span>
                </span>
            </div>
        </section>

        <!-- ============ Tracks ============ -->
        <div class="tracks-grid">

            <!-- Theoretical -->
            <section class="track-card track-card--theory" aria-labelledby="track-theory-title">
                <header class="track-card__header">
                    <span class="track-card__icon" aria-hidden="true">
                        <i class="fa-solid fa-book"></i>
                    </span>
                    <div class="track-card__headings">
                        <p class="track-card__eyebrow">Track 01</p>
                        <h2 id="track-theory-title" class="track-card__title">Theoretical Preparation</h2>
                    </div>
                    <span class="track-card__count" aria-label="Modules in this track">
                        @theoryTotal
                    </span>
                </header>

                <div class="track-card__progress">
                    <div class="track-card__progress-row">
                        <span class="track-card__progress-label">
                            @theoryCompleted of @theoryTotal complete
                        </span>
                        <span class="track-card__progress-value">@theoryPct%</span>
                    </div>
                    <div class="track-card__progress-bar"
                         role="progressbar"
                         aria-valuenow="@theoryPct" aria-valuemin="0" aria-valuemax="100"
                         aria-label="Theoretical track progress">
                        <div class="track-card__progress-fill"
                             style="--track-progress: @(theoryPct)%"></div>
                    </div>
                </div>

                <ul class="module-list">
                    @for (var i = 0; i < theoryShown.Count; i++)
                    {
                        var m = theoryShown[i];
                        var presentation = StatusPresentation(m.Status, m.IsLocked);
                        var isUpNext = i == theoryUpNextIdx;
                        var itemClass = $"module-item module-item--{presentation.modifier}"
                                      + (isUpNext ? " module-item--up-next" : "");
                        <li class="@itemClass">
                            <div class="module-item__main">
                                <span class="module-item__status-icon module-item__status-icon--@presentation.modifier" aria-hidden="true">
                                    <i class="@presentation.iconClass"></i>
                                </span>
                                <span class="module-item__title">@m.Title</span>
                            </div>
                            @if (isUpNext)
                            {
                                <span class="status-pill status-pill--up-next">up next</span>
                            }
                            else
                            {
                                <span class="status-pill status-pill--@presentation.modifier">@presentation.label</span>
                            }
                        </li>
                    }
                    @if (!theoryShown.Any())
                    {
                        <li class="module-list__empty">
                            <i class="fa-regular fa-folder-open" aria-hidden="true"></i>
                            <span>No theoretical modules found yet.</span>
                        </li>
                    }
                </ul>
            </section>

            <!-- Practical -->
            <section class="track-card track-card--practical" aria-labelledby="track-practical-title">
                <header class="track-card__header">
                    <span class="track-card__icon" aria-hidden="true">
                        <i class="fa-solid fa-car-side"></i>
                    </span>
                    <div class="track-card__headings">
                        <p class="track-card__eyebrow">Track 02</p>
                        <h2 id="track-practical-title" class="track-card__title">Practical Preparation</h2>
                    </div>
                    <span class="track-card__count" aria-label="Modules in this track">
                        @practicalTotal
                    </span>
                </header>

                <div class="track-card__progress">
                    <div class="track-card__progress-row">
                        <span class="track-card__progress-label">
                            @practicalCompleted of @practicalTotal complete
                        </span>
                        <span class="track-card__progress-value">@practicalPct%</span>
                    </div>
                    <div class="track-card__progress-bar"
                         role="progressbar"
                         aria-valuenow="@practicalPct" aria-valuemin="0" aria-valuemax="100"
                         aria-label="Practical track progress">
                        <div class="track-card__progress-fill"
                             style="--track-progress: @(practicalPct)%"></div>
                    </div>
                </div>

                <ul class="module-list">
                    @for (var i = 0; i < practicalShown.Count; i++)
                    {
                        var m = practicalShown[i];
                        var presentation = StatusPresentation(m.Status, m.IsLocked);
                        var isUpNext = i == practicalUpNextIdx;
                        var itemClass = $"module-item module-item--{presentation.modifier}"
                                      + (isUpNext ? " module-item--up-next" : "");
                        <li class="@itemClass">
                            <div class="module-item__main">
                                <span class="module-item__status-icon module-item__status-icon--@presentation.modifier" aria-hidden="true">
                                    <i class="@presentation.iconClass"></i>
                                </span>
                                <span class="module-item__title">@m.Title</span>
                            </div>
                            @if (isUpNext)
                            {
                                <span class="status-pill status-pill--up-next">up next</span>
                            }
                            else
                            {
                                <span class="status-pill status-pill--@presentation.modifier">@presentation.label</span>
                            }
                        </li>
                    }
                    @if (!practicalShown.Any())
                    {
                        <li class="module-list__empty">
                            <i class="fa-regular fa-folder-open" aria-hidden="true"></i>
                            <span>No practical modules yet.</span>
                        </li>
                    }
                </ul>
            </section>
        </div>

        <!-- ============ Mock Exam ============ -->
        <section class="mock-exam @(Model.IsMockExamCompleted ? "mock-exam--completed" : Model.IsMockExamAvailable ? "mock-exam--ready" : "mock-exam--locked")"
                 aria-labelledby="mock-exam-title">
            <div class="mock-exam__decor" aria-hidden="true"></div>

            <div class="mock-exam__main">
                <span class="mock-exam__icon" aria-hidden="true">
                    <i class="fa-solid fa-clipboard-check"></i>
                </span>
                <div class="mock-exam__text">
                    <p class="mock-exam__eyebrow">Final Checkpoint</p>
                    <h2 id="mock-exam-title" class="mock-exam__title">Mock Exam</h2>
                    <p class="mock-exam__caption">
                        @if (Model.IsMockExamCompleted)
                        {
                            <i class="fa-solid fa-circle-check mock-exam__caption-icon" aria-hidden="true"></i>
                            <span>Completed &mdash; you may now book the theory test.</span>
                        }
                        else if (Model.IsMockExamAvailable)
                        {
                            <i class="fa-solid fa-bolt mock-exam__caption-icon" aria-hidden="true"></i>
                            <span>Ready! Complete this exam to unlock your theory test booking.</span>
                        }
                        else
                        {
                            <i class="fa-solid fa-lock mock-exam__caption-icon" aria-hidden="true"></i>
                            <span>Unlocks once all theoretical modules are completed.</span>
                        }
                    </p>
                </div>
            </div>

            <div class="mock-exam__action">
                @if (Model.IsMockExamAvailable)
                {
                    <a asp-area="Trainee"
                       asp-controller="Quiz"
                       asp-action="MockExam"
                       class="btn-action @(Model.IsMockExamCompleted ? "btn-action--ghost-success" : "btn-action--gradient")">
                        <i class="fa-solid @(Model.IsMockExamCompleted ? "fa-rotate-right" : "fa-play")" aria-hidden="true"></i>
                        <span>@(Model.IsMockExamCompleted ? "Retake Mock Exam" : "Start Mock Exam")</span>
                    </a>
                }
                else
                {
                    <button type="button" class="btn-action btn-action--locked" disabled aria-disabled="true">
                        <i class="fa-solid fa-lock" aria-hidden="true"></i>
                        <span>Locked</span>
                    </button>
                }
            </div>
        </section>

    </div>
</div>

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
