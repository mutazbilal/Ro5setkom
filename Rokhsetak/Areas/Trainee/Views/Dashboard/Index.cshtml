@using Rokhsetak.Areas.Trainee.ViewModels.Dashboard
@model TraineeDashboardViewModel
@{
    ViewData["Title"] = "My Dashboard";
    bool isRtl = !string.IsNullOrEmpty(Context.User.FindFirst("language")?.Value)
                 && Context.User.FindFirst("language")!.Value == "ar";
}

<div class="container py-4" dir="@(isRtl ? "rtl" : "ltr")">

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">My License Journey</h2>
            <p class="text-muted mb-0">
                <span class="badge bg-primary text-uppercase">@Model.LicenseTypeName</span>
                &nbsp;&middot;&nbsp;
                <span class="badge bg-secondary text-uppercase">@Model.Stage.Replace("_", " ")</span>
            </p>
        </div>
        <a asp-area="Trainee" asp-controller="Modules" asp-action="Index"
               class="btn btn-outline-primary">
            <i class="bi bi-book"></i> View Modules
        </a>
    </div>

    <!-- Overall progress bar -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between mb-1">
                <span class="fw-semibold">Overall Progress</span>
                <span class="fw-bold text-primary">@Model.OverallProgressPercentage%</span>
            </div>
            <div class="progress" style="height: 12px;">
                <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
                     role="progressbar"
                     style="width: @Model.OverallProgressPercentage%"
                     aria-valuenow="@Model.OverallProgressPercentage"
                     aria-valuemin="0" aria-valuemax="100">
                </div>
            </div>
            <p class="text-muted small mt-2 mb-0">
                <i class="bi bi-flag-fill text-warning"></i>
                <strong>Next:</strong> @Model.NextMilestone
            </p>
        </div>
    </div>

    <div class="row g-4">
        <!-- Theoretical Modules -->
        <div class="col-md-6">
            <div class="card h-100 shadow-sm">
                <div class="card-header bg-info text-white fw-semibold">
                    <i class="bi bi-journal-text"></i> Theoretical Preparation
                </div>
                <ul class="list-group list-group-flush">
                    @foreach (var m in Model.TheoreticalModules)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>
                                @if (m.IsLocked)
                                {
                                    <i class="bi bi-lock-fill text-secondary me-1"></i>
                                }
                                else if (m.Status == "completed")
                                {
                                    <i class="bi bi-check-circle-fill text-success me-1"></i>
                                }
                                else if (m.Status == "in_progress")
                                {
                                    <i class="bi bi-play-circle-fill text-primary me-1"></i>
                                }
                                else
                                {
                                    <i class="bi bi-circle text-muted me-1"></i>
                                }
                                @m.Title
                            </span>
                            @{
                                var badgeClass = m.Status switch
                                {
                                    "completed" => "bg-success",
                                    "in_progress" => "bg-primary",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @badgeClass">@m.Status.Replace("_", " ")</span>
                        </li>
                    }
                    @if (!Model.TheoreticalModules.Any())
                    {
                        <li class="list-group-item text-muted">No theoretical modules found.</li>
                    }
                </ul>
            </div>
        </div>

        <!-- Practical Modules -->
        <div class="col-md-6">
            <div class="card h-100 shadow-sm">
                <div class="card-header bg-warning fw-semibold">
                    <i class="bi bi-car-front-fill"></i> Practical Preparation
                </div>
                <ul class="list-group list-group-flush">
                    @foreach (var m in Model.PracticalModules)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>
                                @if (m.IsLocked)
                                {
                                    <i class="bi bi-lock-fill text-secondary me-1"></i>
                                }
                                else if (m.Status == "completed")
                                {
                                    <i class="bi bi-check-circle-fill text-success me-1"></i>
                                }
                                else if (m.Status == "in_progress")
                                {
                                    <i class="bi bi-play-circle-fill text-primary me-1"></i>
                                }
                                else
                                {
                                    <i class="bi bi-circle text-muted me-1"></i>
                                }
                                @m.Title
                            </span>
                            @{
                                var bc = m.Status switch
                                {
                                    "completed" => "bg-success",
                                    "in_progress" => "bg-primary",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @bc">@m.Status.Replace("_", " ")</span>
                        </li>
                    }
                    @if (!Model.PracticalModules.Any())
                    {
                        <li class="list-group-item text-muted">No practical modules yet.</li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <!-- Mock Exam Card -->
    <div class="card shadow-sm mt-4">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <h5 class="mb-1">
                    <i class="bi bi-clipboard2-check-fill text-danger"></i> Mock Exam
                </h5>
                <p class="mb-0 text-muted small">
                    @if (Model.IsMockExamCompleted)
                    {
                        <span class="text-success fw-semibold">✓ Completed — you may now book the theory test</span>
                    }
                    else if (Model.IsMockExamAvailable)
                    {
                        <span>Ready! Complete to unlock your theory exam booking.</span>
                    }
                    else
                    {
                        <span>Available after all theoretical modules are completed.</span>
                    }
                </p>
            </div>
            @if (Model.IsMockExamAvailable)
            {
                <a asp-area="Trainee" asp-controller="Quiz" asp-action="MockExam"
                       class="btn @(Model.IsMockExamCompleted ? "btn-outline-success" : "btn-danger")">
                    @(Model.IsMockExamCompleted ? "Retake Mock Exam" : "Start Mock Exam")
                </a>
            }
            else
            {
                <button class="btn btn-secondary" disabled>Locked</button>
            }
        </div>
    </div>

</div>