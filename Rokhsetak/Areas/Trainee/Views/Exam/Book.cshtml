@using Rokhsetak.Areas.Trainee.ViewModels.Exam
@using Rokhsetak.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResourceMarker> L
@model ExamBookingViewModel
@{
    ViewData["Title"] = string.Format(L["Exam_BookTitle"], L[$"Exam_{Model.ExamType}_Name"]);

    string TypeIcon(string t) => t switch
    {
        "theory"    => "fa-solid fa-book-open",
        "medical"   => "fa-solid fa-stethoscope",
        "practical" => "fa-solid fa-car",
        _           => "fa-solid fa-file-lines"
    };

    string TypeLabel(string t) => L[$"Exam_{t}_Name"];
}

@section Styles {
    <link href="~/css/exam.css" rel="stylesheet" asp-append-version="true" />
}

<div class="exam-wrap">

    @if (TempData["Error"] != null)
    {
        <div class="exam-flash exam-flash--error" role="alert">
            <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
            <span>@TempData["Error"]</span>
        </div>
    }

    <nav class="exam-breadcrumb" aria-label="@L["Exam_Breadcrumb"]">
        <a asp-area="Trainee" asp-controller="Exam" asp-action="Index">@L["Exam_Appointments"]</a>
        <span class="sep" aria-hidden="true">/</span>
        <span class="current">@string.Format(L["Exam_BookType"], TypeLabel(Model.ExamType))</span>
    </nav>

    <header class="exam-header">
        <div class="exam-header__left">
            <p class="exam-eyebrow">
                <i class="@TypeIcon(Model.ExamType)" aria-hidden="true"></i>
                @TypeLabel(Model.ExamType) @L["Exam_ExamLabel"]
            </p>
            <h1>@L["Exam_BookYourSlot"]</h1>
        </div>
    </header>

    @* ── Ineligible ──────────────────────────────────────── *@
    @if (!Model.IsEligible)
    {
        <div class="exam-ineligible" role="alert">
            <div class="exam-ineligible__icon" aria-hidden="true">
                <i class="fa-solid fa-lock"></i>
            </div>
            <div>
                <strong>@L["Exam_NotEligible"]</strong>
                <p class="mb-0">@Model.IneligibilityReason</p>
            </div>
        </div>

        <a asp-area="Trainee" asp-controller="Dashboard" asp-action="Index" class="btn-back">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
            @L["Exam_BackToDashboard"]
        </a>
    }

    @* ── No slots ────────────────────────────────────────── *@
    else if (!Model.AvailableSlots.Any())
    {
        <div class="exam-info-banner" role="status">
            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
            <span>@L["Exam_NoSlots"]</span>
        </div>

        <a asp-area="Trainee" asp-controller="Exam" asp-action="Index" class="btn-back">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
            @L["Exam_BackToAppointments"]
        </a>
    }

    @* ── Slot grid ───────────────────────────────────────── *@
    else
    {
        <div class="slot-grid">
            @foreach (var slot in Model.AvailableSlots)
            {
                var isLow = slot.SlotsRemaining <= 3;

                <article class="slot-card" aria-label="@slot.CenterName, @slot.ExamDate.ToString("dd MMMM yyyy")">
                    <div class="slot-card__body">
                        <h2 class="slot-card__center">@slot.CenterName</h2>

                        <p class="slot-card__city">
                            <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                            @slot.CityName
                        </p>

                        <div class="slot-card__details">
                            <div class="slot-card__detail">
                                <i class="fa-regular fa-calendar" aria-hidden="true"></i>
                                @slot.ExamDate.ToString("dd MMMM yyyy")
                            </div>
                            <div class="slot-card__detail">
                                <i class="fa-regular fa-clock" aria-hidden="true"></i>
                                @slot.ExamTime.ToString("HH:mm")
                            </div>
                        </div>

                        <span class="slots-chip @(isLow ? "slots-chip--low" : "slots-chip--ok")"
                              aria-label="@string.Format(L["Exam_SlotsRemainingAria"], slot.SlotsRemaining)">
                            <i class="fa-solid @(isLow ? "fa-fire" : "fa-circle-check")" aria-hidden="true"></i>
                            @string.Format(L["Exam_SlotsLeft"], slot.SlotsRemaining)
                        </span>
                    </div>

                    <div class="slot-card__footer">
                        <form asp-area="Trainee" asp-controller="Exam" asp-action="Book"
                              method="post" class="js-confirm"
                              data-confirm="@string.Format(L["Exam_ConfirmBookingMessage"], slot.ExamDate.ToString("dd MMM yyyy"), slot.ExamTime.ToString("HH:mm"))">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="OfficialExamId"    value="@slot.OfficialExamId" />
                            <input type="hidden" name="TraineeLicenseId"  value="@Model.TraineeLicenseId" />
                            <input type="hidden" name="ExamType"          value="@Model.ExamType" />
                            <button type="submit" class="btn-confirm">
                                <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
                                @L["Exam_ConfirmBooking"]
                            </button>
                        </form>
                    </div>
                </article>
            }
        </div>

        <a asp-area="Trainee" asp-controller="Exam" asp-action="Index" class="btn-back">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
            @L["Exam_BackToAppointments"]
        </a>
    }
</div>