@using Rokhsetak.Areas.Trainee.ViewModels.Exam;
@model ExamBookingViewModel
@{
    ViewData["Title"] = $"Book {Model.ExamType.ToUpper()} Exam";
    string icon = Model.ExamType switch { "theory" => "📋", "medical" => "🏥", _ => "🚗" };
}

<div class="container py-4">

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-area="Trainee" asp-controller="Exam" asp-action="Index">
                    Exam Appointments
                </a>
            </li>
            <li class="breadcrumb-item active">Book @Model.ExamType.ToUpper() Exam</li>
        </ol>
    </nav>

    <h3 class="fw-bold mb-4">@icon Book @Model.ExamType.ToUpper() Exam</h3>

    @if (!Model.IsEligible)
    {
        <div class="alert alert-warning d-flex align-items-center gap-3">
            <i class="bi bi-lock-fill fs-3"></i>
            <div>
                <strong>Not eligible</strong>
                <p class="mb-0">@Model.IneligibilityReason</p>
            </div>
        </div>
        <a asp-area="Trainee" asp-controller="Dashboard" asp-action="Index"
               class="btn btn-outline-primary mt-3">
            ← Back to Dashboard
        </a>
    }
    else if (!Model.AvailableSlots.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i>
            No exam slots are currently available in your area. Please check back later.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var slot in Model.AvailableSlots)
            {
                <div class="col-md-4">
                    <div class="card shadow-sm h-100 border-0">
                        <div class="card-body">
                            <h6 class="fw-bold mb-1">@slot.CenterName</h6>
                            <p class="text-muted small mb-2">
                                <i class="bi bi-geo-alt"></i> @slot.CityName
                            </p>
                            <p class="mb-1">
                                <i class="bi bi-calendar-date"></i>
                                @slot.ExamDate.ToString("dd MMMM yyyy")
                            </p>
                            <p class="mb-2">
                                <i class="bi bi-clock"></i> @slot.ExamTime.ToString("HH:mm")
                            </p>
                            <span class="badge @(slot.SlotsRemaining <= 3 ? "bg-warning text-dark" : "bg-success")">
                                @slot.SlotsRemaining slot(s) left
                            </span>
                        </div>
                        <div class="card-footer bg-transparent">
                            <form asp-area="Trainee" asp-controller="Exam"
                                  asp-action="Book" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="OfficialExamId" value="@slot.OfficialExamId" />
                                <input type="hidden" name="TraineeLicenseId" value="@Model.TraineeLicenseId" />
                                <input type="hidden" name="ExamType" value="@Model.ExamType" />
                                <button type="submit" class="btn btn-primary w-100"
                                        onclick="return confirm('Confirm booking for @slot.ExamDate.ToString("dd MMM yyyy") at @slot.ExamTime.ToString("HH:mm")?')">
                                    <i class="bi bi-check-circle"></i> Confirm Booking
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>