@model Rokhsetak.Areas.Trainee.ViewModels.Modules.ModuleCardViewModel
@using Rokhsetak.Resources
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResourceMarker> L

@{
    // Resolve a single status key (locked overrides Status)
    var statusKey = Model.IsLocked ? "locked" : Model.Status;

    var (cardModifier, statusIcon, statusLabel) = statusKey switch
    {
        "completed"   => ("completed",   "fa-circle-check",     L["Status_Completed"]),
        "in_progress" => ("in-progress", "fa-circle-play",      L["Status_InProgress"]),
        "locked"      => ("locked",      "fa-lock",             ""),
        _             => ("not-started", "",                    L["Status_NotStarted"])
    };

    var (phaseIcon, phaseLabel) = Model.Phase == "theoretical"
        ? ("fa-book",    L["Module_Theory"])
        : ("fa-car-side", L["Module_Practical"]);

    string ctaLabel = Model.Status == "not_started"
        ? L["Module_Start"].Value
        : Model.Status == "in_progress"
            ? L["Module_Continue"].Value
            : L["Module_Review"].Value;

    string ctaIcon = Model.Status == "not_started"
        ? "fa-play"
        : Model.Status == "in_progress"
            ? "fa-forward"
            : "fa-rotate-right";
}

<article class="module-card module-card--@cardModifier">
    <span class="module-card__accent" aria-hidden="true"></span>

    <div class="module-card__body">
        <header class="module-card__head">
            <h3 class="module-card__title">@Model.Title</h3>

            @if (Model.IsLocked)
            {
                <span class="module-card__corner-icon module-card__corner-icon--locked"
                      title="@L["Module_LockedTooltip"]"
                      aria-label="@L["Module_LockedTooltip"]">
                    <i class="fa-solid fa-lock" aria-hidden="true"></i>
                </span>
            }
            else if (Model.Status == "completed")
            {
                <span class="module-card__corner-icon module-card__corner-icon--completed"
                      title="@L["Module_CompletedTooltip"]"
                      aria-label="@L["Module_CompletedTooltip"]">
                    <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
                </span>
            }
        </header>

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="module-card__description">@Model.Description</p>
        }

        <div class="module-card__badges">
            <span class="chip chip--ghost">
                <i class="fa-solid @phaseIcon" aria-hidden="true"></i>
                @phaseLabel
            </span>

            <span class="status-pill status-pill--@cardModifier">
                @if (!string.IsNullOrEmpty(statusIcon))
                {
                    <i class="fa-solid @statusIcon" aria-hidden="true"></i>
                }
                @(string.IsNullOrEmpty(statusLabel) ? L["Module_Locked"].Value : statusLabel)
            </span>

            @if (Model.HasQuiz)
            {
                <span class="quiz-badge @(Model.QuizPassed ? "quiz-badge--passed" : "quiz-badge--pending")">
                    <i class="fa-solid @(Model.QuizPassed ? "fa-award" : "fa-pen-to-square")" aria-hidden="true"></i>
                    <span class="quiz-badge__label">@L["Quiz_Label"]</span>
                    <span class="quiz-badge__verdict">
                        @(Model.QuizPassed ? L["Quiz_PassedShort"] : L["Quiz_NotPassedShort"])
                    </span>
                </span>
            }
        </div>
    </div>

    <footer class="module-card__footer">
        @if (Model.IsLocked)
        {
            <button type="button" class="btn-action btn-action--locked btn-action--block" disabled aria-disabled="true">
                <i class="fa-solid fa-lock" aria-hidden="true"></i>
                <span>@L["Module_Locked"]</span>
            </button>
        }
        else
        {
            <a asp-area="Trainee"
               asp-controller="Modules"
               asp-action="Detail"
               asp-route-id="@Model.ModuleId"
               class="btn-action @(Model.Status == "completed" ? "btn-action--ghost-success" : Model.Status == "in_progress" ? "btn-action--outline" : "btn-action--gradient") btn-action--block">
                <i class="fa-solid @ctaIcon" aria-hidden="true"></i>
                <span>@ctaLabel</span>
            </a>
        }
    </footer>
</article>
