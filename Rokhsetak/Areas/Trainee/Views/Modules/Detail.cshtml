@using Rokhsetak.Areas.Trainee.ViewModels.Modules
@using Rokhsetak.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResourceMarker> L
@model ModuleDetailViewModel
@{
    ViewData["Title"] = Model.Title;

    var (phaseIcon, phaseLabel) = Model.Phase == "theoretical"
        ? ("fa-book", L["Module_Theory"])
        : ("fa-car-side", L["Module_Practical"]);

    var (statusModifier, statusLabel) = Model.Status switch
    {
        "completed"   => ("completed",   L["Status_Completed"]),
        "in_progress" => ("in-progress", L["Status_InProgress"]),
        _             => ("not-started", L["Status_NotStarted"])
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/modules.css" />
}

<div class="module-detail">
    <div class="module-detail__inner">

        @if (TempData["Error"] != null)
        {
            <div class="alert dashboard-alert dashboard-alert--error" role="alert">
                <i class="fa-solid fa-triangle-exclamation dashboard-alert__icon" aria-hidden="true"></i>
                <span class="dashboard-alert__message">@TempData["Error"]</span>
                <button type="button"
                        class="dashboard-alert__close"
                        data-bs-dismiss="alert"
                        aria-label="@L["Alert_Close"]">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert dashboard-alert dashboard-alert--success" role="alert">
                <i class="fa-solid fa-circle-check dashboard-alert__icon" aria-hidden="true"></i>
                <span class="dashboard-alert__message">@TempData["Success"]</span>
                <button type="button"
                        class="dashboard-alert__close"
                        data-bs-dismiss="alert"
                        aria-label="@L["Alert_Close"]">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
        }

        <!-- ============ Breadcrumb ============ -->
        <nav class="module-breadcrumb" aria-label="@L["Modules_Breadcrumb"]">
            <ol class="module-breadcrumb__list">
                <li class="module-breadcrumb__item">
                    <a asp-area="Trainee" asp-controller="Modules" asp-action="Index"
                       class="module-breadcrumb__link">
                        <i class="fa-solid fa-folder" aria-hidden="true"></i>
                        <span>@L["Modules_Title"]</span>
                    </a>
                </li>
                <li class="module-breadcrumb__sep" aria-hidden="true">
                    <i class="fa-solid fa-chevron-right"></i>
                </li>
                <li class="module-breadcrumb__item module-breadcrumb__item--active" aria-current="page">
                    @Model.Title
                </li>
            </ol>
        </nav>

        <!-- ============ Module Hero ============ -->
        <section class="module-hero module-hero--@statusModifier" aria-labelledby="module-title">
            <div class="module-hero__main">
                <div class="module-hero__intro">
                    <p class="module-hero__eyebrow">
                        <i class="fa-solid @phaseIcon" aria-hidden="true"></i>
                        @phaseLabel
                    </p>
                    <h1 id="module-title" class="module-hero__title">@Model.Title</h1>
                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p class="module-hero__description">@Model.Description</p>
                    }
                </div>

                <div class="module-hero__meta">
                    <span class="chip chip--soft">
                        <i class="fa-solid @phaseIcon" aria-hidden="true"></i>
                        @phaseLabel
                    </span>
                    <span class="status-pill status-pill--@statusModifier">@statusLabel</span>
                </div>
            </div>
        </section>

        <!-- ============ Content Blocks ============ -->
        @if (Model.Contents.Any())
        {
            <div class="module-content">
                @foreach (var content in Model.Contents)
                {
                    if (content.ContentType == "video" && !string.IsNullOrWhiteSpace(content.VideoUrl))
                    {
                        <article class="content-block content-block--video">
                            <header class="content-block__header">
                                <span class="content-block__icon" aria-hidden="true">
                                    <i class="fa-solid fa-circle-play"></i>
                                </span>
                                <h2 class="content-block__title">@L["Module_VideoLesson"]</h2>
                            </header>
                            <div class="content-block__body content-block__body--media">
                                <div class="content-block__video">
                                    <iframe src="@content.VideoUrl"
                                            allowfullscreen
                                            loading="lazy"
                                            title="@L["Module_VideoTitle"]"></iframe>
                                </div>
                            </div>
                        </article>
                    }
                    else if (content.ContentType == "text" && !string.IsNullOrWhiteSpace(content.TextContent))
                    {
                        <article class="content-block content-block--text">
                            <header class="content-block__header">
                                <span class="content-block__icon" aria-hidden="true">
                                    <i class="fa-solid fa-book-open"></i>
                                </span>
                                <h2 class="content-block__title">@L["Module_ReadingMaterial"]</h2>
                            </header>
                            <div class="content-block__body">
                                <div class="content-block__prose">
                                    @Html.Raw(content.TextContent)
                                </div>
                            </div>
                        </article>
                    }
                }
            </div>
        }
        else
        {
            <div class="module-content-empty">
                <i class="fa-regular fa-file" aria-hidden="true"></i>
                <p>@L["Module_NoContent"]</p>
            </div>
        }

        <!-- ============ Action Bar ============ -->
        <section class="module-actions" aria-label="@L["Module_ActionsAria"]">
            <div class="module-actions__primary">
                @if (Model.HasQuiz && Model.Status != "not_started")
                {
                    <a asp-area="Trainee"
                       asp-controller="Quiz"
                       asp-action="Take"
                       asp-route-moduleId="@Model.ModuleId"
                       class="btn-action @(Model.QuizPassed ? "btn-action--ghost-success" : "btn-action--gradient")">
                        <i class="fa-solid @(Model.QuizPassed ? "fa-rotate-right" : "fa-pen-to-square")" aria-hidden="true"></i>
                        <span>@(Model.QuizPassed ? L["Quiz_RetakeQuiz"] : L["Quiz_TakeQuiz"])</span>
                    </a>

                    @if (Model.LastAttemptScore.HasValue)
                    {
                        <div class="quiz-score @(Model.QuizPassed ? "quiz-score--passed" : "quiz-score--failed")">
                            <span class="quiz-score__label">@L["Module_LastScore"]</span>
                            <span class="quiz-score__value">@Model.LastAttemptScore<small>%</small></span>
                            <span class="quiz-score__verdict">
                                <i class="fa-solid @(Model.QuizPassed ? "fa-circle-check" : "fa-circle-xmark")" aria-hidden="true"></i>
                                @(Model.QuizPassed ? L["Module_Passed"] : L["Module_NotPassed"])
                            </span>
                        </div>
                    }
                }
                else if (Model.CanCompleteDirectly)
                {
                    <form asp-area="Trainee"
                          asp-controller="Modules"
                          asp-action="Complete"
                          method="post"
                          class="module-actions__form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="moduleId" value="@Model.ModuleId" />
                        <input type="hidden" name="traineeLicenseId" value="@Model.TraineeLicenseId" />
                        <button type="submit" class="btn-action btn-action--success">
                            <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
                            <span>@L["Modules_Complete"]</span>
                        </button>
                    </form>
                }
                else if (Model.Status == "not_started")
                {
                    <p class="module-actions__hint">
                        <i class="fa-regular fa-circle-play" aria-hidden="true"></i>
                        <span>@L["Module_AutoStartHint"]</span>
                    </p>
                }
            </div>

            <a asp-area="Trainee"
               asp-controller="Modules"
               asp-action="Index"
               class="btn-action btn-action--ghost">
                <i class="fa-solid fa-arrow-left-long" aria-hidden="true"></i>
                <span>@L["Module_BackToModules"]</span>
            </a>
        </section>

    </div>
</div>