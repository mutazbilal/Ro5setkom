@using Rokhsetak.Areas.Trainee.ViewModels.Booking
@model MentorBrowseListViewModel

@{
    ViewData["Title"] = "Find a Mentor";
}

@section Styles {
    <link rel="stylesheet" href="~/css/booking-shared.css" />
}
@if (TempData["Error"] != null)
{
<div class="alert alert--error" role="alert">
    <i class="fa-solid fa-circle-exclamation alert__icon" aria-hidden="true"></i>
    <div class="alert__body">@TempData["Error"]</div>
    <button type="button" class="alert__close" data-alert-dismiss aria-label="Dismiss">
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
    </button>
</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert--success" role="status">
        <i class="fa-solid fa-circle-check alert__icon" aria-hidden="true"></i>
        <div class="alert__body">@TempData["Success"]</div>
        <button type="button" class="alert__close" data-alert-dismiss aria-label="Dismiss">
            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </button>
    </div>

    <div class="booking-header">
        <h2 class="booking-header__title">My Bookings</h2>
        <a asp-area="Trainee" asp-controller="Booking" asp-action="Browse"
           class="btn btn--primary">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            Find a Mentor
        </a>
    </div>
}
<div class="booking-page">
    <div class="booking-page__inner">

        <div class="booking-header">
            <h2 class="booking-header__title">Find a Mentor</h2>
            <a asp-area="Trainee"
               asp-controller="Booking"
               asp-action="Index"
               class="btn btn--secondary btn--sm">
                <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
                My Bookings
            </a>
        </div>

        <!-- Filter bar -->
        <form asp-area="Trainee"
              asp-controller="Booking"
              asp-action="Browse"
              method="get"
              class="filter-bar">

            <div class="filter-bar__grid">

                <div class="form-field">
                    <label asp-for="Filter.City" class="form-field__label form-field__label--small">City</label>
                    <select asp-for="Filter.City"
                            class="form-field__select form-field__select--sm">
                        <option value="">All cities</option>
                        @foreach (var c in Model.Filter.AvailableCities)
                        {
                            <option value="@c">@c</option>
                        }
                    </select>
                </div>

                <div class="form-field">
                    <label asp-for="Filter.MinPrice" class="form-field__label form-field__label--small">Min Price (JD)</label>
                    <input asp-for="Filter.MinPrice"
                           type="number"
                           min="0"
                           step="0.5"
                           class="form-field__input form-field__input--sm" />
                </div>

                <div class="form-field">
                    <label asp-for="Filter.MaxPrice" class="form-field__label form-field__label--small">Max Price (JD)</label>
                    <input asp-for="Filter.MaxPrice"
                           type="number"
                           min="0"
                           step="0.5"
                           class="form-field__input form-field__input--sm" />
                </div>

                <div class="form-field">
                    <label asp-for="Filter.MinRating" class="form-field__label form-field__label--small">Min Rating</label>
                    <select asp-for="Filter.MinRating"
                            class="form-field__select form-field__select--sm">
                        <option value="">Any</option>
                        @foreach (var r in new[] { 3.0, 3.5, 4.0, 4.5 })
                        {
                            <option value="@r">@r ★ and up</option>
                        }
                    </select>
                </div>

                <div class="filter-bar__actions">
                    <button type="submit" class="btn btn--primary btn--sm btn--block">
                        <i class="fa-solid fa-filter"></i>
                        Filter
                    </button>

                    <a asp-area="Trainee"
                       asp-controller="Booking"
                       asp-action="Browse"
                       class="btn btn--secondary btn--sm">
                        Clear
                    </a>
                </div>

            </div>
        </form>

        <!-- Results -->
        @if (!Model.Mentors.Any())
        {
            <div class="empty-state">
                <i class="fa-solid fa-user-slash empty-state__icon"></i>
                <p class="empty-state__text">No mentors found for your filters.</p>
                <a asp-area="Trainee"
                   asp-controller="Booking"
                   asp-action="Browse"
                   class="btn btn--secondary btn--sm">
                    Clear filters
                </a>
            </div>
        }
        else
        {
            <div class="mentor-grid">

                @foreach (var m in Model.Mentors)
                {
                    <article class="mentor-card">

                        <div class="mentor-card__body">

                            <div class="mentor-card__top">
                                <h3 class="mentor-card__name">@m.FullName</h3>
                                <span class="tag">@m.LicenseType.Replace("_", " ")</span>
                            </div>

                            <p class="mentor-card__city">
                                <i class="fa-solid fa-location-dot"></i>
                                @m.City
                            </p>

                            <div class="mentor-card__stats">

                                <div class="mentor-card__stat">
                                    <div class="mentor-card__stat-value">
                                        @m.AverageRating.ToString("0.0") ★
                                    </div>
                                    <div class="mentor-card__stat-label">
                                        @m.TotalRatings ratings
                                    </div>
                                </div>

                                <div class="mentor-card__stat">
                                    <div class="mentor-card__stat-value">
                                        @m.CompletionRate%
                                    </div>
                                    <div class="mentor-card__stat-label">
                                        Completion
                                    </div>
                                </div>

                                <div class="mentor-card__stat">
                                    <div class="mentor-card__stat-value">
                                        @m.PricePerSession JD
                                    </div>
                                    <div class="mentor-card__stat-label">
                                        Per session
                                    </div>
                                </div>

                            </div>

                        </div>

                        <div class="card-footer bg-transparent">

                            @if (Model.ActiveMentorId.HasValue &&
                                 Model.ActiveMentorId != m.MentorId)
                            {
                                <button type="button"
                                        class="btn btn-warning w-100 mentor-switch-btn"
                                        data-book-url="@Url.Action("Book", "Booking", new { area = "Trainee", mentorId = m.MentorId })"
                                        data-mentor-name="@m.FullName">
                                    <i class="bi bi-exclamation-triangle"></i>
                                    Book a Session
                                </button>
                            }
                            else
                            {
                                <a asp-area="Trainee"
                                   asp-controller="Booking"
                                   asp-action="Book"
                                   asp-route-mentorId="@m.MentorId"
                                   class="btn btn-primary w-100">
                                    <i class="bi bi-calendar-plus"></i>
                                    Book a Session
                                </a>
                            }

                        </div>

                    </article>
                }

            </div>

            <p class="text-muted small mt-3">
                @Model.Mentors.Count mentor(s) found.
            </p>
        }

    </div>
</div>

<!-- Mentor Switch Modal -->
<div class="modal fade" id="mentorSwitchModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">

            <div class="modal-header">
                <h5 class="modal-title text-warning">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    Change Primary Mentor?
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <p>You are about to book a session with a new mentor.</p>

                <ul>
                    <li>All future bookings with your current mentor will be cancelled.</li>
                    <li>If approved, the new mentor becomes your primary mentor.</li>
                    <li>Future bookings will use the new mentor automatically.</li>
                </ul>

                <p class="fw-semibold mb-0">
                    Are you sure you want to continue?
                </p>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <a id="confirmMentorSwitchBtn"
                   href="#"
                   class="btn btn-warning">
                    Yes, Continue
                </a>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const modal = new bootstrap.Modal(document.getElementById('mentorSwitchModal'));
            const confirmBtn = document.getElementById('confirmMentorSwitchBtn');

            document.querySelectorAll('.mentor-switch-btn').forEach(btn => {
                btn.addEventListener('click', function () {

                    const bookUrl = this.dataset.bookUrl;
                    confirmBtn.href = bookUrl;

                    modal.show();
                });
            });

        });
    </script>
}