@using Rokhsetak.Areas.Trainee.ViewModels.Booking
@using Rokhsetak.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResourceMarker> L
@model MentorBrowseListViewModel
@{
    ViewData["Title"] = L["Booking_FindMentor"];
    <script>
        const bookingMsgTemplate = '@Html.Raw(L["Booking_ChangePrimaryMsg"].Value)';
    </script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/booking-shared.css" asp-append-version="true"/>
}

<div class="booking-page">
    <div class="booking-page__inner">

        @if (TempData["Error"] != null)
        {
            <div class="alert alert--error" role="alert">
                <i class="fa-solid fa-circle-exclamation alert__icon" aria-hidden="true"></i>
                <div class="alert__body">@TempData["Error"]</div>
                <button type="button" class="alert__close" data-alert-dismiss aria-label="@L["Booking_Dismiss"]">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert--success" role="status">
                <i class="fa-solid fa-circle-check alert__icon" aria-hidden="true"></i>
                <div class="alert__body">@TempData["Success"]</div>
                <button type="button" class="alert__close" data-alert-dismiss aria-label="@L["Booking_Dismiss"]">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
        }

        <nav class="breadcrumb" aria-label="@L["Booking_Breadcrumb"]">
            <a asp-area="Trainee" asp-controller="Booking" asp-action="Index"
               class="breadcrumb__item">@L["Booking_MyBookings"]</a>
            <span class="breadcrumb__sep" aria-hidden="true">
                <i class="fa-solid fa-chevron-right"></i>
            </span>
            <span class="breadcrumb__item breadcrumb__item--active" aria-current="page">@L["Booking_FindMentor"]</span>
        </nav>

        <div class="booking-header">
            <h2 class="booking-header__title">@L["Booking_FindYourMentor"]</h2>
            <a asp-area="Trainee" asp-controller="Booking" asp-action="Index"
               class="btn btn--secondary btn--sm">
                <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
                @L["Booking_MyBookings"]
            </a>
        </div>

        <!-- Filter bar -->
        <form asp-area="Trainee"
              asp-controller="Booking"
              asp-action="Browse"
              method="get"
              class="filter-bar">

            <div class="filter-bar__grid">

                <div class="form-field">
                    <label asp-for="@Model.Filter.CityId" class="form-field__label form-field__label--small">@L["Booking_City"]</label>
                    <select asp-for="@Model.Filter.CityId"
                            class="form-field__select form-field__select--sm">
                        <option value="">@L["Booking_AllCities"]</option>
                        @foreach (var c in Model.Cities)
                        {
                            <option value="@c.CityId">@c.DisplayName</option>
                        }
                    </select>
                </div>

                <div class="form-field">
                    <label asp-for="Filter.MinPrice" class="form-field__label form-field__label--small">@L["Booking_MinPrice"]</label>
                    <input asp-for="Filter.MinPrice"
                           type="number"
                           min="0"
                           step="0.5"
                           placeholder="0"
                           class="form-field__input form-field__input--sm" />
                </div>

                <div class="form-field">
                    <label asp-for="Filter.MaxPrice" class="form-field__label form-field__label--small">@L["Booking_MaxPrice"]</label>
                    <input asp-for="Filter.MaxPrice"
                           type="number"
                           min="0"
                           step="0.5"
                           placeholder="∞"
                           class="form-field__input form-field__input--sm" />
                </div>

                <div class="form-field">
                    <label asp-for="Filter.MinRating" class="form-field__label form-field__label--small">@L["Booking_MinRating"]</label>
                    <select asp-for="Filter.MinRating"
                            class="form-field__select form-field__select--sm">
                        <option value="">@L["Booking_AnyRating"]</option>
                        @foreach (var r in new[] { 3.0, 3.5, 4.0, 4.5 })
                        {
                            <option value="@r">@r ★ @L["Booking_AndUp"]</option>
                        }
                    </select>
                </div>

                <div class="filter-bar__actions">
                    <button type="submit" class="btn btn--warning btn--sm btn--block">
                        <i class="fa-solid fa-filter" aria-hidden="true"></i>
                        @L["Booking_FilterButton"]
                    </button>

                    <a asp-area="Trainee"
                       asp-controller="Booking"
                       asp-action="Browse"
                       class="btn btn--secondary btn--sm">
                        @L["Booking_ClearFilter"]
                    </a>
                </div>

            </div>
        </form>

        <!-- Results -->
        @if (!Model.Mentors.Any())
        {
            <div class="empty-state">
                <i class="fa-solid fa-user-slash empty-state__icon" aria-hidden="true"></i>
                <p class="empty-state__text">@L["Booking_NoMentors"]</p>
                <a asp-area="Trainee"
                   asp-controller="Booking"
                   asp-action="Browse"
                   class="btn btn--secondary btn--sm">
                    @L["Booking_ClearFilters"]
                </a>
            </div>
        }
        else
        {
            <p class="result-count" style="margin-bottom: 16px;">
                <strong style="color: var(--color-primary);">@Model.Mentors.Count</strong>
                @L["Booking_MentorsAvailable"]
            </p>

            <div class="mentor-grid">

                @foreach (var m in Model.Mentors)
                {
                    var initials = string.IsNullOrWhiteSpace(m.FullName)
                        ? "?"
                        : string.Concat(m.FullName
                            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                            .Take(2)
                            .Select(p => char.ToUpper(p[0])));

                    <article class="mentor-card">

                        <div class="mentor-card__body">

                            <div class="mentor-card__head">
                                <div class="mentor-card__avatar" aria-hidden="true">@initials</div>
                                <div class="mentor-card__top">
                                    <h3 class="mentor-card__name">@m.FullName</h3>
                                    <span class="tag">@m.LicenseType.Replace("_", " ")</span>
                                </div>
                            </div>

                            <p class="mentor-card__city">
                                <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                                @m.CityName
                            </p>

                            <div class="mentor-card__stats">

                                <div class="mentor-card__stat">
                                    <div class="mentor-card__stat-value mentor-card__stat-value--rating">
                                        @m.AverageRating.ToString("0.0") ★
                                    </div>
                                    <div class="mentor-card__stat-label">
                                        @string.Format(L["Booking_RatingsCount"], m.TotalRatings)
                                    </div>
                                </div>

                                <div class="mentor-card__stat">
                                    <div class="mentor-card__stat-value mentor-card__stat-value--price">
                                        @m.PricePerSession JD
                                    </div>
                                    <div class="mentor-card__stat-label">
                                        @L["Booking_PerSession"]
                                    </div>
                                </div>

                            </div>

                        </div>

                        <div class="mentor-card__footer">

                            @if (Model.ActiveMentorId.HasValue &&
                                 Model.ActiveMentorId != m.MentorId)
                            {
                                <button type="button"
                                        class="btn btn--warning btn--sm btn--block mentor-switch-btn"
                                        data-book-url="@Url.Action("Book", "Booking", new { area = "Trainee", mentorId = m.MentorId })"
                                        data-mentor-name="@m.FullName">
                                    <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                                    @L["Booking_BookSession"]
                                </button>
                            }
                            else
                            {
                                <a asp-area="Trainee"
                                   asp-controller="Booking"
                                   asp-action="Book"
                                   asp-route-mentorId="@m.MentorId"
                                   class="btn btn--warning btn--sm btn--block">
                                    <i class="fa-solid fa-calendar-plus" aria-hidden="true"></i>
                                    @L["Booking_BookSession"]
                                </a>
                            }

                            <button type="button"
                                    class="btn btn--secondary btn--sm btn--block rk-message-mentor"
                                    data-mentor-id="@m.MentorId"
                                    data-message-url="@Url.Action("Message", "Booking", new { area = "Trainee" })">
                                <i class="fa-solid fa-comment" aria-hidden="true"></i>
                                Message
                            </button>

                        </div>

                    </article>
                }

            </div>
        }

    </div>
</div>

<!-- Mentor Switch Modal -->
<div id="mentorSwitchModal"
     style="display: none; position: fixed; inset: 0; z-index: 9999;
            background: rgba(17, 40, 73, 0.55); backdrop-filter: blur(4px);
            align-items: center; justify-content: center; padding: 20px;">

    <div class="booking-card" style="max-width: 500px; width: 100%; animation: card-in 0.25s ease-out;">

        <div class="booking-card__header booking-card__header--warning">
            <span class="booking-card__header-icon">
                <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
            </span>
            @L["Booking_ChangePrimaryMentor"]
        </div>

        <div class="booking-card__body">

            <p style="margin: 0 0 12px;">
                <strong id="newMentorName" style="color: var(--color-primary);"></strong>
            </p>

            <ul style="padding-inline-start: 22px; color: var(--color-text-muted); font-size: 0.9rem; line-height: 1.6; margin: 0 0 14px;">
                <li>@L["Booking_ChangePrimaryConsequences_1"]</li>
                <li>@L["Booking_ChangePrimaryConsequences_2"]</li>
                <li>@L["Booking_ChangePrimaryConsequences_3"]</li>
            </ul>

            <p style="font-weight: 600; margin: 0 0 18px;">
                @L["Booking_ConfirmSwitchQuestion"]
            </p>

            <div class="form-actions">
                <button type="button" class="btn btn--secondary" id="cancelSwitchBtn">@L["Booking_CancelSwitch"]</button>
                <a id="confirmMentorSwitchBtn" href="#" class="btn btn--warning">
                    <i class="fa-solid fa-check" aria-hidden="true"></i>
                    @L["Booking_ConfirmSwitch"]
                </a>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
    (function () {
        'use strict';

        // Dismissable alerts
        document.querySelectorAll('[data-alert-dismiss]').forEach(btn => {
            btn.addEventListener('click', function () {
                const alert = this.closest('.alert');
                if (alert) alert.style.display = 'none';
            });
        });

        // Mentor switch modal
        const modal = document.getElementById('mentorSwitchModal');
        const confirmBtn = document.getElementById('confirmMentorSwitchBtn');
        const newMentorName = document.getElementById('newMentorName');

        function openModal() { modal.style.display = 'flex'; }
        function closeModal() { modal.style.display = 'none'; }

        document.querySelectorAll('.mentor-switch-btn').forEach(btn => {
            btn.addEventListener('click', function () {

                const mentorName = this.dataset.mentorName;

                confirmBtn.href = this.dataset.bookUrl;

                newMentorName.textContent =
                    bookingMsgTemplate.replace('{0}', mentorName);

                openModal();
            });
        });

        document.getElementById('cancelSwitchBtn')?.addEventListener('click', closeModal);
        modal?.addEventListener('click', function (e) {
            if (e.target === modal) closeModal();
        });
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeModal();
        });

        document.querySelectorAll('.rk-message-mentor').forEach(btn => {
            btn.addEventListener('click', () => {
                if (window.RkChat) {
                    window.RkChat.startWithMentor(parseInt(btn.dataset.mentorId, 10), btn.dataset.messageUrl);
                }
            });
        });
    })();
    </script>
}