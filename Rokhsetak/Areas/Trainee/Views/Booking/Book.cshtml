@using Rokhsetak.Areas.Trainee.ViewModels.Booking;
@model MentorBookingViewModel
@{
    ViewData["Title"] = $"Book with {Model.MentorName}";
}

<div class="container py-4" style="max-width: 680px;">

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Mentor profile -->
    <div class="card shadow-sm mb-4">
        <div class="card-body d-flex justify-content-between flex-wrap gap-3">
            <div>
                <h4 class="fw-bold mb-1">@Model.MentorName</h4>
                <p class="text-muted mb-1"><i class="bi bi-geo-alt"></i> @Model.City</p>
                <span class="badge bg-light text-dark border me-2">
                    @Model.LicenseType.Replace("_", " ")
                </span>
                <span class="text-warning fw-semibold">
                    @Model.AverageRating.ToString("0.0") ★
                    <span class="text-muted fw-normal small">(@Model.TotalRatings)</span>
                </span>
            </div>
            <div class="text-end">
                <div class="fs-4 fw-bold text-primary">@Model.PricePerSession JD</div>
                <div class="text-muted small">per session</div>
                <div class="text-success small">@Model.CompletionRate% completion rate</div>
            </div>
        </div>
    </div>

    <!-- Availability -->
    <div class="card shadow-sm mb-4">
        <div class="card-header fw-semibold">
            <i class="bi bi-clock text-success"></i> Available Slots
        </div>
        <div class="card-body">
            @if (Model.AvailableDays.Any())
            {
                <div class="row g-2">
                    @foreach (var day in Model.AvailableDays)
                    {
                        <div class="col-md-4 mb-2">
                            <div class="fw-semibold text-capitalize mb-1">@day.DayOfWeek</div>
                            @foreach (var slot in day.Slots)
                            {
                                <span class="badge bg-light text-dark border me-1 mb-1">
                                    @slot.StartTime.ToString("HH:mm") – @slot.EndTime.ToString("HH:mm")
                                </span>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted">No availability slots set by this mentor yet.</p>
            }
        </div>
    </div>

    <!-- Booking form -->
    <div class="card shadow-sm">
        <div class="card-header fw-semibold">
            <i class="bi bi-calendar-plus text-primary"></i> Book a Session
        </div>
        <div class="card-body">
            <form asp-area="Trainee" asp-controller="Booking" asp-action="Book" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="MentorId" value="@Model.MentorId" />
                <input type="hidden" name="TraineeLicenseId" value="@Model.TraineeLicenseId" />
                <input type="hidden" name="LicenseTypeId" value="@Model.LicenseTypeId" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Session Type</label>
                    <select name="SessionType" class="form-select" required>
                        <option value="">— Select —</option>
                        <option value="theoretical">📘 Theoretical</option>
                        <option value="practical">🚗 Practical</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Date</label>
                    <input type="date" name="BookingDate" class="form-control" required
                           min="@DateOnly.FromDateTime(DateTime.UtcNow.AddDays(1)).ToString("yyyy-MM-dd")" />
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-6">
                        <label class="form-label fw-semibold">Start Time</label>
                        <input type="time" name="StartTime" class="form-control" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-semibold">End Time</label>
                        <input type="time" name="EndTime" class="form-control" required />
                    </div>
                </div>

                <div class="alert alert-light border small mb-4">
                    <i class="bi bi-info-circle"></i>
                    Select a time within the mentor's available slots above.
                    The booking will be <strong>pending</strong> until the mentor confirms it.
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-area="Trainee" asp-controller="Booking" asp-action="Browse"
                       class="btn btn-outline-secondary">← Back</a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-calendar-check"></i> Request Booking
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}