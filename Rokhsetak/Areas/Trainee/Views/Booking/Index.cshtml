@using Rokhsetak.Areas.Trainee.ViewModels.Booking

@model TraineeBookingListViewModel
@{
    ViewData["Title"] = "My Bookings";
}

<div class="container py-4">
    
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h2 class="fw-bold mb-0">My Bookings</h2>
        <h2 class="fw-bold mb-0">Cuurent Mentor: @Model.PrimaryMentorName</h2>
        <a asp-area="Trainee" asp-controller="Booking" asp-action="Book" method="get" asp-route-mentorId=@Model.PrimaryMentorId
               class="btn btn-primary">
            <i class="bi bi-search"></i> Book a session
        </a>
    </div>

    @if (!Model.Bookings.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-calendar-x fs-1 d-block mb-2"></i>
            You have no bookings yet.
            <br />
            <a asp-area="Trainee" asp-controller="Booking" asp-action="Browse"
               class="btn btn-outline-primary mt-3">Browse Mentors</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Mentor</th>
                        <th>Date &amp; Time</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.Bookings)
                    {
                        var rowClass = b.Status switch
                        {
                            "pending" => "table-warning",
                            "confirmed" => "table-light",
                            "completed" => "table-success",
                            "cancelled" => "table-secondary",
                            _ => ""
                        };
                        <tr class="@rowClass">
                            <td class="fw-semibold">@b.MentorName</td>
                            <td>
                                <div class="fw-semibold">@b.BookingDate.ToString("dd MMM yyyy")</div>
                                <div class="text-muted small">
                                    @b.StartTime.ToString("HH:mm") – @b.EndTime.ToString("HH:mm")
                                </div>
                            </td>
                            <td>
                                <span class="badge @(b.SessionType == "practical" ? "bg-warning text-dark" : "bg-info text-dark")">
                                    @b.SessionType
                                </span>
                            </td>
                            <td>
                                @{
                                    var (sc, sl) = b.Status switch
                                    {
                                        "pending" => ("bg-warning text-dark", "Pending"),
                                        "confirmed" => ("bg-primary", "Confirmed"),
                                        "completed" => ("bg-success", "Completed"),
                                        "cancelled" => ("bg-secondary", "Cancelled"),
                                        _ => ("bg-light text-dark", b.Status)
                                    };
                                }
                                <span class="badge @sc">@sl</span>
                            </td>
                            <td>
                                <div class="d-flex gap-1 flex-wrap">
                                    @if (b.CanReschedule)
                                    {
                                        <a asp-area="Trainee" asp-controller="Booking"
                                               asp-action="Reschedule" asp-route-bookingId="@b.BookingId"
                                               class="btn btn-outline-secondary btn-sm">
                                            <i class="bi bi-arrow-repeat"></i> Reschedule
                                        </a>
                                    }
                                    @if (b.CanCancel)
                                    {
                                        <form asp-area="Trainee" asp-controller="Booking"
                                              asp-action="Cancel" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="bookingId" value="@b.BookingId" />
                                            <button class="btn btn-outline-danger btn-sm"
                                                    onclick="return confirm('Cancel this session?')">
                                                <i class="bi bi-x-circle"></i> Cancel
                                            </button>
                                        </form>
                                    }
                                    @if (b.CanSeeFeedback)
                                    {
                                        <button type="button"
                                                class="btn btn-outline-primary btn-sm feedback-btn"
                                                data-feedback="@b.Feedback"
                                                data-mentor="@b.MentorName">
                                            <i class="bi bi-chat-left-text"></i> See Feedback
                                        </button>
                                    }
                                    @if (b.CanRate)
                                    {
                                        <button type="button"
                                                class="btn btn-outline-warning btn-sm rate-btn"
                                                data-booking-id="@b.BookingId"
                                                data-mentor="@b.MentorName">
                                            <i class="bi bi-star"></i> Rate Session
                                        </button>
                                    }
                                    @if (!b.CanCancel
                                        && !b.CanReschedule
                                        && !b.CanRate
                                        && !b.CanSeeFeedback)
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
<div class="modal fade" id="feedbackModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    Mentor Feedback
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                <h6 id="feedbackMentorName"></h6>

                <div class="border rounded p-3 bg-light"
                     id="feedbackText">
                </div>

            </div>

        </div>
    </div>
</div>
<div class="modal fade" id="ratingModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <form asp-area="Trainee"
                  asp-controller="Booking"
                  asp-action="Rate"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title">
                        Rate Session
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>
                </div>

                <div class="modal-body">

                    <input type="hidden"
                           id="ratingBookingId"
                           name="BookingId" />

                    <h6 id="ratingMentorName"></h6>

                    <div class="mb-3">
                        <label class="form-label">
                            Rating
                        </label>

                        <select class="form-select"
                                name="Score"
                                required>
                            <option value="">Choose rating</option>
                            <option value="1">1 - Very Poor</option>
                            <option value="2">2 - Poor</option>
                            <option value="3">3 - Average</option>
                            <option value="4">4 - Good</option>
                            <option value="5">5 - Excellent</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Review (Optional)
                        </label>

                        <textarea class="form-control"
                                  name="Review"
                                  rows="4">
                        </textarea>
                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-warning">
                        Submit Rating
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>
<script>

    document.addEventListener("DOMContentLoaded", function () {

        // =========================
        // Feedback Modal
        // =========================

        const feedbackModal =
            new bootstrap.Modal(
                document.getElementById('feedbackModal'));

        const feedbackText =
            document.getElementById('feedbackText');

        const feedbackMentorName =
            document.getElementById('feedbackMentorName');

        document.querySelectorAll('.feedback-btn')
            .forEach(btn => {

                btn.addEventListener('click', function () {

                    feedbackText.innerText =
                        this.dataset.feedback || "No feedback available.";

                    feedbackMentorName.innerText =
                        "Mentor: " + this.dataset.mentor;

                    feedbackModal.show();

                });

            });

        // =========================
        // Rating Modal
        // =========================

        const ratingModal =
            new bootstrap.Modal(
                document.getElementById('ratingModal'));

        const ratingBookingId =
            document.getElementById('ratingBookingId');

        const ratingMentorName =
            document.getElementById('ratingMentorName');

        document.querySelectorAll('.rate-btn')
            .forEach(btn => {

                btn.addEventListener('click', function () {

                    ratingBookingId.value =
                        this.dataset.bookingId;

                    ratingMentorName.innerText =
                        "Mentor: " + this.dataset.mentor;

                    ratingModal.show();

                });

            });

    });

</script>