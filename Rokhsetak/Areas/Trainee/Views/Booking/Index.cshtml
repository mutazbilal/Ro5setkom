@using Rokhsetak.Areas.Trainee.ViewModels.Booking
@model TraineeBookingListViewModel
@{
    ViewData["Title"] = "My Bookings";
}

@section Styles {
    <link rel="stylesheet" href="~/css/booking-shared.css" />
}

<div class="booking-page">
    <div class="booking-page__inner">

        @if (TempData["Error"] != null)
        {
            <div class="alert alert--error" role="alert">
                <i class="fa-solid fa-circle-exclamation alert__icon" aria-hidden="true"></i>
                <div class="alert__body">@TempData["Error"]</div>
                <button type="button" class="alert__close" data-alert-dismiss aria-label="Dismiss">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert--success" role="status">
                <i class="fa-solid fa-circle-check alert__icon" aria-hidden="true"></i>
                <div class="alert__body">@TempData["Success"]</div>
                <button type="button" class="alert__close" data-alert-dismiss aria-label="Dismiss">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
        }

        <div class="booking-header">
            <h2 class="booking-header__title">My Bookings</h2>
            <a asp-area="Trainee" asp-controller="Booking" asp-action="Browse"
               class="btn btn--primary">
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                Find a Mentor
            </a>
        </div>

        @if (!Model.Bookings.Any())
        {
            <div class="empty-state">
                <i class="fa-solid fa-calendar-xmark empty-state__icon" aria-hidden="true"></i>
                <p class="empty-state__text">You have no bookings yet.</p>
                <a asp-area="Trainee" asp-controller="Booking" asp-action="Browse"
                   class="btn btn--secondary">Browse Mentors</a>
            </div>
        }
        else
        {
            <div class="bookings-table-wrap">
                <table class="bookings-table">
                    <thead>
                        <tr>
                            <th scope="col">Mentor</th>
                            <th scope="col">Date &amp; Time</th>
                            <th scope="col">Type</th>
                            <th scope="col">Status</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model.Bookings)
                        {
                            var rowClass = "is-" + b.Status;
                            var typeClass = b.SessionType == "practical" ? "type-pill--practical" : "type-pill--theoretical";
                            var statusClass = "status-pill--" + b.Status;
                            var statusLabel = char.ToUpper(b.Status[0]) + b.Status.Substring(1);

                            <tr class="@rowClass">
                                <td class="bookings-table__mentor" data-label="Mentor">@b.MentorName</td>
                                <td data-label="Date &amp; Time">
                                    <div class="bookings-table__date">@b.BookingDate.ToString("dd MMM yyyy")</div>
                                    <div class="bookings-table__time">
                                        @b.StartTime.ToString("HH:mm") – @b.EndTime.ToString("HH:mm")
                                    </div>
                                </td>
                                <td data-label="Type">
                                    <span class="type-pill @typeClass">@b.SessionType</span>
                                </td>
                                <td data-label="Status">
                                    <span class="status-pill @statusClass">@statusLabel</span>
                                </td>
                                <td data-label="Actions">
                                    <div class="bookings-table__actions">
                                        @if (b.CanReschedule)
                                        {
                                            <a asp-area="Trainee" asp-controller="Booking"
                                               asp-action="Reschedule"
                                               asp-route-bookingId="@b.BookingId"
                                               class="btn btn--secondary btn--sm">
                                                <i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i>
                                                Reschedule
                                            </a>
                                        }
                                        @if (b.CanCancel)
                                        {
                                            <form asp-area="Trainee" asp-controller="Booking"
                                                  asp-action="Cancel"
                                                  method="post"
                                                  class="btn-form"
                                                  data-confirm="Cancel this session?">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="bookingId" value="@b.BookingId" />
                                                <button type="submit" class="btn btn--danger btn--sm">
                                                    <i class="fa-solid fa-circle-xmark" aria-hidden="true"></i>
                                                    Cancel
                                                </button>
                                            </form>
                                        }
                                        @if (!b.CanCancel && !b.CanReschedule)
                                        {
                                            <span class="bookings-table__placeholder">—</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>
</div>

@section Scripts {
    <script src="~/js/booking-shared.js" asp-append-version="true"></script>
}
