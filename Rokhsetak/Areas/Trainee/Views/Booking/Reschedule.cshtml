@using Rokhsetak.Areas.Trainee.ViewModels.Booking
@model RescheduleTraineeViewModel
@{
    ViewData["Title"] = "Reschedule Session";
}

@section Styles {
    <link rel="stylesheet" href="~/css/booking-shared.css" />
}

<div class="booking-page">
    <div class="booking-page__inner booking-page__inner--xnarrow">

        <nav class="breadcrumb" aria-label="Breadcrumb">
            <a asp-area="Trainee" asp-controller="Booking" asp-action="Index"
               class="breadcrumb__item">My Bookings</a>
            <span class="breadcrumb__sep" aria-hidden="true">
                <i class="fa-solid fa-chevron-right"></i>
            </span>
            <span class="breadcrumb__item breadcrumb__item--active" aria-current="page">Reschedule</span>
        </nav>

        <section class="booking-card">
            <div class="booking-card__header booking-card__header--warning">
                <span class="booking-card__header-icon">
                    <i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i>
                </span>
                Reschedule Session
            </div>
            <div class="booking-card__body">

                <div class="locked-notice">
                    <div class="form-field__label form-field__label--small">Mentor</div>
                    <div class="locked-notice__value">@Model.MentorName</div>
                    <div class="locked-notice__meta">
                        Type:
                        <span class="type-pill @(Model.SessionType == "practical" ? "type-pill--practical" : "type-pill--theoretical")">@Model.SessionType</span>
                    </div>
                </div>

                @if (Model.AvailableDays.Any())
                {
                    <div class="form-field">
                        <span class="form-field__label form-field__label--small">Mentor's Availability</span>
                        <div class="day-slots day-slots--inline">
                            @foreach (var day in Model.AvailableDays)
                            {
                                <div class="day-slots__day">
                                    <span class="day-slots__name">@day.DayOfWeek:</span>
                                    <span class="day-slots__chips">
                                        @foreach (var s in day.Slots)
                                        {
                                            <span class="slot-chip">
                                                @s.StartTime.ToString("HH:mm") – @s.EndTime.ToString("HH:mm")
                                            </span>
                                        }
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                }

                <form asp-area="Trainee" asp-controller="Booking"
                      asp-action="Reschedule" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <input asp-for="BookingId" type="hidden" />
                    <input asp-for="MentorName" type="hidden" />
                    <input asp-for="SessionType" type="hidden" />

                    <div asp-validation-summary="ModelOnly" class="alert alert--error"></div>

                    <div class="form-field">
                        <label asp-for="NewDate" class="form-field__label">New Date</label>
                        <input asp-for="NewDate"
                               type="date"
                               class="form-field__input"
                               min="@DateOnly.FromDateTime(DateTime.UtcNow.AddDays(1)).ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="NewDate" class="form-field__error"></span>
                    </div>

                    <div class="form-row form-row--2">
                        <div class="form-field">
                            <label asp-for="NewStartTime" class="form-field__label">Start</label>
                            <input asp-for="NewStartTime" type="time" class="form-field__input" />
                            <span asp-validation-for="NewStartTime" class="form-field__error"></span>
                        </div>
                        <div class="form-field">
                            <label asp-for="NewEndTime" class="form-field__label">End</label>
                            <input asp-for="NewEndTime" type="time" class="form-field__input" />
                            <span asp-validation-for="NewEndTime" class="form-field__error"></span>
                        </div>
                    </div>

                    <div class="alert alert--warning-soft" role="note">
                        <i class="fa-solid fa-triangle-exclamation alert__icon" aria-hidden="true"></i>
                        <div class="alert__body">
                            The original booking will be cancelled and a new pending request created.
                            The mentor will need to confirm the new time.
                        </div>
                    </div>

                    <div class="form-actions">
                        <a asp-area="Trainee" asp-controller="Booking" asp-action="Index"
                           class="btn btn--secondary">Cancel</a>
                        <button type="submit" class="btn btn--warning">
                            <i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i>
                            Confirm Reschedule
                        </button>
                    </div>
                </form>

            </div>
        </section>

    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
