@using Rokhsetak.Areas.Trainee.ViewModels.Booking
@using Rokhsetak.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResourceMarker> L
@model Areas_Trainee_Views_Calendar_Index
 
@{
    ViewData["Title"] = L["Calendar_MyCalendar"];
}

@section Styles {
    <link rel="stylesheet" href="~/css/booking-shared.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.css" />
}

<div class="booking-page">
    <div class="booking-page__inner">

        @if (TempData["Error"] != null)
        {
            <div class="alert alert--error" role="alert">
                <i class="fa-solid fa-circle-exclamation alert__icon" aria-hidden="true"></i>
                <div class="alert__body">@TempData["Error"]</div>
                <button type="button" class="alert__close" data-alert-dismiss aria-label="@L["Calendar_Dismiss"]">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
        }

        <div class="booking-header">
            <h2 class="booking-header__title">
                <i class="fa-solid fa-calendar-days" aria-hidden="true"></i>
                @L["Calendar_MyCalendar"]
            </h2>
            <div class="calendar-legend" role="group" aria-label="@L["Calendar_LegendAria"]">
                <span class="status-pill status-pill--confirmed">@L["Calendar_Confirmed"]</span>
                <span class="status-pill status-pill--pending">@L["Calendar_Pending"]</span>
                <span class="status-pill status-pill--exam">@L["Calendar_Exam"]</span>
                <span class="status-pill status-pill--completed">@L["Calendar_Completed"]</span>
            </div>
        </div>

        <section class="booking-card">
            <div class="booking-card__body">
                <div id="calendar" class="calendar-shell"
                     aria-label="@L["Calendar_CalendarAria"]"></div>
            </div>
        </section>

    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
    <script id="calendar-events-data" type="application/json">
        @Html.Raw(ViewBag.EventsJson)
    </script>
    <script src="~/js/calendar.js" asp-append-version="true"></script>
    <script src="~/js/booking-shared.js" asp-append-version="true"></script>
}