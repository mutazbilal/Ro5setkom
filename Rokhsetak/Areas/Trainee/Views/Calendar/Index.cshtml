@{
    ViewData["Title"] = "My Calendar";
}

<div class="container-fluid py-4">

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h2 class="fw-bold mb-0"><i class="bi bi-calendar3"></i> My Calendar</h2>
        <div class="d-flex gap-2 align-items-center">
            <span class="badge bg-success">■ Confirmed booking</span>
            <span class="badge bg-warning text-dark">■ Pending booking</span>
            <span class="badge bg-danger">■ Exam</span>
            <span class="badge bg-secondary">■ Completed</span>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-2 p-md-3">
            <div id="calendar" style="min-height: 600px;"></div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- FullCalendar CDN -->
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
        var calendarEl = document.getElementById('calendar');

        var events = @Html.Raw(ViewBag.EventsJson);

        var calendar = new FullCalendar.Calendar(calendarEl, {
        initialView: 'dayGridMonth',
        headerToolbar: {
        left:   'prev,next today',
        center: 'title',
        right:  'dayGridMonth,timeGridWeek,listMonth'
        },
        events: events,
        eventDisplay: 'block',
        eventClick: function(info) {
        var props = info.event.extendedProps;
        var msg = info.event.title
        + '\nStatus: ' + props.status
        + (props.location ? '\nLocation: ' + props.location : '');
        alert(msg);
        },
        eventDidMount: function(info) {
        // Tooltip on hover
        info.el.title = info.event.title
        + ' [' + (info.event.extendedProps.status || '') + ']';
        },
        nowIndicator: true,
        height: 'auto'
        });

        calendar.render();
        });
    </script>
}