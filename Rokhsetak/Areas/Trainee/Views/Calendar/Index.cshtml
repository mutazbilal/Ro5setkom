@using Rokhsetak.Areas.Trainee.ViewModels.Booking
@model Areas_Trainee_Views_Calendar_Index
 
@{
    ViewData["Title"] = "My Calendar";
}

@section Styles {
    <link rel="stylesheet" href="~/css/booking-shared.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.css" />
}

<div class="booking-page">
    <div class="booking-page__inner">

        @if (TempData["Error"] != null)
        {
            <div class="alert alert--error" role="alert">
                <i class="fa-solid fa-circle-exclamation alert__icon" aria-hidden="true"></i>
                <div class="alert__body">@TempData["Error"]</div>
                <button type="button" class="alert__close" data-alert-dismiss aria-label="Dismiss">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
        }

        <div class="booking-header">
            <h2 class="booking-header__title">
                <i class="fa-solid fa-calendar-days" aria-hidden="true"></i>
                My Calendar
            </h2>
            <div class="calendar-legend" role="group" aria-label="Calendar legend">
                <span class="status-pill status-pill--confirmed">Confirmed</span>
                <span class="status-pill status-pill--pending">Pending</span>
                <span class="status-pill status-pill--exam">Exam</span>
                <span class="status-pill status-pill--completed">Completed</span>
            </div>
        </div>

        <section class="booking-card">
            <div class="booking-card__body">
                <div id="calendar" class="calendar-shell"
                     aria-label="Calendar of bookings and exams"></div>
            </div>
        </section>

        @* JSON data island — non-executable; calendar.js parses textContent.
           Safer than interpolating into a runtime <script> block. *@
        <script id="calendar-events-data" type="application/json">@Html.Raw(Model.EventsJson)</script>

    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
    <script src="~/js/calendar.js" asp-append-version="true"></script>
    <script src="~/js/booking-shared.js" asp-append-version="true"></script>
}
