@using Rokhsetak.Areas.Mentor.ViewModels.Appointments
@using Rokhsetak.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResourceMarker> L
@model FeedbackViewModel
@{
    ViewData["Title"] = L["Mentor_Feedback_Title"];
    ViewData["ActiveNav"] = "appointments";
}

@section Styles {
    <link rel="stylesheet" href="~/css/appointments.css" />
}

<div class="appointments-page">
    <div class="appointments-page__inner">

        @if (TempData["Error"] != null)
        {
            <div class="alert dashboard-alert dashboard-alert--error" role="alert">
                <i class="fa-solid fa-triangle-exclamation dashboard-alert__icon" aria-hidden="true"></i>
                <span class="dashboard-alert__message">@TempData["Error"]</span>
                <button type="button"
                        class="dashboard-alert__close"
                        data-alert-dismiss
                        aria-label="@L["Alert_Close"]">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
        }

        <!-- ============ Hero ============ -->
        <section class="appointments-hero appointments-hero--compact" aria-labelledby="feedback-page-title">
            <div class="appointments-hero__intro">
                <span class="appointments-hero__eyebrow">@L["Mentor_Feedback_Title"]</span>
                <h1 id="feedback-page-title" class="appointments-hero__title">@L["Mentor_Feedback_ShareNotes"]</h1>
                <p class="appointments-hero__description">
                    @L["Mentor_Feedback_Description"]
                </p>
            </div>

            <div class="appointments-hero__cta">
                <a asp-area="Mentor"
                   asp-controller="Appointments"
                   asp-action="Index"
                   class="btn-action btn-action--ghost">
                    <i class="fa-solid fa-arrow-left-long" aria-hidden="true"></i>
                    <span>@L["Mentor_Appointments"]</span>
                </a>
            </div>
        </section>

        <!-- ============ Form card ============ -->
        <section class="form-card" aria-labelledby="feedback-form-title">
            <h2 id="feedback-form-title" class="visually-hidden">@L["Mentor_Feedback_FormTitle"]</h2>

            <!-- Context strip: who & when -->
            <div class="context-strip">
                <span class="context-strip__icon" aria-hidden="true">
                    <i class="fa-solid fa-user-graduate"></i>
                </span>
                <div class="context-strip__body">
                    <span class="context-strip__label">@L["Mentor_Trainee"]</span>
                    <span class="context-strip__name">@Model.TraineeName</span>
                </div>
                <div class="context-strip__meta">
                    <span class="chip chip--soft">
                        <i class="fa-solid fa-calendar-day" aria-hidden="true"></i>
                        @Model.SessionDate.ToString("dd MMM yyyy")
                    </span>
                </div>
            </div>

            <form asp-area="Mentor"
                  asp-controller="Appointments"
                  asp-action="Feedback"
                  method="post"
                  novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="BookingId" />
                <input type="hidden" asp-for="TraineeName" />
                <input type="hidden" asp-for="SessionDate" />

                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <div class="field-floating field-floating--textarea">
                    <textarea asp-for="MentorNotes"
                              class="field-floating__input"
                              rows="8"
                              placeholder=" "
                              aria-required="true"></textarea>
                    <label asp-for="MentorNotes" class="field-floating__label">
                        @L["Mentor_Feedback_NotesLabel"]
                    </label>
                    <span asp-validation-for="MentorNotes" class="field-floating__error"></span>
                    <p class="field-floating__hint">
                        @L["Mentor_Feedback_NotesHint"]
                    </p>
                </div>

                <div class="form-actions">
                    <a asp-area="Mentor"
                       asp-controller="Appointments"
                       asp-action="Index"
                       class="btn-action btn-action--ghost">
                        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                        <span>@L["Common_Cancel"]</span>
                    </a>
                    <button type="submit" class="btn-action btn-action--gradient">
                        <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
                        <span>@L["Mentor_SubmitFeedback"]</span>
                    </button>
                </div>
            </form>
        </section>

    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}