@model FeedbackViewModel
@{
    ViewData["Title"] = "Session Feedback";
}

<div class="container py-4" style="max-width: 600px;">

    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-area="Mentor" asp-controller="Appointments" asp-action="Index">Appointments</a>
            </li>
            <li class="breadcrumb-item active">Feedback</li>
        </ol>
    </nav>

    <div class="card shadow-sm">
        <div class="card-header bg-info text-white fw-semibold">
            <i class="bi bi-chat-left-text"></i> Session Feedback
        </div>
        <div class="card-body">

            <div class="mb-4 p-3 bg-light rounded border">
                <p class="mb-1 small text-muted">Trainee</p>
                <p class="mb-1 fw-semibold">@Model.TraineeName</p>
                <p class="mb-0 small text-muted">
                    Session date: <strong>@Model.SessionDate.ToString("dd MMMM yyyy")</strong>
                </p>
            </div>

            <form asp-area="Mentor" asp-controller="Appointments" asp-action="Feedback"
                  method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="BookingId" />
                <input type="hidden" asp-for="TraineeName" />
                <input type="hidden" asp-for="SessionDate" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-4">
                    <label asp-for="MentorNotes" class="form-label fw-semibold">
                        Feedback Notes
                        <span class="text-muted fw-normal small">(visible to trainee)</span>
                    </label>
                    <textarea asp-for="MentorNotes"
                              class="form-control"
                              rows="6"
                                  placeholder="Describe the trainee's performance, areas of improvement, and strengths...">
                    </textarea>
                        <span asp-validation-for="MentorNotes" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-area="Mentor" asp-controller="Appointments" asp-action="Index"
                               class="btn btn-outline-secondary">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-info text-white fw-semibold">
                            <i class="bi bi-send-check"></i> Submit Feedback
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @section Scripts {
        @await Html.PartialAsync("_ValidationScriptsPartial")
    }