@model RescheduleViewModel
@{
    ViewData["Title"] = "Reschedule Session";
}

<div class="container py-4" style="max-width: 560px;">

    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-area="Mentor" asp-controller="Appointments" asp-action="Index">Appointments</a>
            </li>
            <li class="breadcrumb-item active">Reschedule</li>
        </ol>
    </nav>

    <div class="card shadow-sm">
        <div class="card-header bg-warning fw-semibold">
            <i class="bi bi-arrow-repeat"></i> Reschedule Session
        </div>
        <div class="card-body">

            <div class="mb-3 p-3 bg-light rounded border">
                <p class="mb-1 small text-muted">Trainee</p>
                <p class="mb-1 fw-semibold">@Model.TraineeName</p>
                <p class="mb-0 small text-muted">
                    Session type:
                    <span class="badge bg-info text-dark">@Model.SessionType</span>
                </p>
            </div>

            <form asp-area="Mentor" asp-controller="Appointments" asp-action="Reschedule"
                  method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="BookingId" />
                <input type="hidden" asp-for="TraineeName" />
                <input type="hidden" asp-for="SessionType" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="NewDate" class="form-label fw-semibold">New Date</label>
                    <input asp-for="NewDate"
                           type="date"
                           class="form-control"
                           min="@DateOnly.FromDateTime(DateTime.UtcNow.AddDays(1)).ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="NewDate" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-6">
                        <label asp-for="NewStartTime" class="form-label fw-semibold">Start Time</label>
                        <input asp-for="NewStartTime" type="time" class="form-control" />
                        <span asp-validation-for="NewStartTime" class="text-danger small"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="NewEndTime" class="form-label fw-semibold">End Time</label>
                        <input asp-for="NewEndTime" type="time" class="form-control" />
                        <span asp-validation-for="NewEndTime" class="text-danger small"></span>
                    </div>
                </div>

                <div class="alert alert-info small mb-4">
                    <i class="bi bi-info-circle"></i>
                    The original booking will be cancelled and a new confirmed session will be created.
                    The trainee will be notified automatically.
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-area="Mentor" asp-controller="Appointments" asp-action="Index"
                           class="btn btn-outline-secondary">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-warning fw-semibold">
                        <i class="bi bi-arrow-repeat"></i> Confirm Reschedule
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}