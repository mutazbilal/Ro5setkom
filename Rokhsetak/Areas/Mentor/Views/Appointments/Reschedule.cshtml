@using Rokhsetak.Areas.Mentor.ViewModels.Appointments
@using Rokhsetak.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResourceMarker> L
@model RescheduleViewModel
@{
    ViewData["Title"] = L["Mentor_RescheduleSession"];

    var minDate = DateOnly.FromDateTime(DateTime.UtcNow.AddDays(1)).ToString("yyyy-MM-dd");
}

@section Styles {
    <link rel="stylesheet" href="~/css/appointments.css" />
}

<div class="appointments-page">
    <div class="appointments-page__inner">

        @if (TempData["Error"] != null)
        {
            <div class="alert dashboard-alert dashboard-alert--error" role="alert">
                <i class="fa-solid fa-triangle-exclamation dashboard-alert__icon" aria-hidden="true"></i>
                <span class="dashboard-alert__message">@TempData["Error"]</span>
                <button type="button"
                        class="dashboard-alert__close"
                        data-alert-dismiss
                        aria-label="@L["Alert_Close"]">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
        }

        <!-- ============ Hero ============ -->
        <section class="appointments-hero appointments-hero--compact" aria-labelledby="reschedule-page-title">
            <div class="appointments-hero__intro">
                <span class="appointments-hero__eyebrow">@L["Mentor_RescheduleSession"]</span>
                <h1 id="reschedule-page-title" class="appointments-hero__title">@L["Mentor_PickNewTime"]</h1>
                <p class="appointments-hero__description">
                    @L["Mentor_RescheduleDescription"]
                </p>
            </div>

            <div class="appointments-hero__cta">
                <a asp-area="Mentor"
                   asp-controller="Appointments"
                   asp-action="Index"
                   class="btn-action btn-action--ghost">
                    <i class="fa-solid fa-arrow-left-long" aria-hidden="true"></i>
                    <span>@L["Mentor_Appointments"]</span>
                </a>
            </div>
        </section>

        <!-- ============ Form card ============ -->
        <section class="form-card" aria-labelledby="reschedule-form-title">
            <h2 id="reschedule-form-title" class="visually-hidden">@L["Mentor_RescheduleFormTitle"]</h2>

            <!-- Context strip: who + what -->
            <div class="context-strip">
                <span class="context-strip__icon" aria-hidden="true">
                    <i class="fa-solid fa-user-graduate"></i>
                </span>
                <div class="context-strip__body">
                    <span class="context-strip__label">@L["Mentor_Trainee"]</span>
                    <span class="context-strip__name">@Model.TraineeName</span>
                </div>
                <div class="context-strip__meta">
                    <span class="chip @(string.Equals(Model.SessionType, "practical", System.StringComparison.OrdinalIgnoreCase) ? "chip--accent" : "chip--primary")">
                        <i class="fa-solid @(string.Equals(Model.SessionType, "practical", System.StringComparison.OrdinalIgnoreCase) ? "fa-car" : "fa-book")"
                           aria-hidden="true"></i>
                        @(Model.SessionType == "practical" ? L["Booking_Practical"] : L["Booking_Theoretical"])
                    </span>
                </div>
            </div>

            <form asp-area="Mentor"
                  asp-controller="Appointments"
                  asp-action="Reschedule"
                  method="post"
                  novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="BookingId" />
                <input type="hidden" asp-for="TraineeName" />
                <input type="hidden" asp-for="SessionType" />

                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <!-- Date picker — type=date always shows a value, so label sits floated -->
                <div class="field-floating field-floating--filled">
                    <input asp-for="NewDate"
                           type="date"
                           class="field-floating__input"
                           min="@minDate"
                           placeholder=" "
                           aria-required="true" />
                    <label asp-for="NewDate" class="field-floating__label">@L["Mentor_NewDate"]</label>
                    <span asp-validation-for="NewDate" class="field-floating__error"></span>
                </div>

                <!-- Time pickers — side by side on wider screens -->
                <div class="field-grid">
                    <div class="field-floating field-floating--filled">
                        <input asp-for="NewStartTime"
                               type="time"
                               class="field-floating__input"
                               placeholder=" "
                               aria-required="true" />
                        <label asp-for="NewStartTime" class="field-floating__label">@L["Mentor_StartTime"]</label>
                        <span asp-validation-for="NewStartTime" class="field-floating__error"></span>
                    </div>
                    <div class="field-floating field-floating--filled">
                        <input asp-for="NewEndTime"
                               type="time"
                               class="field-floating__input"
                               placeholder=" "
                               aria-required="true" />
                        <label asp-for="NewEndTime" class="field-floating__label">@L["Mentor_EndTime"]</label>
                        <span asp-validation-for="NewEndTime" class="field-floating__error"></span>
                    </div>
                </div>

                <div class="callout callout--warning" role="note">
                    <span class="callout__icon" aria-hidden="true">
                        <i class="fa-solid fa-circle-info"></i>
                    </span>
                    <div class="callout__body">
                        @L["Mentor_RescheduleCallout"]
                    </div>
                </div>

                <div class="form-actions">
                    <a asp-area="Mentor"
                       asp-controller="Appointments"
                       asp-action="Index"
                       class="btn-action btn-action--ghost">
                        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                        <span>@L["Common_Cancel"]</span>
                    </a>
                    <button type="submit" class="btn-action btn-action--gradient">
                        <i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i>
                        <span>@L["Mentor_ConfirmReschedule"]</span>
                    </button>
                </div>
            </form>
        </section>

    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}