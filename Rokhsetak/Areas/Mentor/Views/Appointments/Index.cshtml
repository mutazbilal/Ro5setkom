@using Rokhsetak.Areas.Mentor.ViewModels.Appointments
@using Rokhsetak.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResourceMarker> L
@model AppointmentListViewModel
@{
    ViewData["Title"] = L["Mentor_ManageAppointments"];
    ViewData["ActiveNav"] = "appointments";

    var totalCount     = Model.Items.Count;
    var pendingCount   = Model.Items.Count(i => i.Status == "pending");
    var confirmedCount = Model.Items.Count(i => i.Status == "confirmed");
}

@functions {
    /// <summary>Maps appointment status to (card-modifier, pill-modifier, label).</summary>
    (string cardMod, string pillMod, string label) StatusPresentation(string status) =>
        status switch
        {
            "pending"   => ("pending",   "up-next",     L["Booking_Pending"]),
            "confirmed" => ("confirmed", "in-progress", L["Booking_Confirmed"]),
            "completed" => ("completed", "completed",   L["Booking_Completed"]),
            "cancelled" => ("cancelled", "pending",     L["Booking_Cancelled"]),
            _           => ("pending",   "pending",     status)
        };

    /// <summary>Session-type chip variant — practical leans gold, theoretical stays primary.</summary>
    string SessionTypeChip(string type) =>
        string.Equals(type, "practical", System.StringComparison.OrdinalIgnoreCase)
            ? "chip--accent"
            : "chip--primary";
}

@section Styles {
    <link rel="stylesheet" href="~/css/appointments.css" />
}

<div class="appointments-page">
    <div class="appointments-page__inner">

        @if (TempData["Error"] != null)
        {
            <div class="alert dashboard-alert dashboard-alert--error" role="alert">
                <i class="fa-solid fa-triangle-exclamation dashboard-alert__icon" aria-hidden="true"></i>
                <span class="dashboard-alert__message">@TempData["Error"]</span>
                <button type="button"
                        class="dashboard-alert__close"
                        data-alert-dismiss
                        aria-label="@L["Alert_Close"]">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert dashboard-alert dashboard-alert--success" role="alert">
                <i class="fa-solid fa-circle-check dashboard-alert__icon" aria-hidden="true"></i>
                <span class="dashboard-alert__message">@TempData["Success"]</span>
                <button type="button"
                        class="dashboard-alert__close"
                        data-alert-dismiss
                        aria-label="@L["Alert_Close"]">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
        }

        <!-- ============ Hero ============ -->
        <section class="appointments-hero" aria-labelledby="appointments-page-title">
            <div class="appointments-hero__intro">
                <span class="appointments-hero__eyebrow">@L["Mentor_Workspace"]</span>
                <h1 id="appointments-page-title" class="appointments-hero__title">@L["Mentor_ManageAppointments"]</h1>
                <div class="appointments-hero__meta">
                    <span class="chip chip--soft" aria-label="@L["Mentor_TotalAppointments"]">
                        <i class="fa-solid fa-calendar-days" aria-hidden="true"></i>
                        @totalCount @L["Mentor_Total"]
                    </span>
                    @if (pendingCount > 0)
                    {
                        <span class="chip chip--warning" aria-label="@L["Mentor_PendingAppointments"]">
                            <i class="fa-solid fa-hourglass-half" aria-hidden="true"></i>
                            @pendingCount @L["Mentor_Pending"]
                        </span>
                    }
                    @if (confirmedCount > 0)
                    {
                        <span class="chip chip--primary" aria-label="@L["Mentor_ConfirmedAppointments"]">
                            <i class="fa-solid fa-check" aria-hidden="true"></i>
                            @confirmedCount @L["Mentor_Confirmed"]
                        </span>
                    }
                </div>
            </div>

            <div class="appointments-hero__cta">
                <a asp-area="Mentor"
                   asp-controller="Dashboard"
                   asp-action="Index"
                   class="btn-action btn-action--ghost">
                    <i class="fa-solid fa-arrow-left-long" aria-hidden="true"></i>
                    <span>@L["Mentor_Dashboard"]</span>
                </a>
            </div>
        </section>

        @if (!Model.Items.Any())
        {
            <!-- ============ Empty state ============ -->
            <section class="appointments-empty" aria-live="polite">
                <span class="appointments-empty__icon" aria-hidden="true">
                    <i class="fa-regular fa-calendar"></i>
                </span>
                <h2 class="appointments-empty__title">@L["Mentor_NoAppointmentsYet"]</h2>
                <p class="appointments-empty__message">
                    @L["Mentor_NoAppointmentsMessage"]
                </p>
            </section>
        }
        else
        {
            <!-- ============ Appointment list ============ -->
            <ul class="appointment-list" aria-label="@L["Mentor_AppointmentsListAria"]">
                @foreach (var item in Model.Items)
                {
                    var (cardMod, pillMod, statusLabel) = StatusPresentation(item.Status);
                    var hasActions = item.CanConfirm || item.CanReschedule || item.CanMarkDone
                                     || item.CanCancel || item.CanFeedback || item.FeedbackGiven;

                    <li class="appointment-card appointment-card--@cardMod">
                        <div class="appointment-card__head">

                            <div class="appointment-card__identity">
                                <a asp-area="Mentor"
                                   asp-controller="Trainees"
                                   asp-action="Detail"
                                   asp-route-id="@item.TraineeId"
                                   class="appointment-card__trainee">
                                    @item.TraineeName
                                    <i class="fa-solid fa-arrow-right-long" aria-hidden="true"></i>
                                </a>
                                <span class="appointment-card__license">
                                    <i class="fa-solid fa-id-card" aria-hidden="true"></i>
                                    @item.LicenseType
                                </span>
                            </div>

                            <div class="appointment-card__schedule">
                                <span class="appointment-card__date">
                                    @item.BookingDate.ToString("ddd, dd MMM yyyy")
                                </span>
                                <span class="appointment-card__time">
                                    @item.StartTime.ToString("HH:mm") – @item.EndTime.ToString("HH:mm")
                                </span>
                            </div>

                            <div class="appointment-card__tags">
                                <span class="chip @SessionTypeChip(item.SessionType)">
                                    <i class="fa-solid @(item.SessionType == "practical" ? "fa-car" : "fa-book")"
                                       aria-hidden="true"></i>
                                    @(item.SessionType == "practical" ? L["Booking_Practical"] : L["Booking_Theoretical"])
                                </span>
                                <span class="status-pill status-pill--@pillMod">@statusLabel</span>
                            </div>

                        </div>

                        @if (hasActions)
                        {
                            <div class="appointment-card__actions">
                                @if (item.CanConfirm)
                                {
                                    <form asp-area="Mentor"
                                          asp-controller="Appointments"
                                          asp-action="Confirm"
                                          method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="bookingId" value="@item.BookingId" />
                                        <button type="submit" class="btn-action btn-action--gradient btn-action--sm">
                                            <i class="fa-solid fa-check" aria-hidden="true"></i>
                                            <span>@L["Mentor_Confirm"]</span>
                                        </button>
                                    </form>
                                }
                                @if (item.CanMarkDone)
                                {
                                    <form asp-area="Mentor"
                                          asp-controller="Appointments"
                                          asp-action="MarkDone"
                                          method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="bookingId" value="@item.BookingId" />
                                        <button type="submit" class="btn-action btn-action--outline btn-action--sm">
                                            <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
                                            <span>@L["Mentor_MarkDone"]</span>
                                        </button>
                                    </form>
                                }
                                @if (item.CanReschedule)
                                {
                                    <a asp-area="Mentor"
                                       asp-controller="Appointments"
                                       asp-action="Reschedule"
                                       asp-route-bookingId="@item.BookingId"
                                       class="btn-action btn-action--ghost btn-action--sm">
                                        <i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i>
                                        <span>@L["Mentor_Reschedule"]</span>
                                    </a>
                                }
                                @if (item.CanFeedback)
                                {
                                    <a asp-area="Mentor"
                                       asp-controller="Appointments"
                                       asp-action="Feedback"
                                       asp-route-bookingId="@item.BookingId"
                                       class="btn-action btn-action--ghost-success btn-action--sm">
                                        <i class="fa-solid fa-comment-dots" aria-hidden="true"></i>
                                        <span>@L["Mentor_Feedback"]</span>
                                    </a>
                                }
                                @if (item.FeedbackGiven)
                                {
                                    <span class="appointment-card__feedback-given">
                                        <i class="fa-solid fa-comment-medical" aria-hidden="true"></i>
                                        @L["Mentor_FeedbackSubmitted"]
                                    </span>
                                }
                                @if (item.CanCancel)
                                {
                                    <form asp-area="Mentor"
                                          asp-controller="Appointments"
                                          asp-action="Cancel"
                                          method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="bookingId" value="@item.BookingId" />
                                        <button type="submit" class="btn-action btn-action--ghost-danger btn-action--sm">
                                            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                                            <span>@L["Mentor_Cancel"]</span>
                                        </button>
                                    </form>
                                }
                            </div>
                        }
                    </li>
                }
            </ul>
        }

    </div>
</div>