@using Rokhsetak.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResourceMarker> L
@model TraineeSummaryListViewModel
@{
    ViewData["Title"] = L["Trainees_Title"];

    string StageClass(string stage) =>
        stage == "completed" ? "pill-stage--done"
        : stage.Contains("pending") ? "pill-stage--pending"
        : "pill-stage--default";
}

@section Styles {
    <link href="~/css/trainees.css" rel="stylesheet" asp-append-version="true" />
}

<div class="tr-wrap">

    @if (TempData["Error"] != null)
    {
        <div class="flash flash-error" role="alert">
            <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
            <span>@TempData["Error"]</span>
        </div>
    }

    <header class="tr-header">
        <div>
            <p class="tr-eyebrow"><i class="fa-solid fa-users" aria-hidden="true"></i> @L["Trainees_Mentorship"]</p>
            <h1>@L["Trainees_Title"]</h1>
        </div>
        <a asp-area="Mentor" asp-controller="Dashboard" asp-action="Index" class="btn-link-back">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
            @L["Trainees_DashboardLink"]
        </a>
    </header>

    @* -- Search + Filter -- *@
    <form method="get" class="tr-filters">
        <div class="filter-field filter-field--grow">
            <label for="search">@L["Trainees_SearchByName"]</label>
            <div class="input-affix">
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                <input type="text" id="search" name="search" value="@Model.SearchTerm"
                       placeholder="@L["Trainees_SearchPlaceholder"]" aria-label="@L["Trainees_SearchAria"]" />
            </div>
        </div>

        <div class="filter-field filter-field--status">
            <label for="statusFilter">@L["Trainees_FilterByStatus"]</label>
            <select id="statusFilter" name="statusFilter" class="tr-select" aria-label="@L["Trainees_FilterAria"]">
                <option value="">@L["Trainees_AllStatuses"]</option>
                @foreach (var s in TraineeSummaryListViewModel.AvailableStatuses)
                {
                    <option value="@s" selected="@(Model.StatusFilter == s)">@L[$"Trainees_Stage_{s.Replace(" ", "_")}"]</option>
                }
            </select>
        </div>

        <div class="filter-actions">
            <button type="submit" class="btn-primary">
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                @L["Trainees_SearchButton"]
            </button>
            <a asp-area="Mentor" asp-controller="Trainees" asp-action="Index" class="btn-ghost">@L["Trainees_ClearButton"]</a>
        </div>
    </form>

    @if (!Model.Trainees.Any())
    {
        <div class="tr-empty">
            <i class="fa-solid fa-user-group" aria-hidden="true"></i>
            <p>@L["Trainees_EmptyMessage"]</p>
        </div>
    }
    else
    {
        <div class="tr-table-card">
            <div class="tr-table-scroll">
                <table class="tr-table">
                    <thead>
                        <tr>
                            <th>@L["Trainees_Table_Trainee"]</th>
                            <th>@L["Trainees_Table_License"]</th>
                            <th>@L["Trainees_Table_Stage"]</th>
                            <th class="center">@L["Trainees_Table_TotalSessions"]</th>
                            <th>@L["Trainees_Table_LastSession"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.Trainees)
                        {
                            <tr>
                                <td class="cell-name">@t.FullName</td>
                                <td><span class="pill pill-license">@t.LicenseType.Replace("_", " ")</span></td>
                                <td><span class="pill">@t.LicenseStage</span></td>
                                <td class="cell-center cell-count">@t.TotalSessions</td>
                                <td class="cell-muted">
                                    @(t.LastSessionDate.HasValue ? t.LastSessionDate.Value.ToString("dd MMM yyyy") : "-")
                                </td>
                                <td>
                                    <a asp-area="Mentor" asp-controller="Trainees" asp-action="Detail"
                                       asp-route-id="@t.TraineeId" class="row-action">
                                        @L["Trainees_ViewDetails"]
                                        <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <p class="tr-count-note">@string.Format(L["Trainees_ShowingCount"], Model.Trainees.Count)</p>
    }
</div>