@model TraineeSummaryListViewModel
@{
    ViewData["Title"] = "Trainees Summary";

    string StageClass(string stage) =>
        stage == "completed" ? "pill-stage--done"
        : stage.Contains("pending") ? "pill-stage--pending"
        : "pill-stage--default";
}

@section Styles {
    <link href="~/css/trainees.css" rel="stylesheet" asp-append-version="true" />
}

<div class="tr-wrap">

    @if (TempData["Error"] != null)
    {
        <div class="flash flash-error" role="alert">
            <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
            <span>@TempData["Error"]</span>
        </div>
    }

    <header class="tr-header">
        <div>
            <p class="tr-eyebrow"><i class="fa-solid fa-users" aria-hidden="true"></i> Mentorship</p>
            <h1>Trainees Summary</h1>
        </div>
        <a asp-area="Mentor" asp-controller="Dashboard" asp-action="Index" class="btn-link-back">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
            Dashboard
        </a>
    </header>

    @* -- Search + Filter -- *@
    <form method="get" class="tr-filters">
        <div class="filter-field filter-field--grow">
            <label for="search">Search by name</label>
            <div class="input-affix">
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                <input type="text" id="search" name="search" value="@Model.SearchTerm"
                       placeholder="Trainee name..." aria-label="Search trainees by name" />
            </div>
        </div>

        <div class="filter-field filter-field--status">
            <label for="statusFilter">Filter by status</label>
            <select id="statusFilter" name="statusFilter" class="tr-select" aria-label="Filter by license status">
                <option value="">- All statuses -</option>
                @foreach (var s in TraineeSummaryListViewModel.AvailableStatuses)
                {
                    <option value="@s" selected="@(Model.StatusFilter == s)">@s.Replace("_", " ")</option>
                }
            </select>
        </div>

        <div class="filter-actions">
            <button type="submit" class="btn-primary">
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                Search
            </button>
            <a asp-area="Mentor" asp-controller="Trainees" asp-action="Index" class="btn-ghost">Clear</a>
        </div>
    </form>

    @if (!Model.Trainees.Any())
    {
        <div class="tr-empty">
            <i class="fa-solid fa-user-group" aria-hidden="true"></i>
            <p>No trainees found matching your search.</p>
        </div>
    }
    else
    {
        <div class="tr-table-card">
            <div class="tr-table-scroll">
                <table class="tr-table">
                    <thead>
                        <tr>
                            <th>Trainee</th>
                            <th>License</th>
                            <th>Stage</th>
                            <th class="center">Total Sessions</th>
                            <th>Last Session</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.Trainees)
                        {
                            <tr>
                                <td class="cell-name">@t.FullName</td>
                                <td><span class="pill pill-license">@t.LicenseType.Replace("_", " ")</span></td>
                                <td><span class="pill @StageClass(t.LicenseStage)">@t.LicenseStage.Replace("_", " ")</span></td>
                                <td class="cell-center cell-count">@t.TotalSessions</td>
                                <td class="cell-muted">
                                    @(t.LastSessionDate.HasValue ? t.LastSessionDate.Value.ToString("dd MMM yyyy") : "-")
                                </td>
                                <td>
                                    <a asp-area="Mentor" asp-controller="Trainees" asp-action="Detail"
                                       asp-route-id="@t.TraineeId" class="row-action">
                                        View Details
                                        <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <p class="tr-count-note">Showing @Model.Trainees.Count trainee@(Model.Trainees.Count == 1 ? "" : "s").</p>
    }
</div>
