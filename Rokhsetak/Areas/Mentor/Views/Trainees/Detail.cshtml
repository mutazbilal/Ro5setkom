@model TraineeDetailViewModel
@{
    ViewData["Title"] = Model.FullName;

    string StageClass(string stage) =>
        stage == "completed" ? "pill-stage--done"
        : stage.Contains("pending") ? "pill-stage--pending"
        : "pill-stage--default";

    string StatusClass(string status) => status switch
    {
        "completed" => "pill-status--completed",
        "confirmed" => "pill-status--confirmed",
        "pending" => "pill-status--pending",
        _ => "pill-status--default"
    };

    string StatusLabel(string status) => status switch
    {
        "completed" => "Completed",
        "confirmed" => "Confirmed",
        "pending" => "Pending",
        _ => status
    };
}

@section Styles {
    <link href="~/css/trainees.css" rel="stylesheet" asp-append-version="true" />
}

<div class="tr-wrap">

    <nav class="tr-breadcrumb" aria-label="Breadcrumb">
        <a asp-area="Mentor" asp-controller="Trainees" asp-action="Index">Trainees</a>
        <span class="sep" aria-hidden="true">/</span>
        <span class="current">@Model.FullName</span>
    </nav>

    @* -- Profile hero -- *@
    <section class="profile-card">
        <div class="profile-identity">
            <h1>@Model.FullName</h1>
            <p class="profile-email">
                <i class="fa-solid fa-envelope" aria-hidden="true"></i>
                @Model.Email
            </p>
            <div class="profile-pills">
                <span class="pill pill-license">@Model.LicenseType.Replace("_", " ")</span>
                <span class="pill @StageClass(Model.LicenseStage)">@Model.LicenseStage.Replace("_", " ")</span>
            </div>
        </div>

        <div class="profile-progress">
            <div class="pct">@Model.ProgressPct%</div>
            <div class="label">Overall Progress</div>
            <div class="meter" role="progressbar" aria-valuenow="@Model.ProgressPct" aria-valuemin="0" aria-valuemax="100">
                <div class="meter-fill" style="width:@Model.ProgressPct%"></div>
            </div>
        </div>
    </section>

    <div class="detail-grid">

        @* -- Session history -- *@
        <section class="panel">
            <div class="panel-header">
                <i class="fa-solid fa-calendar-check" aria-hidden="true"></i>
                Session History
                <span class="count">@Model.Sessions.Count</span>
            </div>
            @if (Model.Sessions.Any())
            {
                <div class="tr-table-scroll">
                    <table class="session-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Type</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model.Sessions)
                            {
                                <tr>
                                    <td>@s.SessionDate.ToString("dd MMM yyyy")</td>
                                    <td class="session-time">@s.StartTime.ToString("HH:mm") - @s.EndTime.ToString("HH:mm")</td>
                                    <td>
                                        <span class="pill @(s.SessionType == "practical" ? "pill-type--practical" : "pill-type--theory")">
                                            @s.SessionType
                                        </span>
                                    </td>
                                    <td><span class="pill @StatusClass(s.Status)">@StatusLabel(s.Status)</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="panel-empty">No sessions recorded.</p>
            }
        </section>

        @* -- Feedback notes -- *@
        <section class="panel">
            <div class="panel-header">
                <i class="fa-solid fa-comment-dots" aria-hidden="true"></i>
                Feedback Notes
                <span class="count">@Model.Feedbacks.Count</span>
            </div>
            @if (Model.Feedbacks.Any())
            {
                <ul class="feedback-list">
                    @foreach (var f in Model.Feedbacks)
                    {
                        <li class="feedback-item">
                            <div class="feedback-meta">
                                <span class="feedback-date">@f.SessionDate.ToString("dd MMM yyyy")</span>
                                <span class="feedback-time">@f.CreatedAt.ToString("HH:mm")</span>
                            </div>
                            <p class="feedback-note">@f.MentorNotes</p>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="panel-empty">No feedback submitted yet.</p>
            }
        </section>

    </div>

    <div class="detail-footer">
        <a asp-area="Mentor" asp-controller="Trainees" asp-action="Index" class="btn-link-back">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
            Back to Trainees
        </a>
    </div>
</div>
