@using Rokhsetak.Areas.Mentor.ViewModels.Availability
@using Rokhsetak.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResourceMarker> L
@model List<MentorAvailabilityViewModel>

@{
    ViewData["Title"] = L["Mentor_MyAvailability"];

    var days = new[] { "monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday" };

    var grouped = days
        .Select(d => new
        {
            Day = d,
            Slots = Model
                .Where(s => s.DayOfWeek.ToLower() == d)
                .OrderBy(s => s.StartTime)
                .ToList()
        })
        .ToList();

    string Title(string s) => System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(s);
}

@section Styles {
    <link rel="stylesheet" href="~/css/availability.css" />
}
<div class="mentor-dashboard__inner">
<div class="avail-wrap">

    <header class="page-header">
        <p class="page-eyebrow"><i class="fa-regular fa-calendar-check" aria-hidden="true"></i> @L["Mentor_Schedule"]</p>
        <h1>@L["Mentor_MyAvailability"]</h1>
        <p class="page-lead">@L["Mentor_AvailabilityLead"]</p>
    </header>

    @* ── Flash messages ──────────────────────────────────── *@
    @if (TempData["Error"] != null)
    {
        <div class="flash flash-error" role="alert">
            <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
            <span>@TempData["Error"]</span>
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="flash flash-success" role="status">
            <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
            <span>@TempData["Success"]</span>
        </div>
    }

    @* ── Week grid ───────────────────────────────────────── *@
    <div class="week-grid">
        @foreach (var group in grouped)
        {
            <section class="day-card" aria-label="@string.Format(L["Mentor_DayAvailabilityAria"], Title(group.Day))">
                <div class="day-header">
                    <span class="day-name">@group.Day</span>
                    @if (group.Slots.Any())
                    {
                        <span class="day-count">@group.Slots.Count @(group.Slots.Count > 1 ? L["Mentor_SlotsPlural"] : L["Mentor_SlotsSingular"])</span>
                    }
                    else
                    {
                        <span class="day-count empty">@L["Mentor_NoSlots"]</span>
                    }
                </div>
                <div class="day-body">
                    @if (!group.Slots.Any())
                    {
                        <p class="no-slots">@L["Mentor_NoAvailabilityForDay"]</p>
                    }
                    else
                    {
                        @foreach (var slot in group.Slots)
                        {
                            <div class="slot-row">
                                <div class="slot-time">
                                    @slot.StartTime.ToString(@"hh\:mm tt")
                                    <span aria-hidden="true">→</span>
                                    @slot.EndTime.ToString(@"hh\:mm tt")
                                </div>

                                @if (slot.IsActive)
                                {
                                    <span class="slot-badge badge-active">@L["Mentor_Active"]</span>
                                }
                                else
                                {
                                    <span class="slot-badge badge-inactive">@L["Mentor_Inactive"]</span>
                                }

                                <div class="slot-actions">
                                    @* Edit — opens dialog, pre-filled via data-* read by availability.js *@
                                    <button type="button" class="btn-slot btn-edit js-edit-slot"
                                            data-slot-id="@slot.Id"
                                            data-day="@slot.DayOfWeek.ToLower()"
                                            data-start="@slot.StartTime.ToString(@"HH\:mm")"
                                            data-end="@slot.EndTime.ToString(@"HH\:mm")"
                                            aria-label="@string.Format(L["Mentor_EditSlotAria"], slot.StartTime.ToString(@"hh\:mm tt"), slot.EndTime.ToString(@"hh\:mm tt"))">
                                        <i class="fa-solid fa-pen" aria-hidden="true"></i>
                                        @L["Mentor_Edit"]
                                    </button>

                                    @* Deactivate — inline POST *@
                                    @if (slot.IsActive)
                                    {
                                        <form asp-area="Mentor" asp-controller="Availability" asp-action="DeactivateSlot"
                                              method="post" class="js-confirm" data-confirm="@L["Mentor_DeactivateConfirm"]">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="slotId" value="@slot.Id" />
                                            <button type="submit" class="btn-slot btn-deactivate">
                                                <i class="fa-solid fa-ban" aria-hidden="true"></i>
                                                @L["Mentor_Deactivate"]
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </section>
        }
    </div>

    @* ── Add slot form ───────────────────────────────────── *@
    <section class="add-card" aria-label="@L["Mentor_AddSlotSectionAria"]">
        <h2><i class="fa-solid fa-plus" aria-hidden="true"></i> @L["Mentor_AddNewSlot"]</h2>
        <form asp-area="Mentor" asp-controller="Availability" asp-action="AddSlot" method="post" class="js-time-form">
            @Html.AntiForgeryToken()
            <div class="form-row">
                <div class="form-group">
                    <label for="add-day">@L["Mentor_Day"]</label>
                    <select name="DayOfWeek" id="add-day" required aria-required="true">
                        <option value="" disabled selected>@L["Mentor_SelectDay"]</option>
                        @foreach (var d in days)
                        {
                            <option value="@d">@Title(d)</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label for="add-start">@L["Mentor_StartTime"]</label>
                    <input type="time" id="add-start" name="StartTime" required aria-required="true" />
                </div>

                <div class="form-group">
                    <label for="add-end">@L["Mentor_EndTime"]</label>
                    <input type="time" id="add-end" name="EndTime" required aria-required="true" />
                </div>

                <button type="submit" class="btn-primary">
                    <i class="fa-solid fa-circle-plus" aria-hidden="true"></i>
                    @L["Mentor_AddSlotButton"]
                </button>
            </div>
        </form>
    </section>

</div>
</div>

@* ── Edit dialog (native <dialog>, controlled by availability.js) ─────── *@
<dialog id="editDialog" class="avail-dialog" aria-labelledby="editDialogTitle">
    <form asp-area="Mentor" asp-controller="Availability" asp-action="EditSlot" method="post" class="js-time-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="slotId" id="edit-slot-id" />

        <div class="dialog-header">
            <h2 id="editDialogTitle"><i class="fa-solid fa-pen" aria-hidden="true"></i> @L["Mentor_EditSlot"]</h2>
            <button type="button" class="dialog-close js-dialog-close" aria-label="@L["Common_Close"]">
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
        </div>

        <div class="dialog-body">
            <div class="form-stack">
                <div class="form-group">
                    <label for="edit-day">@L["Mentor_Day"]</label>
                    <select name="DayOfWeek" id="edit-day" required aria-required="true">
                        @foreach (var d in days)
                        {
                            <option value="@d">@Title(d)</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label for="edit-start">@L["Mentor_StartTime"]</label>
                    <input type="time" id="edit-start" name="StartTime" required aria-required="true" />
                </div>

                <div class="form-group">
                    <label for="edit-end">@L["Mentor_EndTime"]</label>
                    <input type="time" id="edit-end" name="EndTime" required aria-required="true" />
                </div>
            </div>
        </div>

        <div class="dialog-footer">
            <button type="button" class="btn-ghost js-dialog-close">@L["Common_Cancel"]</button>
            <button type="submit" class="btn-primary">
                <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
                @L["Mentor_SaveChanges"]
            </button>
        </div>
    </form>
</dialog>

@section Scripts {
    <script src="~/js/availability.js" asp-append-version="true"></script>
}