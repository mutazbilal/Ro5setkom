@using Rokhsetak.Areas.Mentor.ViewModels.Availability
@model List<MentorAvailabilityViewModel>

@{
    ViewData["Title"] = "My Availability";

    var days = new[] { "monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday" };

    var grouped = days
        .Select(d => new
        {
            Day = d,
            Slots = Model
                .Where(s => s.DayOfWeek.ToLower() == d)
                .OrderBy(s => s.StartTime)
                .ToList()
        })
        .ToList();

    string Title(string s) => System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(s);
}

@section Styles {
    <link href="~/css/availability.css" rel="stylesheet" asp-append-version="true" />
}

<div class="avail-wrap">

    <header class="page-header">
        <p class="page-eyebrow"><i class="fa-regular fa-calendar-check" aria-hidden="true"></i> Schedule</p>
        <h1>My Availability</h1>
        <p class="page-lead">Set the time slots when trainees can book sessions with you. Active slots appear in their booking calendar instantly.</p>
    </header>

    @* ── Flash messages ──────────────────────────────────── *@
    @if (TempData["Error"] != null)
    {
        <div class="flash flash-error" role="alert">
            <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
            <span>@TempData["Error"]</span>
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="flash flash-success" role="status">
            <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
            <span>@TempData["Success"]</span>
        </div>
    }

    @* ── Week grid ───────────────────────────────────────── *@
    <div class="week-grid">
        @foreach (var group in grouped)
        {
            <section class="day-card" aria-label="@Title(group.Day) availability">
                <div class="day-header">
                    <span class="day-name">@group.Day</span>
                    @if (group.Slots.Any())
                    {
                        <span class="day-count">@group.Slots.Count slot@(group.Slots.Count > 1 ? "s" : "")</span>
                    }
                    else
                    {
                        <span class="day-count empty">No slots</span>
                    }
                </div>
                <div class="day-body">
                    @if (!group.Slots.Any())
                    {
                        <p class="no-slots">No availability set for this day.</p>
                    }
                    else
                    {
                        @foreach (var slot in group.Slots)
                        {
                            <div class="slot-row">
                                <div class="slot-time">
                                    @slot.StartTime.ToString(@"hh\:mm tt")
                                    <span aria-hidden="true">→</span>
                                    @slot.EndTime.ToString(@"hh\:mm tt")
                                </div>

                                @if (slot.IsActive)
                                {
                                    <span class="slot-badge badge-active">Active</span>
                                }
                                else
                                {
                                    <span class="slot-badge badge-inactive">Inactive</span>
                                }

                                <div class="slot-actions">
                                    @* Edit — opens dialog, pre-filled via data-* read by availability.js *@
                                    <button type="button" class="btn-slot btn-edit js-edit-slot"
                                            data-slot-id="@slot.Id"
                                            data-day="@slot.DayOfWeek.ToLower()"
                                            data-start="@slot.StartTime.ToString(@"HH\:mm")"
                                            data-end="@slot.EndTime.ToString(@"HH\:mm")"
                                            aria-label="Edit slot @slot.StartTime.ToString(@"hh\:mm tt") to @slot.EndTime.ToString(@"hh\:mm tt")">
                                        <i class="fa-solid fa-pen" aria-hidden="true"></i>
                                        Edit
                                    </button>

                                    @* Deactivate — inline POST *@
                                    @if (slot.IsActive)
                                    {
                                        <form asp-area="Mentor" asp-controller="Availability" asp-action="DeactivateSlot"
                                              method="post" class="js-confirm" data-confirm="Deactivate this slot?">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="slotId" value="@slot.Id" />
                                            <button type="submit" class="btn-slot btn-deactivate">
                                                <i class="fa-solid fa-ban" aria-hidden="true"></i>
                                                Deactivate
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </section>
        }
    </div>

    @* ── Add slot form ───────────────────────────────────── *@
    <section class="add-card" aria-label="Add new availability slot">
        <h2><i class="fa-solid fa-plus" aria-hidden="true"></i> Add New Slot</h2>
        <form asp-area="Mentor" asp-controller="Availability" asp-action="AddSlot" method="post" class="js-time-form">
            @Html.AntiForgeryToken()
            <div class="form-row">
                <div class="form-group">
                    <label for="add-day">Day</label>
                    <select name="DayOfWeek" id="add-day" required aria-required="true">
                        <option value="" disabled selected>Select day</option>
                        @foreach (var d in days)
                        {
                            <option value="@d">@Title(d)</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label for="add-start">Start time</label>
                    <input type="time" id="add-start" name="StartTime" required aria-required="true" />
                </div>

                <div class="form-group">
                    <label for="add-end">End time</label>
                    <input type="time" id="add-end" name="EndTime" required aria-required="true" />
                </div>

                <button type="submit" class="btn-primary">
                    <i class="fa-solid fa-circle-plus" aria-hidden="true"></i>
                    Add Slot
                </button>
            </div>
        </form>
    </section>

</div>

@* ── Edit dialog (native <dialog>, controlled by availability.js) ─────── *@
<dialog id="editDialog" class="avail-dialog" aria-labelledby="editDialogTitle">
    <form asp-area="Mentor" asp-controller="Availability" asp-action="EditSlot" method="post" class="js-time-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="slotId" id="edit-slot-id" />

        <div class="dialog-header">
            <h2 id="editDialogTitle"><i class="fa-solid fa-pen" aria-hidden="true"></i> Edit Slot</h2>
            <button type="button" class="dialog-close js-dialog-close" aria-label="Close dialog">
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
        </div>

        <div class="dialog-body">
            <div class="form-stack">
                <div class="form-group">
                    <label for="edit-day">Day</label>
                    <select name="DayOfWeek" id="edit-day" required aria-required="true">
                        @foreach (var d in days)
                        {
                            <option value="@d">@Title(d)</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label for="edit-start">Start time</label>
                    <input type="time" id="edit-start" name="StartTime" required aria-required="true" />
                </div>

                <div class="form-group">
                    <label for="edit-end">End time</label>
                    <input type="time" id="edit-end" name="EndTime" required aria-required="true" />
                </div>
            </div>
        </div>

        <div class="dialog-footer">
            <button type="button" class="btn-ghost js-dialog-close">Cancel</button>
            <button type="submit" class="btn-primary">
                <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
                Save Changes
            </button>
        </div>
    </form>
</dialog>

@section Scripts {
    <script src="~/js/availability.js" asp-append-version="true"></script>
}
