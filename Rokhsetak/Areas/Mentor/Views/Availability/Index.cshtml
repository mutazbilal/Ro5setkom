@using Rokhsetak.Areas.Mentor.ViewModels.Availability
@model List<MentorAvailabilityViewModel>

@{
    ViewData["Title"] = "My Availability";

    var days = new[] { "monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday" };

    var grouped = days
        .Select(d => new
        {
            Day = d,
            Slots = Model
                .Where(s => s.DayOfWeek.ToLower() == d)
                .OrderBy(s => s.StartTime)
                .ToList()
        })
        .ToList();
}

<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Syne:wght@600;700&display=swap" rel="stylesheet" />
<link href="~/css/availability.css" rel="stylesheet" />

<div class="avail-wrap">

    <div class="page-header">
        <h1>My Availability</h1>
        <p>Set the time slots when students can book sessions with you.</p>
    </div>

    @* ── Flash messages ──────────────────────────────────── *@
    @if (TempData["Error"] != null)
    {
        <div class="flash flash-error">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            @TempData["Error"]
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="flash flash-success">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            @TempData["Success"]
        </div>
    }

    @* ── Week grid ───────────────────────────────────────── *@
    <div class="week-grid">
        @foreach (var group in grouped)
        {
            <div class="day-card">
                <div class="day-header">
                    <span class="day-name">@group.Day</span>
                    @if (group.Slots.Any())
                    {
                        <span class="day-count">@group.Slots.Count slot@(group.Slots.Count > 1 ? "s" : "")</span>
                    }
                    else
                    {
                        <span class="day-count empty">No slots</span>
                    }
                </div>
                <div class="day-body">
                    @if (!group.Slots.Any())
                    {
                        <p class="no-slots">No availability set for this day.</p>
                    }
                    else
                    {
                        @foreach (var slot in group.Slots)
                        {
                            <div class="slot-row">
                                <div class="slot-time">
                                    @slot.StartTime.ToString(@"hh:mm tt")
                                    <span>→</span>
                                    @slot.EndTime.ToString(@"hh:mm tt")
                                </div>

                                @if (slot.IsActive)
                                {
                                    <span class="slot-badge badge-active">Active</span>
                                }
                                else
                                {
                                    <span class="slot-badge badge-inactive">Inactive</span>
                                }

                                <div class="slot-actions">
                                    @* Edit — opens modal pre-filled *@
                                    <button type="button" class="btn-edit"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editModal"
                                            data-slot-id="@slot.Id"
                                            data-day="@slot.DayOfWeek.ToLower()"
                                            data-start="@slot.StartTime.ToString(@"HH:mm")"
                                            data-end="@slot.EndTime.ToString(@"HH:mm")">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                        Edit
                                    </button>

                                    @* Deactivate — inline POST *@
                                    @if (slot.IsActive)
                                    {
                                        <form asp-arae="mentor" asp-action="DeactivateSlot" asp-controller="Availability"
                                              method="post" style="margin:0"
                                              onsubmit="return confirm('Deactivate this slot?')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="slotId" value="@slot.Id" />
                                            <button type="submit" class="btn-deactivate">
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                                                Deactivate
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    </div>

    @* ── Add slot form ───────────────────────────────────── *@
    <div class="add-card">
        <h2>+ Add New Slot</h2>
        <form asp-area="mentor" asp-action="AddSlot" asp-controller="Availability" method="post">
            @Html.AntiForgeryToken()
            <div class="form-row">
                <div class="form-group">
                    <label for="add-day">Day</label>
                    <select name="DayOfWeek" id="add-day" required>
                        <option value="" disabled selected>Select day</option>
                        @foreach (var d in days)
                        {
                            <option value="@d">@System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(d)</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label for="add-start">Start time</label>
                    <input type="time" id="add-start" name="StartTime" required />
                </div>

                <div class="form-group">
                    <label for="add-end">End time</label>
                    <input type="time" id="add-end" name="EndTime" required />
                </div>

                <button type="submit" class="btn-primary">Add Slot</button>
            </div>
        </form>
    </div>

</div>

@* ── Edit modal ──────────────────────────────────────────── *@
<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editModalLabel">Edit Slot</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-area="mentor" asp-action="EditSlot" asp-controller="Availability" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="slotId" id="edit-slot-id" />
                <div class="modal-body">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="edit-day">Day</label>
                            <select name="DayOfWeek" id="edit-day" required>
                                @foreach (var d in days)
                                {
                                    <option value="@d">@System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(d)</option>
                                }
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="edit-start">Start time</label>
                            <input type="time" id="edit-start" name="StartTime" required />
                        </div>

                        <div class="form-group">
                            <label for="edit-end">End time</label>
                            <input type="time" id="edit-end" name="EndTime" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Pre-fill edit modal from data attributes on the Edit button
    document.getElementById('editModal').addEventListener('show.bs.modal', function (e) {
        var btn = e.relatedTarget;
        document.getElementById('edit-slot-id').value = btn.dataset.slotId;
        document.getElementById('edit-start').value   = btn.dataset.start;
        document.getElementById('edit-end').value     = btn.dataset.end;

        var daySelect = document.getElementById('edit-day');
        for (var i = 0; i < daySelect.options.length; i++) {
            if (daySelect.options[i].value === btn.dataset.day) {
                daySelect.selectedIndex = i;
                break;
            }
        }
    });

    // Basic client-side validation: end must be after start
    function validateTimes(startId, endId) {
        var start = document.getElementById(startId).value;
        var end   = document.getElementById(endId).value;
        if (start && end && end <= start) {
            alert('End time must be after start time.');
            return false;
        }
        return true;
    }

    document.querySelector('[asp-action="AddSlot"]') // resolved at runtime;
    // Attach via native form query instead:
    document.querySelectorAll('form').forEach(function(form) {
        form.addEventListener('submit', function(e) {
            var s = form.querySelector('input[name="StartTime"]');
            var en = form.querySelector('input[name="EndTime"]');
            if (s && en && en.value && s.value && en.value <= s.value) {
                e.preventDefault();
                alert('End time must be after start time.');
            }
        });
    });
</script>
}
