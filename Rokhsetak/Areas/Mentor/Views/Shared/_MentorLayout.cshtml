@using System.Globalization
@using System.Security.Claims
@using Rokhsetak.Resources
@using Microsoft.Extensions.Localization
@inject Rokhsetak.Services.Interfaces.INotificationService NotificationService
@inject IStringLocalizer<SharedResourceMarker> L
@{
    ViewData["HideNav"] = true;
    var active = ViewData["ActiveNav"] as string ?? "";

    var currentLang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var pageTitle = ViewData["Title"] as string ?? L["Mentor_Layout_Title"];
    var culture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var dir = culture == "ar" ? "rtl" : "ltr";

    // Notifications
    var userIdClaim = User.FindFirstValue(ClaimTypes.NameIdentifier);
    int userId = 0;

    if (!string.IsNullOrEmpty(userIdClaim))
        int.TryParse(userIdClaim, out userId);

    var notifications = new List<Rokhsetak.Models.Notification>();
    var unreadCount = 0;

    if (userId > 0)
    {
        notifications = await NotificationService.GetUserNotificationsAsync(userId);
        unreadCount = await NotificationService.GetUnreadCountAsync(userId);
    }
}

<!DOCTYPE html>
<html lang="en" dir=@dir>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@pageTitle · Rokhsetak</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@500;600;700&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet" href="~/css/mentor-shared.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth-shared.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>

<body>

    <div class="mentor-shell">

        <!-- Sidebar -->
        <aside class="mentor-sidebar" aria-label="@L["Mentor_NavigationAria"]">
                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Index"
                   class="mentor-sidebar__brand"
                   aria-label="Rokhsetak — @L["Nav_Home"]">

                    <img src="~/images/logo.png"
                         asp-append-version="true"
                         alt="Rokhsetak"
                         class="mentor-sidebar__logo-img" />
                </a>
            @* ── Notifications ── *@
                <div class="notif" id="rk-notif">
                    <button type="button"
                            class="notif__trigger landing-nav__link"
                            color="white"
                            id="rk-notif-btn"
                            aria-haspopup="true"
                            aria-expanded="false"
                            aria-controls="rk-notif-panel"
                            aria-label="@L["Nav_Notifications"]">
                        <i class="fa-solid fa-bell" aria-hidden="true"></i>
                        @if (unreadCount > 0)
                        {
                            <span class="notif__badge" aria-label="@unreadCount @L["Nav_UnreadNotifications"]">
                                @(unreadCount > 9 ? "9+" : unreadCount.ToString())
                            </span>
                        }
                    </button>

                    <div class="notif__panel" id="rk-notif-panel" role="dialog" aria-labelledby="rk-notif-btn" hidden>
                        <div class="notif__head">
                            <span class="notif__head-title">@L["Nav_Notifications"]</span>
                            @if (unreadCount > 0)
                            {
                                <span class="notif__head-count">@unreadCount</span>
                            }
                        </div>

                        <ul class="notif__list" role="list">
                            @if (notifications.Any())
                            {
                                foreach (var n in notifications)
                                {
                                    <li class="notif__item @(n.IsRead ? "notif__item--read" : "notif__item--unread")">
                                        <div class="notif__item-body">
                                            @if (!n.IsRead)
                                            {
                                                <span class="notif__dot" aria-hidden="true"></span>
                                            }
                                            <div class="notif__item-text">
                                                <span class="notif__item-title">@n.Title</span>
                                                <span class="notif__item-msg">@n.Message</span>
                                                <span class="notif__item-time">@n.CreatedAt?.ToString("g")</span>
                                            </div>
                                        </div>
                                        @if (!n.IsRead)
                                        {
                                            <button type="button"
                                                    class="notif__mark-btn"
                                                    data-notification-id="@n.NotificationId"
                                                    aria-label="@L["Nav_MarkAsReadAria"]"
                                                    title="@L["Nav_MarkAsRead"]">
                                                <i class="fa-solid fa-check" aria-hidden="true"></i>
                                            </button>
                                        }
                                    </li>
                                }
                            }
                            else
                            {
                                <li class="notif__empty">
                                    <i class="fa-regular fa-bell-slash" aria-hidden="true"></i>
                                    <span>@L["Nav_NoNotifications"]</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

            <nav class="mentor-sidebar__nav" aria-label="@L["Mentor_SectionsAria"]">

                <span class="mentor-sidebar__heading">
                    @L["Mentor_ManageHeading"]
                </span>

                <ul class="mentor-sidebar__list">

                    <li>
                        <a asp-area="Mentor"
                           asp-controller="Dashboard"
                           asp-action="Index"
                           class="mentor-sidebar__link @(active == "dashboard" ? "is-active" : "")">

                            <i class="fa-solid fa-gauge-high" aria-hidden="true"></i>
                            <span>@L["Nav_Dashboard"]</span>
                        </a>
                    </li>

                    <li>
                        <a asp-area="Mentor"
                           asp-controller="Availability"
                           asp-action="Index"
                           class="mentor-sidebar__link @(active == "availability" ? "is-active" : "")">

                            <i class="fa-solid fa-clock" aria-hidden="true"></i>
                            <span>@L["Mentor_Availability"]</span>
                        </a>
                    </li>

                    <li>
                        <a asp-area="Mentor"
                           asp-controller="Appointments"
                           asp-action="Index"
                           class="mentor-sidebar__link @(active == "appointments" ? "is-active" : "")">

                            <i class="fa-solid fa-calendar-check" aria-hidden="true"></i>
                            <span>@L["Mentor_Appointments"]</span>
                        </a>
                    </li>

                    <li>
                        <a asp-area="Mentor"
                           asp-controller="Trainees"
                           asp-action="Index"
                           class="mentor-sidebar__link @(active == "trainees" ? "is-active" : "")">

                            <i class="fa-solid fa-user-group" aria-hidden="true"></i>
                            <span>@L["Mentor_Trainees"]</span>
                        </a>
                    </li>

                </ul>
            </nav>

            <div class="mentor-sidebar__footer">

                <div class="mentor-sidebar__lang"
                     role="group"
                     aria-label="@L["Mentor_LanguageGroupAria"]">

                    <form asp-area=""
                          asp-controller="Profile"
                          asp-action="ChangeLanguage"
                          method="post"
                          class="mentor-sidebar__lang-form">

                        @Html.AntiForgeryToken()

                        <input type="hidden" name="language" value="en" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />

                        <button type="submit"
                                class="mentor-sidebar__lang-btn @(currentLang == "en" ? "is-active" : null)">
                            EN
                        </button>
                    </form>

                    <form asp-area=""
                          asp-controller="Profile"
                          asp-action="ChangeLanguage"
                          method="post"
                          class="mentor-sidebar__lang-form">

                        @Html.AntiForgeryToken()

                        <input type="hidden" name="language" value="ar" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />

                        <button type="submit"
                                class="mentor-sidebar__lang-btn @(currentLang == "ar" ? "is-active" : null)">
                            AR
                        </button>
                    </form>

                </div>

                <a asp-area=""
                   asp-controller="Profile"
                   asp-action="Index"
                   class="mentor-sidebar__link">

                    <i class="fa-solid fa-user" aria-hidden="true"></i>
                    <span>@L["Nav_Profile"]</span>
                </a>

                <form asp-area=""
                      asp-controller="Auth"
                      asp-action="Logout"
                      method="post"
                      class="mentor-sidebar__logout-form">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="mentor-sidebar__link mentor-sidebar__link--logout">

                        <i class="fa-solid fa-arrow-right-from-bracket"
                           aria-hidden="true"></i>

                        <span>@L["Nav_Logout"]</span>
                    </button>

                </form>

            </div>

        </aside>

        <!-- Main page content -->
        <main class="mentor-dashboard">
            @RenderBody()
        </main>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/notifications.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>