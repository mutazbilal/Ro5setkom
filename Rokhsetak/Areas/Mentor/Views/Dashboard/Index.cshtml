@model MentorDashboardViewModel
@{
    ViewData["Title"] = "Mentor Dashboard";
}

<div class="container-fluid py-4">

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Header row -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-0">Mentor Dashboard</h2>
            <p class="text-muted mb-0">
                <i class="bi bi-calendar-date"></i>
                @Model.Today.ToString("dddd, dd MMMM yyyy")
            </p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-area="Mentor" asp-controller="Appointments" asp-action="Index"
                   class="btn btn-outline-primary position-relative">
                <i class="bi bi-calendar-check"></i> All Appointments
                @if (Model.TotalPendingCount > 0)
                {
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                        @Model.TotalPendingCount
                    </span>
                }
            </a>
            <a asp-area="Mentor" asp-controller="Trainees" asp-action="Index"
                   class="btn btn-outline-secondary">
                <i class="bi bi-people"></i> Trainees Summary
            </a>
            <a asp-area="Mentor" asp-controller="Availability" asp-action="Index"
                   class="btn btn-outline-secondary">
                <i class="bi bi-people"></i> Set Availability
            </a>
        </div>
    </div>

    <!-- Stats row -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card text-center border-0 shadow-sm h-100">
                <div class="card-body py-3">
                    <div class="display-6 fw-bold text-warning">@Model.TotalPendingCount</div>
                    <div class="text-muted small">Pending Requests</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center border-0 shadow-sm h-100">
                <div class="card-body py-3">
                    <div class="display-6 fw-bold text-success">@Model.TotalConfirmedUpcomingCount</div>
                    <div class="text-muted small">Upcoming Confirmed</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center border-0 shadow-sm h-100">
                <div class="card-body py-3">
                    <div class="display-6 fw-bold text-primary">@Model.TodaysConfirmedSessions.Count</div>
                    <div class="text-muted small">Today's Sessions</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center border-0 shadow-sm h-100">
                <div class="card-body py-3">
                    <div class="display-6 fw-bold text-info">@Model.TodaysAvailabilitySlots.Count</div>
                    <div class="text-muted small">Available Slots Today</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">

        <!-- Today's Schedule -->
        <div class="col-lg-8">
            <div class="card shadow-sm h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">
                        <i class="bi bi-clock-history text-primary"></i> Today's Schedule
                    </span>
                    <span class="badge bg-primary">@Model.TodaysConfirmedSessions.Count confirmed</span>
                </div>

                @if (Model.TodaysConfirmedSessions.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Time</th>
                                    <th>Trainee</th>
                                    <th>Type</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in Model.TodaysConfirmedSessions)
                                {
                                    <tr>
                                        <td>
                                            <span class="fw-semibold">@s.StartTime.ToString("HH:mm")</span>
                                            <span class="text-muted">– @s.EndTime.ToString("HH:mm")</span>
                                        </td>
                                        <td>
                                            <a asp-area="Mentor" asp-controller="Trainees"
                                                   asp-action="Detail" asp-route-id="@s.TraineeId"
                                                   class="text-decoration-none fw-semibold">
                                                @s.TraineeName
                                            </a>
                                        </td>
                                        <td>
                                            <span class="badge @(s.SessionType == "practical" ? "bg-warning text-dark" : "bg-info text-dark")">
                                                @s.SessionType
                                            </span>
                                        </td>
                                        <td>
                                            @if (s.CanMarkDone)
                                            {
                                                <form asp-area="Mentor" asp-controller="Appointments"
                                                      asp-action="MarkDone" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="bookingId" value="@s.BookingId" />
                                                    <button class="btn btn-success btn-sm">
                                                        <i class="bi bi-check2-circle"></i> Mark Done
                                                    </button>
                                                </form>
                                            }
                                            @if (s.CanFeedback)
                                            {
                                                <a asp-area="Mentor" asp-controller="Appointments"
                                                       asp-action="Feedback" asp-route-bookingId="@s.BookingId"
                                                       class="btn btn-outline-secondary btn-sm ms-1">
                                                    <i class="bi bi-chat-left-text"></i> Feedback
                                                </a>
                                            }
                                            @if (s.FeedbackGiven)
                                            {
                                                <span class="badge bg-success ms-1">Feedback ✓</span>
                                            }
                                            @if (!s.CanMarkDone && !s.CanFeedback && !s.FeedbackGiven)
                                            {
                                                <span class="text-muted small">In session</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="card-body text-center text-muted py-5">
                        <i class="bi bi-calendar-x fs-1 d-block mb-2"></i>
                        No confirmed sessions for today.
                    </div>
                }
            </div>
        </div>

        <!-- Availability + Pending -->
        <div class="col-lg-4 d-flex flex-column gap-3">

            <!-- Today's Availability -->
            <div class="card shadow-sm">
                <div class="card-header fw-semibold">
                    <i class="bi bi-clock text-success"></i> Today's Availability Slots
                </div>
                @if (Model.TodaysAvailabilitySlots.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var slot in Model.TodaysAvailabilitySlots)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>
                                    @slot.StartTime.ToString("HH:mm") – @slot.EndTime.ToString("HH:mm")
                                </span>
                                @if (slot.IsBooked)
                                {
                                    <span class="badge bg-secondary">Booked</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Free</span>
                                }
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="card-body text-center text-muted small py-3">
                        No availability slots set for today.
                    </div>
                }
            </div>

            <!-- Pending Bookings -->
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">
                        <i class="bi bi-hourglass-split text-warning"></i> Pending Requests
                    </span>
                    @if (Model.PendingBookings.Any())
                    {
                        <span class="badge bg-warning text-dark">@Model.PendingBookings.Count</span>
                    }
                </div>

                @if (Model.PendingBookings.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var p in Model.PendingBookings.Take(5))
                        {
                            <li class="list-group-item">
                                <div class="fw-semibold small">@p.TraineeName</div>
                                <div class="text-muted small">
                                    @p.BookingDate.ToString("dd MMM")
                                    @p.StartTime.ToString("HH:mm") – @p.EndTime.ToString("HH:mm")
                                </div>
                                <div class="d-flex gap-1 mt-1">
                                    <form asp-area="Mentor" asp-controller="Appointments"
                                          asp-action="Confirm" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="bookingId" value="@p.BookingId" />
                                        <button class="btn btn-success btn-sm py-0">✓ Confirm</button>
                                    </form>
                                    <a asp-area="Mentor" asp-controller="Appointments"
                                           asp-action="Reschedule" asp-route-bookingId="@p.BookingId"
                                           class="btn btn-outline-secondary btn-sm py-0">
                                        ↺ Reschedule
                                    </a>
                                </div>
                            </li>
                        }
                    </ul>
                    @if (Model.PendingBookings.Count > 5)
                    {
                        <div class="card-footer text-center">
                            <a asp-area="Mentor" asp-controller="Appointments" asp-action="Index"
                                   class="small text-decoration-none">
                                View all @Model.PendingBookings.Count pending →
                            </a>
                        </div>
                    }
                }
                else
                {
                    <div class="card-body text-center text-muted small py-3">
                        No pending requests.
                    </div>
                }
            </div>

        </div>
    </div>
</div>