@using Rokhsetak.Areas.Mentor.ViewModels.Dashboard
@model MentorDashboardViewModel
@{
    ViewData["Title"] = "Mentor Dashboard";

    var nowTime = TimeOnly.FromDateTime(DateTime.Now);

    // ---- Sessions: sorted chronologically; "up next" = next non-completed session still ahead ----
    var sessions      = Model.TodaysConfirmedSessions.OrderBy(s => s.StartTime).ToList();
    var sessionsCount = sessions.Count;
    var sessionsDone  = sessions.Count(s => s.FeedbackGiven);
    var sessionsPct   = sessionsCount > 0
                            ? (int)Math.Round(100.0 * sessionsDone / sessionsCount)
                            : 0;
    var upNextSessionIdx = sessions.FindIndex(s => !s.FeedbackGiven && s.StartTime > nowTime);

    // ---- Availability: sorted chronologically; "up next" = next free slot still ahead ----
    var slots       = Model.TodaysAvailabilitySlots.OrderBy(a => a.StartTime).ToList();
    var slotsCount  = slots.Count;
    var slotsBooked = slots.Count(a => a.IsBooked);
    var slotsPct    = slotsCount > 0
                            ? (int)Math.Round(100.0 * slotsBooked / slotsCount)
                            : 0;
    var upNextSlotIdx = slots.FindIndex(a => !a.IsBooked && a.StartTime > nowTime);

    // ---- Headline utilization (mirrors the trainee dashboard's % progress metric) ----
    var utilizationPct = slotsPct;

    // ---- "Next session" footer text (mirrors the trainee dashboard's NextMilestone) ----
    var nextSession = sessions.FirstOrDefault(s => s.StartTime > nowTime);
    string nextSessionText;
    if (nextSession != null)
    {
        nextSessionText = $"{nextSession.StartTime:HH\\:mm} — {nextSession.TraineeName}";
    }
    else if (sessions.Any())
    {
        nextSessionText = "All sessions for today have started";
    }
    else
    {
        nextSessionText = "No sessions scheduled for today";
    }

    var pendingCount = Model.TotalPendingCount;
    // mock-exam state variants: --ready triggers the gold pulse on the gradient CTA, --completed mutes it
    var pendingState = pendingCount > 0 ? "ready" : "completed";

    // ---- Dashboard shell: hide the global top navbar, drive nav from the sidebar instead ----
    ViewData["HideNav"] = true;
    var currentLang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

@functions {
    /// <summary>
    /// Maps a session's action-availability flags to (icon, BEM modifier, label).
    /// Modifiers align with the existing status-pill variants:
    /// completed (green), up-next (orange/gold), in-progress (navy), pending (grey).
    /// </summary>
    (string iconClass, string modifier, string label) SessionStatus(SessionCardViewModel s)
    {
        if (s.FeedbackGiven) return ("fa-solid fa-circle-check",  "completed",   "complete");
        if (s.CanMarkDone)   return ("fa-solid fa-bolt",          "up-next",     "ready");
        if (s.CanFeedback)   return ("fa-solid fa-comment-dots",  "in-progress", "feedback");
        return ("fa-regular fa-clock", "pending", "scheduled");
    }

    /// <summary>
    /// Maps an availability slot's booked flag to (icon, BEM modifier, label).
    /// "free" reuses the --completed (green) treatment because availability is a positive state.
    /// </summary>
    (string iconClass, string modifier, string label) SlotStatus(AvailabilitySlotViewModel slot)
        => slot.IsBooked
            ? ("fa-solid fa-circle-check", "in-progress", "booked")
            : ("fa-regular fa-circle",     "completed",   "free");
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" />
}

<div class="mentor-shell">

    @* ============ Sidebar ============ *@
    <aside class="mentor-sidebar" aria-label="Mentor navigation">
        <a asp-area="" asp-controller="Home" asp-action="Index"
           class="mentor-sidebar__brand" aria-label="Rokhsetak — Home">
            <span class="mentor-sidebar__logo" aria-hidden="true">
                <i class="fa-solid fa-shield-halved"></i>
            </span>
            <span class="mentor-sidebar__brand-name">Rokhsetak</span>
        </a>

        <nav class="mentor-sidebar__nav" aria-label="Mentor sections">
            <span class="mentor-sidebar__heading">Manage</span>
            <ul class="mentor-sidebar__list">
                <li>
                    <a asp-area="Mentor" asp-controller="Dashboard" asp-action="Index"
                       class="mentor-sidebar__link is-active" aria-current="page">
                        <i class="fa-solid fa-gauge-high" aria-hidden="true"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li>
                    <a asp-area="Mentor" asp-controller="Availability" asp-action="Index"
                       class="mentor-sidebar__link">
                        <i class="fa-solid fa-clock" aria-hidden="true"></i>
                        <span>Availability</span>
                    </a>
                </li>
                <li>
                    <a asp-area="Mentor" asp-controller="Appointments" asp-action="Index"
                       class="mentor-sidebar__link">
                        <i class="fa-solid fa-calendar-check" aria-hidden="true"></i>
                        <span>Appointments</span>
                        @if (pendingCount > 0)
                        {
                            <span class="mentor-sidebar__badge" aria-label="@pendingCount pending">@pendingCount</span>
                        }
                    </a>
                </li>
                <li>
                    <a asp-area="Mentor" asp-controller="Trainees" asp-action="Index"
                       class="mentor-sidebar__link">
                        <i class="fa-solid fa-user-group" aria-hidden="true"></i>
                        <span>Trainees</span>
                    </a>
                </li>
            </ul>
        </nav>

        <div class="mentor-sidebar__footer">
            <div class="mentor-sidebar__lang" role="group" aria-label="Language">
                <form asp-area="" asp-controller="Profile" asp-action="ChangeLanguage"
                      method="post" class="mentor-sidebar__lang-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="language" value="en" />
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button type="submit"
                            class="mentor-sidebar__lang-btn @(currentLang == "en" ? "is-active" : null)"
                            aria-pressed="@(currentLang == "en" ? "true" : "false")">EN</button>
                </form>
                <form asp-area="" asp-controller="Profile" asp-action="ChangeLanguage"
                      method="post" class="mentor-sidebar__lang-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="language" value="ar" />
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button type="submit"
                            class="mentor-sidebar__lang-btn @(currentLang == "ar" ? "is-active" : null)"
                            aria-pressed="@(currentLang == "ar" ? "true" : "false")">AR</button>
                </form>
            </div>

            <a asp-area="" asp-controller="Profile" asp-action="Index" class="mentor-sidebar__link">
                <i class="fa-solid fa-user" aria-hidden="true"></i>
                <span>Profile</span>
            </a>

            <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post" class="mentor-sidebar__logout-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="mentor-sidebar__link mentor-sidebar__link--logout">
                    <i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i>
                    <span>Log out</span>
                </button>
            </form>
        </div>
    </aside>

    @* ============ Main ============ *@
    <div class="mentor-dashboard">
        <div class="mentor-dashboard__inner">

        @if (TempData["Error"] != null)
        {
            <div class="alert dashboard-alert dashboard-alert--error" role="alert">
                <i class="fa-solid fa-triangle-exclamation dashboard-alert__icon" aria-hidden="true"></i>
                <span class="dashboard-alert__message">@TempData["Error"]</span>
                <button type="button"
                        class="dashboard-alert__close"
                        data-alert-dismiss
                        aria-label="Close">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert dashboard-alert dashboard-alert--success" role="alert">
                <i class="fa-solid fa-circle-check dashboard-alert__icon" aria-hidden="true"></i>
                <span class="dashboard-alert__message">@TempData["Success"]</span>
                <button type="button"
                        class="dashboard-alert__close"
                        data-alert-dismiss
                        aria-label="Close">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
        }

        <!-- ============ Hero ============ -->
        <section class="dashboard-hero" aria-labelledby="dashboard-title">
            <div class="dashboard-hero__intro">
                <span class="dashboard-hero__eyebrow">Mentor Dashboard</span>
                <h1 id="dashboard-title" class="dashboard-hero__title">Your Day at a Glance</h1>
                <div class="dashboard-hero__meta">
                    <span class="chip chip--primary" aria-label="Today's date">
                        <i class="fa-solid fa-calendar-day" aria-hidden="true"></i>
                        @Model.Today.ToString("dddd, dd MMM")
                    </span>
                    @if (pendingCount > 0)
                    {
                        <span class="chip chip--soft" aria-label="Pending requests">
                            <i class="fa-solid fa-hourglass-half" aria-hidden="true"></i>
                            @pendingCount Pending
                        </span>
                    }
                    else
                    {
                        <span class="chip chip--soft" aria-label="Inbox status">
                            <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
                            All caught up
                        </span>
                    }
                </div>
            </div>

            <div class="dashboard-hero__cta">
                <a asp-area="Mentor"
                   asp-controller="Availability"
                   asp-action="Index"
                   class="btn-action btn-action--outline">
                    <i class="fa-solid fa-clock" aria-hidden="true"></i>
                    <span>Set Availability</span>
                </a>
            </div>
        </section>

        <!-- ============ Today's Snapshot (Progress Card analog) ============ -->
        <section class="progress-card" aria-labelledby="snapshot-card-label">
            <div class="progress-card__head">
                <div>
                    <span id="snapshot-card-label" class="progress-card__label">Today's Snapshot</span>
                    <p class="progress-card__sublabel">
                        @if (slotsCount > 0)
                        {
                            <text>@slotsBooked of @slotsCount slots booked today</text>
                        }
                        else
                        {
                            <text>No availability set for today</text>
                        }
                    </p>
                </div>
                <div class="progress-card__percent" aria-hidden="true">
                    <span class="progress-card__percent-num">@utilizationPct</span><span class="progress-card__percent-sym">%</span>
                </div>
            </div>

            <div class="progress-card__bar"
                 role="progressbar"
                 aria-valuenow="@utilizationPct"
                 aria-valuemin="0"
                 aria-valuemax="100"
                 aria-label="Slot utilization today">
                <div class="progress-card__bar-fill" style="--progress-value: @(utilizationPct)%"></div>
            </div>

            <div class="progress-card__next">
                <span class="progress-card__next-icon" aria-hidden="true">
                    <i class="fa-solid fa-forward"></i>
                </span>
                <span class="progress-card__next-text">
                    <span class="progress-card__next-label">Next session</span>
                    <span class="progress-card__next-value">@nextSessionText</span>
                </span>
            </div>
        </section>

        <!-- ============ Tracks (Sessions + Availability) ============
             Reuses the existing track-card colour variants for visual parity:
             --theory    → navy gradient header   → used here for "Today's Sessions"
             --practical → orange/gold gradient   → used here for "Today's Availability"
        -->
        <div class="tracks-grid">

            <!-- Track 01: Today's Sessions -->
            <section class="track-card track-card--theory" aria-labelledby="track-sessions-title">
                <header class="track-card__header">
                    <span class="track-card__icon" aria-hidden="true">
                        <i class="fa-solid fa-calendar-check"></i>
                    </span>
                    <div class="track-card__headings">
                        <p class="track-card__eyebrow">Track 01</p>
                        <h2 id="track-sessions-title" class="track-card__title">Today's Sessions</h2>
                    </div>
                    <span class="track-card__count" aria-label="Sessions today">
                        @sessionsCount
                    </span>
                </header>

                <div class="track-card__progress">
                    <div class="track-card__progress-row">
                        <span class="track-card__progress-label">
                            @sessionsDone of @sessionsCount complete
                        </span>
                        <span class="track-card__progress-value">@sessionsPct%</span>
                    </div>
                    <div class="track-card__progress-bar"
                         role="progressbar"
                         aria-valuenow="@sessionsPct" aria-valuemin="0" aria-valuemax="100"
                         aria-label="Sessions completion">
                        <div class="track-card__progress-fill"
                             style="--track-progress: @(sessionsPct)%"></div>
                    </div>
                </div>

                <ul class="module-list">
                    @for (var i = 0; i < sessions.Count; i++)
                    {
                        var s        = sessions[i];
                        var p        = SessionStatus(s);
                        var isUpNext = i == upNextSessionIdx;
                        var itemCls  = $"module-item module-item--{p.modifier}"
                                       + (isUpNext ? " module-item--up-next" : "");
                        <li class="@itemCls">
                            <div class="module-item__main">
                                <span class="module-item__status-icon module-item__status-icon--@p.modifier" aria-hidden="true">
                                    <i class="@p.iconClass"></i>
                                </span>
                                <span class="module-item__title">
                                    @s.StartTime.ToString("HH:mm") — @s.TraineeName
                                </span>
                            </div>
                            @if (isUpNext)
                            {
                                <span class="status-pill status-pill--up-next">up next</span>
                            }
                            else
                            {
                                <span class="status-pill status-pill--@p.modifier">@p.label</span>
                            }
                        </li>
                    }
                    @if (!sessions.Any())
                    {
                        <li class="module-list__empty">
                            <i class="fa-regular fa-calendar" aria-hidden="true"></i>
                            <span>No confirmed sessions for today.</span>
                        </li>
                    }
                </ul>
            </section>

            <!-- Track 02: Today's Availability -->
            <section class="track-card track-card--practical" aria-labelledby="track-availability-title">
                <header class="track-card__header">
                    <span class="track-card__icon" aria-hidden="true">
                        <i class="fa-solid fa-clock"></i>
                    </span>
                    <div class="track-card__headings">
                        <p class="track-card__eyebrow">Track 02</p>
                        <h2 id="track-availability-title" class="track-card__title">Today's Availability</h2>
                    </div>
                    <span class="track-card__count" aria-label="Slots today">
                        @slotsCount
                    </span>
                </header>

                <div class="track-card__progress">
                    <div class="track-card__progress-row">
                        <span class="track-card__progress-label">
                            @slotsBooked of @slotsCount booked
                        </span>
                        <span class="track-card__progress-value">@slotsPct%</span>
                    </div>
                    <div class="track-card__progress-bar"
                         role="progressbar"
                         aria-valuenow="@slotsPct" aria-valuemin="0" aria-valuemax="100"
                         aria-label="Slot utilization">
                        <div class="track-card__progress-fill"
                             style="--track-progress: @(slotsPct)%"></div>
                    </div>
                </div>

                <ul class="module-list">
                    @for (var i = 0; i < slots.Count; i++)
                    {
                        var slot     = slots[i];
                        var p        = SlotStatus(slot);
                        var isUpNext = i == upNextSlotIdx;
                        var itemCls  = $"module-item module-item--{p.modifier}"
                                       + (isUpNext ? " module-item--up-next" : "");
                        <li class="@itemCls">
                            <div class="module-item__main">
                                <span class="module-item__status-icon module-item__status-icon--@p.modifier" aria-hidden="true">
                                    <i class="@p.iconClass"></i>
                                </span>
                                <span class="module-item__title">
                                    @slot.StartTime.ToString("HH:mm") – @slot.EndTime.ToString("HH:mm")
                                </span>
                            </div>
                            @if (isUpNext)
                            {
                                <span class="status-pill status-pill--up-next">up next</span>
                            }
                            else
                            {
                                <span class="status-pill status-pill--@p.modifier">@p.label</span>
                            }
                        </li>
                    }
                    @if (!slots.Any())
                    {
                        <li class="module-list__empty">
                            <i class="fa-regular fa-clock" aria-hidden="true"></i>
                            <span>No availability set for today.</span>
                        </li>
                    }
                </ul>
            </section>
        </div>

        <!-- ============ Pending Requests (Mock-exam analog) ============ -->
        <section class="mock-exam mock-exam--@pendingState" aria-labelledby="pending-card-title">
            <div class="mock-exam__decor" aria-hidden="true"></div>

            <div class="mock-exam__main">
                <span class="mock-exam__icon" aria-hidden="true">
                    <i class="fa-solid @(pendingCount > 0 ? "fa-hourglass-half" : "fa-inbox")"></i>
                </span>
                <div class="mock-exam__text">
                    <p class="mock-exam__eyebrow">Awaiting Response</p>
                    <h2 id="pending-card-title" class="mock-exam__title">Pending Requests</h2>
                    <p class="mock-exam__caption">
                        @if (pendingCount > 0)
                        {
                            <i class="fa-solid fa-bolt mock-exam__caption-icon" aria-hidden="true"></i>
                            <span>@pendingCount @(pendingCount == 1 ? "request" : "requests") awaiting your response.</span>
                        }
                        else
                        {
                            <i class="fa-solid fa-circle-check mock-exam__caption-icon" aria-hidden="true"></i>
                            <span>All caught up — no pending requests right now.</span>
                        }
                    </p>
                </div>
            </div>

            <div class="mock-exam__action">
                @if (pendingCount > 0)
                {
                    <a asp-area="Mentor"
                       asp-controller="Appointments"
                       asp-action="Index"
                       class="btn-action btn-action--gradient">
                        <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                        <span>Review Requests</span>
                    </a>
                }
                else
                {
                    <a asp-area="Mentor"
                       asp-controller="Appointments"
                       asp-action="Index"
                       class="btn-action btn-action--ghost-success">
                        <i class="fa-solid fa-calendar" aria-hidden="true"></i>
                        <span>View Appointments</span>
                    </a>
                }
            </div>
        </section>

    </div>
</div>
</div>

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
