@using Rokhsetak.Areas.Admin.ViewModels.Users
@model UserDetailViewModel
@{
    ViewData["Title"] = Model.FullName;
    ViewData["Subtitle"] = $"User profile · {Model.Role}";
    ViewData["ActiveNav"] = "users";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var initials = string.Join("", Model.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0])).ToUpper();
}

<div class="detail-layout">
    @* ── Profile sidebar ──────────────────────────────────── *@
    <div class="admin-card admin-card--padded">
        <div class="admin-profile">
            <div class="admin-profile__avatar" aria-hidden="true">@initials</div>
            <h2 class="admin-profile__name">@Model.FullName</h2>
            <p class="admin-profile__email">@Model.Email</p>
            <div class="admin-profile__badges">
                <span class="admin-pill admin-pill--role">@Model.Role</span>
                @if (Model.IsActive)
                { <span class="admin-pill admin-pill--success">Active</span> }
                else
                { <span class="admin-pill admin-pill--danger">Inactive</span> }
            </div>
        </div>

        <hr class="admin-divider" />
        <dl class="admin-detail-list">
            <dt>Phone</dt>        <dd>@(Model.PhoneNumber ?? "—")</dd>
            <dt>National ID</dt>  <dd>@(Model.NationalId ?? "—")</dd>
            <dt>Date of birth</dt><dd>@(Model.DateOfBirth?.ToString("dd MMM yyyy") ?? "—")</dd>
            <dt>Gender</dt>       <dd>@(Model.Gender ?? "—")</dd>
            <dt>City</dt>         <dd>@(Model.CityName ?? "—")</dd>
            <dt>Province</dt>     <dd>@(Model.ProvinceName ?? "—")</dd>
            <dt>Address</dt>      <dd>@(Model.AddressLine1 ?? "—")</dd>
            <dt>Joined</dt>       <dd>@(Model.CreatedAt?.ToString("dd MMM yyyy") ?? "—")</dd>
        </dl>

        <div class="decision-stack" style="margin-top:18px">
            @if (Model.IsActive)
            {
                <button type="button" class="admin-btn-danger"
                        onclick="document.getElementById('deactivateDialog').showModal()">
                    <i class="fa-solid fa-user-slash" aria-hidden="true"></i> Deactivate user
                </button>
            }
            else
            {
                <form asp-area="Admin" asp-controller="Users" asp-action="Reactivate" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.UserId" />
                    <button type="submit" class="admin-btn-success" style="width:100%;justify-content:center">
                        <i class="fa-solid fa-user-check" aria-hidden="true"></i> Reactivate user
                    </button>
                </form>
            }
            <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="admin-back-link">
                <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Back to users
            </a>
        </div>
    </div>

    @* ── Booking history ──────────────────────────────────── *@
    <div class="admin-card">
        <div class="admin-card__header admin-card__header--bordered">
            <h3>Booking history <span class="admin-count-badge">@Model.BookingHistory.Count</span></h3>
        </div>
        <div style="overflow-x:auto">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Date</th><th>Time</th><th>Counterparty</th><th>Type</th><th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.BookingHistory)
                    {
                        <tr>
                            <td>@b.BookingDate.ToString("dd MMM yyyy")</td>
                            <td style="font-variant-numeric:tabular-nums">@b.StartTime.ToString("HH:mm") – @b.EndTime.ToString("HH:mm")</td>
                            <td>@b.Counterparty</td>
                            <td style="text-transform:capitalize">@b.SessionType</td>
                            <td>
                                <span class="admin-pill admin-pill--@b.Status">@b.Status</span>
                            </td>
                        </tr>
                    }
                    @if (!Model.BookingHistory.Any())
                    {
                        <tr class="empty-row"><td colspan="5">No bookings for this user yet.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Model.IsActive)
{
    <dialog id="deactivateDialog" class="admin-dialog" aria-labelledby="deact-title">
        <form asp-area="Admin" asp-controller="Users" asp-action="Deactivate" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.UserId" />
            <div class="admin-dialog__header">
                <span class="admin-dialog__title" id="deact-title">Deactivate user?</span>
                <button type="button" class="admin-dialog__close"
                        onclick="document.getElementById('deactivateDialog').close()" aria-label="Close">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
            <div class="admin-dialog__body">
                <p>You're about to deactivate <strong>@Model.FullName</strong>.</p>
                <p style="color:var(--muted)">Their account will be blocked from signing in. Booking and feedback history is preserved. You can reactivate them at any time.</p>
            </div>
            <div class="admin-dialog__footer">
                <button type="button" class="admin-dialog__cancel"
                        onclick="document.getElementById('deactivateDialog').close()">Cancel</button>
                <button type="submit" class="admin-btn-danger">
                    <i class="fa-solid fa-user-slash" aria-hidden="true"></i> Deactivate
                </button>
            </div>
        </form>
    </dialog>
}
