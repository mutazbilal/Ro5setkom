@model UserDetailViewModel
@{
    ViewData["Title"] = Model.FullName;
    ViewData["Subtitle"] = $"User profile · {Model.Role}";
}

<div class="row g-3">
    <div class="col-lg-4">
        <div class="admin-card admin-card--padded">
            <div class="admin-profile">
                <div class="admin-profile__avatar">
                    @{
                        var initials = string.Join("", Model.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                                                       .Take(2)
                                                                       .Select(s => s[0]));
                    }
                    <span>@initials.ToUpper()</span>
                </div>
                <h2 class="admin-profile__name">@Model.FullName</h2>
                <p class="admin-profile__email">@Model.Email</p>
                <div class="admin-profile__badges">
                    <span class="admin-pill admin-pill--role">@Model.Role</span>
                    @if (Model.IsActive)
                    {
                        <span class="admin-pill admin-pill--success">Active</span>
                    }
                    else
                    {
                        <span class="admin-pill admin-pill--danger">Inactive</span>
                    }
                </div>
            </div>

            <hr />

            <dl class="admin-detail-list">
                <dt>Phone</dt><dd>@(Model.PhoneNumber ?? "—")</dd>
                <dt>National ID</dt><dd>@(Model.NationalId ?? "—")</dd>
                <dt>Date of birth</dt><dd>@(Model.DateOfBirth?.ToString("dd MMM yyyy") ?? "—")</dd>
                <dt>Gender</dt><dd>@(Model.Gender ?? "—")</dd>
                <dt>City</dt><dd>@(Model.City ?? "—")</dd>
                <dt>Province</dt><dd>@(Model.Province ?? "—")</dd>
                <dt>Address</dt><dd>@(Model.AddressLine1 ?? "—")</dd>
                <dt>Joined</dt><dd>@(Model.CreatedAt?.ToString("dd MMM yyyy") ?? "—")</dd>
            </dl>

            <div class="d-grid gap-2 mt-3">
                @if (Model.IsActive)
                {
                    <button type="button" class="btn admin-btn-danger" data-bs-toggle="modal" data-bs-target="#deactivateModal">
                        <i class="fa-solid fa-user-slash"></i> Deactivate user
                    </button>
                }
                else
                {
                    <form asp-area="Admin" asp-controller="Users" asp-action="Reactivate" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.UserId" />
                        <button type="submit" class="btn admin-btn-success w-100">
                            <i class="fa-solid fa-user-check"></i> Reactivate user
                        </button>
                    </form>
                }
                <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-arrow-left"></i> Back to users
                </a>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="admin-card">
            <div class="admin-card__header admin-card__header--bordered">
                <h3>Booking history <span class="admin-count-badge">@Model.BookingHistory.Count</span></h3>
            </div>
            <div class="table-responsive">
                <table class="table admin-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Counterparty</th>
                            <th>Type</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model.BookingHistory)
                        {
                            <tr>
                                <td>@b.BookingDate.ToString("dd MMM yyyy")</td>
                                <td>@b.StartTime.ToString("HH:mm") – @b.EndTime.ToString("HH:mm")</td>
                                <td>@b.Counterparty</td>
                                <td>@b.SessionType</td>
                                <td>
                                    <span class="admin-pill admin-pill--status admin-pill--@b.Status">@b.Status</span>
                                </td>
                            </tr>
                        }
                        @if (!Model.BookingHistory.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">No bookings for this user yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@if (Model.IsActive)
{
    <div class="modal fade" id="deactivateModal" tabindex="-1" aria-labelledby="deactivateModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form asp-area="Admin" asp-controller="Users" asp-action="Deactivate" method="post" class="modal-content">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.UserId" />
                <div class="modal-header">
                    <h5 class="modal-title" id="deactivateModalLabel">Deactivate user?</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>You're about to deactivate <strong>@Model.FullName</strong>.</p>
                    <p class="text-muted small mb-0">
                        Their account will be blocked from signing in. Their booking and feedback history will be preserved.
                        You can reactivate them at any time.
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn admin-btn-danger">
                        <i class="fa-solid fa-user-slash"></i> Deactivate
                    </button>
                </div>
            </form>
        </div>
    </div>
}
