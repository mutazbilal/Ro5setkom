@using Rokhsetak.Areas.Admin.ViewModels.Users
@model UserListViewModel
@{
    ViewData["Title"] = "Users";
    ViewData["Subtitle"] = "Manage all platform users";
    ViewData["ActiveNav"] = "users";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<form asp-area="Admin" asp-controller="Users" asp-action="Index" method="get" class="admin-card admin-card--padded">
    <div class="dash-filter">
        <div class="dash-filter-group" style="flex:2 1 220px">
            <label asp-for="Filter.Search">Search</label>
            <input asp-for="Filter.Search" class="admin-input" placeholder="Name or email" />
        </div>
        <div class="dash-filter-group">
            <label asp-for="Filter.Role">Role</label>
            <select asp-for="Filter.Role" class="admin-select">
                <option value="">All roles</option>
                <option value="trainee">Trainee</option>
                <option value="mentor">Mentor</option>
                <option value="admin">Admin</option>
            </select>
        </div>
        <div class="dash-filter-group">
            <label asp-for="Filter.Status">Status</label>
            <select asp-for="Filter.Status" class="admin-select">
                <option value="">All</option>
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
            </select>
        </div>
        <button type="submit" class="admin-btn-primary" style="align-self:flex-end">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> Filter
        </button>
    </div>
</form>

<div class="admin-card">
    <div class="admin-card__header admin-card__header--bordered">
        <h3>Users <span class="admin-count-badge">@Model.TotalCount</span></h3>
    </div>
    <div style="overflow-x:auto">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Name</th><th>Email</th><th>Role</th>
                    <th>Status</th><th>Joined</th><th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Items)
                {
                    <tr>
                        <td><strong>@u.FullName</strong></td>
                        <td style="color:var(--muted)">@u.Email</td>
                        <td><span class="admin-pill admin-pill--role">@u.Role</span></td>
                        <td>
                            @if (u.IsActive)
                            { <span class="admin-pill admin-pill--success">Active</span> }
                            else
                            { <span class="admin-pill admin-pill--danger">Inactive</span> }
                        </td>
                        <td style="color:var(--muted);font-size:.82rem">@(u.CreatedAt?.ToString("dd MMM yyyy") ?? "—")</td>
                        <td class="text-end">
                            <a asp-area="Admin" asp-controller="Users" asp-action="Details"
                               asp-route-id="@u.UserId" class="admin-row-action">
                                <i class="fa-solid fa-eye" aria-hidden="true"></i> View
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr class="empty-row"><td colspan="6">No users match your filters.</td></tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPages > 1)
    {
        var cur = Model.Filter.Page; var tot = Model.TotalPages;
        int s = Math.Max(1, cur - 2); int e = Math.Min(tot, cur + 2);
        <div class="admin-card__footer">
            <small>Page @cur of @tot</small>
            <ul class="admin-pagination" aria-label="Page navigation">
                <li class="@(cur <= 1 ? "disabled" : "")">
                    <a asp-area="Admin" asp-controller="Users" asp-action="Index"
                       asp-route-Search="@Model.Filter.Search" asp-route-Role="@Model.Filter.Role"
                       asp-route-Status="@Model.Filter.Status" asp-route-Page="@(cur-1)">
                        <i class="fa-solid fa-chevron-left"></i></a>
                </li>
                @for (int i = s; i <= e; i++)
                {
                    <li class="@(i == cur ? "active" : "")">
                        <a asp-area="Admin" asp-controller="Users" asp-action="Index"
                           asp-route-Search="@Model.Filter.Search" asp-route-Role="@Model.Filter.Role"
                           asp-route-Status="@Model.Filter.Status" asp-route-Page="@i">@i</a>
                    </li>
                }
                <li class="@(cur >= tot ? "disabled" : "")">
                    <a asp-area="Admin" asp-controller="Users" asp-action="Index"
                       asp-route-Search="@Model.Filter.Search" asp-route-Role="@Model.Filter.Role"
                       asp-route-Status="@Model.Filter.Status" asp-route-Page="@(cur+1)">
                        <i class="fa-solid fa-chevron-right"></i></a>
                </li>
            </ul>
        </div>
    }
</div>
