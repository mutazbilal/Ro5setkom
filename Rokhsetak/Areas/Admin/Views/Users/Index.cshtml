@using Rokhsetak.Areas.Admin.ViewModels.Users
@using Rokhsetak.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResourceMarker> L
@model UserListViewModel
@{
    ViewData["Title"] = L["Admin_Users_Title"];
    ViewData["Subtitle"] = L["Admin_Users_Subtitle"];
    ViewData["ActiveNav"] = "users";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<form asp-area="Admin" asp-controller="Users" asp-action="Index" method="get" class="admin-card admin-card--padded">
    <div class="dash-filter">
        <div class="dash-filter-group" style="flex:2 1 220px">
            <label asp-for="Filter.Search">@L["Admin_Users_Filter_Search"]</label>
            <input asp-for="Filter.Search" class="admin-input" placeholder="@L["Admin_Users_Filter_SearchPlaceholder"]" />
        </div>
        <div class="dash-filter-group">
            <label asp-for="Filter.Role">@L["Admin_Users_Filter_Role"]</label>
            <select asp-for="Filter.Role" class="admin-select">
                <option value="">@L["Admin_Users_Filter_AllRoles"]</option>
                <option value="trainee">@L["Admin_Users_Filter_Role_Trainee"]</option>
                <option value="mentor">@L["Admin_Users_Filter_Role_Mentor"]</option>
                <option value="admin">@L["Admin_Users_Filter_Role_Admin"]</option>
            </select>
        </div>
        <div class="dash-filter-group">
            <label asp-for="Filter.Status">@L["Admin_Users_Filter_Status"]</label>
            <select asp-for="Filter.Status" class="admin-select">
                <option value="">@L["Admin_Users_Filter_Status_All"]</option>
                <option value="active">@L["Admin_Users_Status_Active"]</option>
                <option value="inactive">@L["Admin_Users_Status_Inactive"]</option>
            </select>
        </div>
        <button type="submit" class="admin-btn-primary" style="align-self:flex-end">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> @L["Admin_Users_Filter_Button"]
        </button>
    </div>
</form>

<div class="admin-card">
    <div class="admin-card__header admin-card__header--bordered">
        <h3>@L["Admin_Users_Title"] <span class="admin-count-badge">@Model.TotalCount</span></h3>
    </div>
    <div style="overflow-x:auto">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>@L["Admin_Users_Table_Name"]</th>
                    <th>@L["Admin_Users_Table_Email"]</th>
                    <th>@L["Admin_Users_Table_Role"]</th>
                    <th>@L["Admin_Users_Table_Status"]</th>
                    <th>@L["Admin_Users_Table_Joined"]</th>
                    <th class="text-end">@L["Admin_Users_Table_Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Items)
                {
                    <tr>
                        <td><strong>@u.FullName</strong></td>
                        <td style="color:var(--muted)">@u.Email</td>
                        <td><span class="admin-pill admin-pill--role">@L[$"Admin_Users_Role_{u.Role}"]</span></td>
                        <td>
                            @if (u.IsActive)
                            { <span class="admin-pill admin-pill--success">@L["Admin_Users_Status_Active"]</span> }
                            else
                            { <span class="admin-pill admin-pill--danger">@L["Admin_Users_Status_Inactive"]</span> }
                        </td>
                        <td style="color:var(--muted);font-size:.82rem">@(u.CreatedAt?.ToString("dd MMM yyyy") ?? "—")</td>
                        <td class="text-end">
                            <a asp-area="Admin" asp-controller="Users" asp-action="Details"
                               asp-route-id="@u.UserId" class="admin-row-action">
                                <i class="fa-solid fa-eye" aria-hidden="true"></i> @L["Admin_Users_Action_View"]
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr class="empty-row"><td colspan="6">@L["Admin_Users_NoData"]</td></tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPages > 1)
    {
        var cur = Model.Filter.Page; var tot = Model.TotalPages;
        int s = Math.Max(1, cur - 2); int e = Math.Min(tot, cur + 2);
        <div class="admin-card__footer">
            <small>@string.Format(L["Admin_Pagination_PageOf"], cur, tot)</small>
            <ul class="admin-pagination" aria-label="@L["Admin_Pagination_Aria"]">
                <li class="@(cur <= 1 ? "disabled" : "")">
                    <a asp-area="Admin" asp-controller="Users" asp-action="Index"
                       asp-route-Search="@Model.Filter.Search" asp-route-Role="@Model.Filter.Role"
                       asp-route-Status="@Model.Filter.Status" asp-route-Page="@(cur-1)">
                        <i class="fa-solid fa-chevron-left"></i>
                    </a>
                </li>
                @for (int i = s; i <= e; i++)
                {
                    <li class="@(i == cur ? "active" : "")">
                        <a asp-area="Admin" asp-controller="Users" asp-action="Index"
                           asp-route-Search="@Model.Filter.Search" asp-route-Role="@Model.Filter.Role"
                           asp-route-Status="@Model.Filter.Status" asp-route-Page="@i">@i</a>
                    </li>
                }
                <li class="@(cur >= tot ? "disabled" : "")">
                    <a asp-area="Admin" asp-controller="Users" asp-action="Index"
                       asp-route-Search="@Model.Filter.Search" asp-route-Role="@Model.Filter.Role"
                       asp-route-Status="@Model.Filter.Status" asp-route-Page="@(cur+1)">
                        <i class="fa-solid fa-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </div>
    }
</div>