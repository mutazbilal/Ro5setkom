@model AnalyticsDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Subtitle"] = "Platform overview and analytics";
}

<form asp-area="Admin" asp-controller="Dashboard" asp-action="Index" method="get" class="admin-card admin-card--padded mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-3">
            <label asp-for="Filter.FromDate" class="form-label"></label>
            <input asp-for="Filter.FromDate" class="form-control" type="date" />
        </div>
        <div class="col-md-3">
            <label asp-for="Filter.ToDate" class="form-label"></label>
            <input asp-for="Filter.ToDate" class="form-control" type="date" />
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn admin-btn-primary w-100">
                <i class="fa-solid fa-filter"></i> Apply filter
            </button>
        </div>
        <div class="col-md-3">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary w-100">
                <i class="fa-solid fa-rotate-left"></i> Reset
            </a>
        </div>
    </div>
</form>

<div class="row g-3 mb-4">
    <div class="col-md-4 col-lg-2">
        <div class="admin-stat-card">
            <span class="admin-stat-card__label">Total Users</span>
            <span class="admin-stat-card__value">@Model.TotalUsers.ToString("N0")</span>
            <i class="fa-solid fa-users admin-stat-card__icon"></i>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="admin-stat-card">
            <span class="admin-stat-card__label">Active Trainees</span>
            <span class="admin-stat-card__value">@Model.ActiveTrainees.ToString("N0")</span>
            <i class="fa-solid fa-user-graduate admin-stat-card__icon"></i>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="admin-stat-card">
            <span class="admin-stat-card__label">Active Mentors</span>
            <span class="admin-stat-card__value">@Model.ActiveMentors.ToString("N0")</span>
            <i class="fa-solid fa-user-tie admin-stat-card__icon"></i>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="admin-stat-card">
            <span class="admin-stat-card__label">Total Bookings</span>
            <span class="admin-stat-card__value">@Model.TotalBookings.ToString("N0")</span>
            <i class="fa-solid fa-calendar-check admin-stat-card__icon"></i>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="admin-stat-card">
            <span class="admin-stat-card__label">Pending Apps</span>
            <span class="admin-stat-card__value">@Model.PendingMentorApplications.ToString("N0")</span>
            <i class="fa-solid fa-file-signature admin-stat-card__icon"></i>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="admin-stat-card">
            <span class="admin-stat-card__label">Completed Licenses</span>
            <span class="admin-stat-card__value">@Model.CompletedLicenses.ToString("N0")</span>
            <i class="fa-solid fa-graduation-cap admin-stat-card__icon"></i>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="admin-card admin-card--padded h-100">
            <div class="admin-card__header">
                <h3>Avg. Mentor Rating</h3>
            </div>
            <div class="admin-metric-large">
                <span class="admin-metric-large__value">@Model.PlatformAvgRating.ToString("0.00")</span>
                <span class="admin-metric-large__unit">/ 5.00</span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="admin-card admin-card--padded h-100">
            <div class="admin-card__header">
                <h3>Completion Rate</h3>
            </div>
            <div class="admin-metric-large">
                <span class="admin-metric-large__value">@Model.PlatformCompletionRate.ToString("0.0")</span>
                <span class="admin-metric-large__unit">%</span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="admin-card admin-card--padded h-100">
            <div class="admin-card__header">
                <h3>Avg. Time to Completion</h3>
            </div>
            <div class="admin-metric-large">
                <span class="admin-metric-large__value">@Model.PlatformAvgDaysToCompletion.ToString("0.0")</span>
                <span class="admin-metric-large__unit">days</span>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="admin-card admin-card--padded">
            <div class="admin-card__header">
                <h3>Users over time</h3>
                <small>New user registrations by month</small>
            </div>
            <div style="position: relative; height: 320px;">
                <canvas id="usersChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="admin-card admin-card--padded">
            <div class="admin-card__header">
                <h3>Bookings per month</h3>
                <small>Session bookings created by month</small>
            </div>
            <div style="position: relative; height: 320px;">
                <canvas id="bookingsChart"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-5">
        <div class="admin-card admin-card--padded">
            <div class="admin-card__header">
                <h3>Mentor performance distribution</h3>
                <small>Rating buckets across all mentors</small>
            </div>
            <div style="position: relative; height: 320px;">
                <canvas id="performanceChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="admin-card admin-card--padded">
            <div class="admin-card__header">
                <h3>Top mentors</h3>
                <small>Sorted by average rating then completed sessions</small>
            </div>
            <div class="table-responsive">
                <table class="table admin-table align-middle">
                    <thead>
                        <tr>
                            <th>Mentor</th>
                            <th class="text-end">Rating</th>
                            <th class="text-end">Sessions</th>
                            <th class="text-end">Completion</th>
                            <th class="text-end">Avg. Days</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.TopMentors)
                        {
                            <tr>
                                <td>
                                    <a asp-area="Admin" asp-controller="Mentors" asp-action="Details" asp-route-id="@m.MentorId">@m.FullName</a>
                                </td>
                                <td class="text-end">@m.AverageRating.ToString("0.00") <small class="text-muted">(@m.TotalRatings)</small></td>
                                <td class="text-end">@m.CompletedSessions / @m.TotalSessions</td>
                                <td class="text-end">@m.CompletionRate.ToString("0.0")%</td>
                                <td class="text-end">@m.AvgDaysToCompletion.ToString("0.0")</td>
                            </tr>
                        }
                        @if (!Model.TopMentors.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">No mentor performance data yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            const brand = {
                navy: '#1A3A6B',
                orange: '#F26522',
                gold: '#C9A84C',
                mist: '#F5F7FA',
                gray: '#8A94A6'
            };

            const usersData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.UsersOverTime.Select(p => new { p.Label, p.Count })));
            const bookingsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BookingsPerMonth.Select(p => new { p.Label, p.Count })));
            const perfData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MentorPerformanceDistribution.Select(p => new { p.Bucket, p.Count })));

            const baseOpts = {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { display: false } },
                    y: { beginAtZero: true, ticks: { precision: 0 } }
                }
            };

            new Chart(document.getElementById('usersChart'), {
                type: 'line',
                data: {
                    labels: usersData.map(d => d.Label),
                    datasets: [{
                        data: usersData.map(d => d.Count),
                        borderColor: brand.navy,
                        backgroundColor: 'rgba(26, 58, 107, 0.08)',
                        fill: true,
                        tension: 0.35,
                        pointBackgroundColor: brand.orange,
                        pointBorderColor: '#fff',
                        pointRadius: 4
                    }]
                },
                options: baseOpts
            });

            new Chart(document.getElementById('bookingsChart'), {
                type: 'bar',
                data: {
                    labels: bookingsData.map(d => d.Label),
                    datasets: [{
                        data: bookingsData.map(d => d.Count),
                        backgroundColor: brand.orange,
                        borderRadius: 6
                    }]
                },
                options: baseOpts
            });

            new Chart(document.getElementById('performanceChart'), {
                type: 'doughnut',
                data: {
                    labels: perfData.map(d => d.Bucket),
                    datasets: [{
                        data: perfData.map(d => d.Count),
                        backgroundColor: [brand.gold, brand.orange, brand.navy, '#5b6b87', '#a9b1c0'],
                        borderColor: '#fff',
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom' } }
                }
            });
        })();
    </script>
}
