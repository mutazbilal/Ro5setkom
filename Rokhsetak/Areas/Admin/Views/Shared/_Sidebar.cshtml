@using System.Globalization
@using Rokhsetak.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResourceMarker> L
@{
    var active = ViewData["ActiveNav"] as string ?? "";
    var currentLang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<aside class="admin-sidebar" aria-label="Admin navigation">
    <div class="admin-sidebar__brand">
        <img src="~/images/logo.png"
             asp-append-version="true"
             alt="Rokhsetak"
             class="admin-sidebar__logo-img" />
    </div>

    <nav class="admin-sidebar__nav" aria-label="Admin sections">
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
           class="admin-sidebar__link @(active == "dashboard" ? "is-active" : "")"
           aria-current="@(active == "dashboard" ? "page" : null)">
            <i class="fa-solid fa-chart-line" aria-hidden="true"></i>
            <span>@L["Admin_Nav_Dashboard"]</span>
        </a>
        <a asp-area="Admin" asp-controller="Users" asp-action="Index"
           class="admin-sidebar__link @(active == "users" ? "is-active" : "")"
           aria-current="@(active == "users" ? "page" : null)">
            <i class="fa-solid fa-users" aria-hidden="true"></i>
            <span>@L["Admin_Nav_Users"]</span>
        </a>
        <a asp-area="Admin" asp-controller="Mentors" asp-action="Index"
           class="admin-sidebar__link @(active == "mentors" ? "is-active" : "")"
           aria-current="@(active == "mentors" ? "page" : null)">
            <i class="fa-solid fa-user-tie" aria-hidden="true"></i>
            <span>@L["Admin_Nav_Mentors"]</span>
        </a>
        <a asp-area="Admin" asp-controller="MentorApplications" asp-action="Index"
           class="admin-sidebar__link @(active == "applications" ? "is-active" : "")"
           aria-current="@(active == "applications" ? "page" : null)">
            <i class="fa-solid fa-file-signature" aria-hidden="true"></i>
            <span>@L["Admin_Nav_Applications"]</span>
        </a>
        <a asp-area="Admin" asp-controller="Bookings" asp-action="Index"
           class="admin-sidebar__link @(active == "bookings" ? "is-active" : "")"
           aria-current="@(active == "bookings" ? "page" : null)">
            <i class="fa-solid fa-calendar-check" aria-hidden="true"></i>
            <span>@L["Admin_Nav_Bookings"]</span>
        </a>
        <a asp-area="Admin" asp-controller="BlockedDates" asp-action="Index"
           class="admin-sidebar__link @(active == "blocked-dates" ? "is-active" : "")"
           aria-current="@(active == "blocked-dates" ? "page" : null)">
            <i class="fa-solid fa-calendar-xmark" aria-hidden="true"></i>
            <span>@L["Admin_Nav_BlockedDates"]</span>
        </a>
    </nav>

    <div class="admin-sidebar__footer">

        <div class="admin-sidebar__lang" role="group" aria-label="@L["Mentor_LanguageGroupAria"]">

            <form asp-area=""
                  asp-controller="Profile"
                  asp-action="ChangeLanguage"
                  method="post"
                  class="admin-sidebar__lang-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="language" value="ar" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <button type="submit"
                        class="admin-sidebar__lang-btn @(currentLang == "ar" ? "is-active" : null)">
                    AR
                </button>
            </form>

            <form asp-area=""
                  asp-controller="Profile"
                  asp-action="ChangeLanguage"
                  method="post"
                  class="admin-sidebar__lang-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="language" value="en" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <button type="submit"
                        class="admin-sidebar__lang-btn @(currentLang == "en" ? "is-active" : null)">
                    EN
                </button>
            </form>

        </div>

        <small class="admin-sidebar__copy">&copy; @DateTime.UtcNow.Year Rokhsetak</small>

    </div>
</aside>