@using Rokhsetak.Areas.Admin.ViewModels.MentorApplications
@model MentorApplicationDetailViewModel
@{
    ViewData["Title"] = $"Application · {Model.FullName}";
    ViewData["Subtitle"] = $"Submitted {Model.SubmittedAt?.ToString("dd MMM yyyy") ?? "—"}";
    ViewData["ActiveNav"] = "applications";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    bool isPending = Model.Status.Equals("pending", StringComparison.OrdinalIgnoreCase);
}

<div class="app-layout">
    @* ── Main info ────────────────────────────────────────── *@
    <div class="admin-card admin-card--padded">
        <div class="app-name-row">
            <div>
                <h3>@Model.FullName</h3>
                <p>@Model.Email</p>
            </div>
            <span class="admin-pill admin-pill--@Model.Status.ToLower()">@Model.Status</span>
        </div>

        <hr class="admin-divider" />
        <p class="admin-section-title">Personal information</p>
        <dl class="admin-detail-list">
            <dt>National ID</dt>    <dd>@(Model.NationalId ?? "—")</dd>
            <dt>Phone</dt>          <dd>@(Model.PhoneNumber ?? "—")</dd>
            <dt>Date of birth</dt>  <dd>@(Model.DateOfBirth?.ToString("dd MMM yyyy") ?? "—")</dd>
            <dt>Gender</dt>         <dd>@(Model.Gender ?? "—")</dd>
            <dt>City</dt>           <dd>@(Model.CityName ?? "—")</dd>
            <dt>Province</dt>       <dd>@(Model.ProvinceName ?? "—")</dd>
        </dl>

        <hr class="admin-divider" />
        <p class="admin-section-title">Mentor profile</p>
        <dl class="admin-detail-list">
            <dt>License type</dt>   <dd>@Model.LicenseType</dd>
            <dt>Vehicle</dt>        <dd>@(Model.VehicleType ?? "—")</dd>
            <dt>Price / session</dt><dd>@(Model.PricePerSession.HasValue ? $"{Model.PricePerSession:0.00} JOD" : "—")</dd>
        </dl>
    </div>

    @* ── Sidebar ──────────────────────────────────────────── *@
    <div class="app-layout__sidebar">
        <div class="admin-card admin-card--padded">
            <p class="admin-section-title">
                <i class="fa-solid fa-file-shield" aria-hidden="true"></i> Certification
            </p>
            @if (Model.HasCertificationFile)
            {
                <p class="cert-upload-info">Uploaded @(Model.CertificationUploadedAt?.ToString("dd MMM yyyy HH:mm") ?? "—")</p>
                <a asp-area="Admin" asp-controller="MentorApplications" asp-action="Download"
                   asp-route-id="@Model.ApplicationId"
                   asp-route-fileName="@Model.CertificationFileName"
                   class="admin-btn-primary" style="width:100%;justify-content:center;text-decoration:none">
                    <i class="fa-solid fa-download" aria-hidden="true"></i>
                    Download @(Model.CertificationFileName ?? "certification")
                </a>
                <p class="cert-secure-note">Files are served from a secure admin-only endpoint.</p>
            }
            else
            {
                <div class="no-cert-banner">
                    <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                    No certification file has been uploaded for this application.
                </div>
            }
        </div>

        @if (isPending)
        {
            <div class="admin-card admin-card--padded">
                <p class="admin-section-title">Decision</p>
                <div class="decision-stack">
                    <button type="button" class="admin-btn-success"
                            onclick="document.getElementById('approveDialog').showModal()">
                        <i class="fa-solid fa-check" aria-hidden="true"></i> Approve application
                    </button>
                    <button type="button" class="admin-btn-danger"
                            onclick="document.getElementById('rejectDialog').showModal()">
                        <i class="fa-solid fa-xmark" aria-hidden="true"></i> Reject application
                    </button>
                    <a asp-area="Admin" asp-controller="MentorApplications" asp-action="Index" class="admin-back-link">
                        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Back to applications
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="admin-card admin-card--padded">
                <p class="already-reviewed">This application has already been reviewed.</p>
                <a asp-area="Admin" asp-controller="MentorApplications" asp-action="Index"
                   class="admin-back-link" style="width:100%;justify-content:center">
                    <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Back to applications
                </a>
            </div>
        }
    </div>
</div>

@if (isPending)
{
    <dialog id="approveDialog" class="admin-dialog" aria-labelledby="approve-title">
        <form asp-area="Admin" asp-controller="MentorApplications" asp-action="Approve" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.ApplicationId" />
            <div class="admin-dialog__header">
                <span class="admin-dialog__title" id="approve-title">Approve application?</span>
                <button type="button" class="admin-dialog__close"
                        onclick="document.getElementById('approveDialog').close()" aria-label="Close">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
            <div class="admin-dialog__body">
                <p>You're about to approve <strong>@Model.FullName</strong> as a mentor.</p>
                <p style="color:var(--muted)">They'll be notified by email and will become visible to trainees immediately.</p>
            </div>
            <div class="admin-dialog__footer">
                <button type="button" class="admin-dialog__cancel"
                        onclick="document.getElementById('approveDialog').close()">Cancel</button>
                <button type="submit" class="admin-btn-success">
                    <i class="fa-solid fa-check" aria-hidden="true"></i> Approve
                </button>
            </div>
        </form>
    </dialog>

    <dialog id="rejectDialog" class="admin-dialog" aria-labelledby="reject-title">
        <form asp-area="Admin" asp-controller="MentorApplications" asp-action="Reject" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ApplicationId" value="@Model.ApplicationId" />
            <div class="admin-dialog__header">
                <span class="admin-dialog__title" id="reject-title">Reject application?</span>
                <button type="button" class="admin-dialog__close"
                        onclick="document.getElementById('rejectDialog').close()" aria-label="Close">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
            <div class="admin-dialog__body">
                <p>You're about to reject <strong>@Model.FullName</strong>.</p>
                <div class="reject-field">
                    <label for="rejectReason">
                        Rejection reason <span style="color:var(--danger)" aria-hidden="true">*</span>
                    </label>
                    <textarea id="rejectReason" name="Reason" rows="4" maxlength="500"
                              required aria-required="true"
                              placeholder="Explain why this application is being rejected (sent to applicant)."></textarea>
                    <small>Required, 5–500 characters. This message is included in the email to the applicant.</small>
                </div>
            </div>
            <div class="admin-dialog__footer">
                <button type="button" class="admin-dialog__cancel"
                        onclick="document.getElementById('rejectDialog').close()">Cancel</button>
                <button type="submit" class="admin-btn-danger">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i> Reject
                </button>
            </div>
        </form>
    </dialog>
}
