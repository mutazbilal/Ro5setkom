@using Rokhsetak.Areas.Admin.ViewModels.MentorApplications
@using Rokhsetak.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResourceMarker> L
@model MentorApplicationDetailViewModel
@{
    ViewData["Title"] = string.Format(L["Admin_Application_Detail_Title"], Model.FullName);
    ViewData["Subtitle"] = string.Format(L["Admin_Application_Detail_Submitted"], Model.SubmittedAt?.ToString("dd MMM yyyy") ?? "—");
    ViewData["ActiveNav"] = "applications";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    bool isPending = Model.Status.Equals("pending", StringComparison.OrdinalIgnoreCase);
}

<div class="app-layout">
    @* ── Main info ────────────────────────────────────────── *@
    <div class="admin-card admin-card--padded">
        <div class="app-name-row">
            <div>
                <h3>@Model.FullName</h3>
                <p>@Model.Email</p>
            </div>
            <span class="admin-pill admin-pill--@Model.Status.ToLower()">@L[$"Admin_Application_Status_{Model.Status}"]</span>
        </div>

        <hr class="admin-divider" />
        <p class="admin-section-title">@L["Admin_Application_Section_Personal"]</p>
        <dl class="admin-detail-list">
            <dt>@L["Admin_Application_Field_NationalId"]</dt>    <dd>@(Model.NationalId ?? "—")</dd>
            <dt>@L["Admin_Application_Field_Phone"]</dt>          <dd>@(Model.PhoneNumber ?? "—")</dd>
            <dt>@L["Admin_Application_Field_DateOfBirth"]</dt>  <dd>@(Model.DateOfBirth?.ToString("dd MMM yyyy") ?? "—")</dd>
            <dt>@L["Admin_Application_Field_Gender"]</dt>         <dd>@(Model.Gender ?? "—")</dd>
            <dt>@L["Admin_Application_Field_City"]</dt>           <dd>@(Model.CityName ?? "—")</dd>
            <dt>@L["Admin_Application_Field_Province"]</dt>       <dd>@(Model.ProvinceName ?? "—")</dd>
        </dl>

        <hr class="admin-divider" />
        <p class="admin-section-title">@L["Admin_Application_Section_MentorProfile"]</p>
        <dl class="admin-detail-list">
            <dt>@L["Admin_Application_Field_LicenseType"]</dt>   <dd>@Model.LicenseType</dd>
            <dt>@L["Admin_Application_Field_Vehicle"]</dt>        <dd>@(Model.VehicleType ?? "—")</dd>
            <dt>@L["Admin_Application_Field_PricePerSession"]</dt><dd>@(Model.PricePerSession.HasValue ? $"{Model.PricePerSession:0.00} {L["Admin_Application_Currency_JOD"]}" : "—")</dd>
        </dl>
    </div>

    @* ── Sidebar ──────────────────────────────────────────── *@
    <div class="app-layout__sidebar">
        <div class="admin-card admin-card--padded">
            <p class="admin-section-title">
                <i class="fa-solid fa-file-shield" aria-hidden="true"></i> @L["Admin_Application_Certification_Title"]
            </p>
            @if (Model.HasCertificationFile)
            {
                <p class="cert-upload-info">@string.Format(L["Admin_Application_Cert_UploadedAt"], Model.CertificationUploadedAt?.ToString("dd MMM yyyy HH:mm") ?? "—")</p>
                <a asp-area="Admin" asp-controller="MentorApplications" asp-action="Download"
                   asp-route-id="@Model.ApplicationId"
                   asp-route-fileName="@Model.CertificationFileName"
                   class="admin-btn-primary" style="width:100%;justify-content:center;text-decoration:none">
                    <i class="fa-solid fa-download" aria-hidden="true"></i>
                    @string.Format(L["Admin_Application_Cert_Download"], Model.CertificationFileName ?? "certification")
                </a>
                <p class="cert-secure-note">@L["Admin_Application_Cert_SecureNote"]</p>
            }
            else
            {
                <div class="no-cert-banner">
                    <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                    @L["Admin_Application_Cert_None"]
                </div>
            }
        </div>

        @if (isPending)
        {
            <div class="admin-card admin-card--padded">
                <p class="admin-section-title">@L["Admin_Application_Decision_Title"]</p>
                <div class="decision-stack">
                    <button type="button" class="admin-btn-success"
                            onclick="document.getElementById('approveDialog').showModal()">
                        <i class="fa-solid fa-check" aria-hidden="true"></i> @L["Admin_Application_Button_Approve"]
                    </button>
                    <button type="button" class="admin-btn-danger"
                            onclick="document.getElementById('rejectDialog').showModal()">
                        <i class="fa-solid fa-xmark" aria-hidden="true"></i> @L["Admin_Application_Button_Reject"]
                    </button>
                    <a asp-area="Admin" asp-controller="MentorApplications" asp-action="Index" class="admin-back-link">
                        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> @L["Admin_Application_Button_Back"]
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="admin-card admin-card--padded">
                <p class="already-reviewed">@L["Admin_Application_AlreadyReviewed"]</p>
                <a asp-area="Admin" asp-controller="MentorApplications" asp-action="Index"
                   class="admin-back-link" style="width:100%;justify-content:center">
                    <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> @L["Admin_Application_Button_Back"]
                </a>
            </div>
        }
    </div>
</div>

@if (isPending)
{
    <dialog id="approveDialog" class="admin-dialog" aria-labelledby="approve-title">
        <form asp-area="Admin" asp-controller="MentorApplications" asp-action="Approve" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.ApplicationId" />
            <div class="admin-dialog__header">
                <span class="admin-dialog__title" id="approve-title">@L["Admin_Application_ApproveDialog_Title"]</span>
                <button type="button" class="admin-dialog__close"
                        onclick="document.getElementById('approveDialog').close()" aria-label="@L["Alert_Close"]">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
            <div class="admin-dialog__body">
                <p>@Html.Raw(string.Format(L["Admin_Application_ApproveDialog_Body"], $"<strong>{Model.FullName}</strong>"))</p>
                <p style="color:var(--muted)">@L["Admin_Application_ApproveDialog_Note"]</p>
            </div>
            <div class="admin-dialog__footer">
                <button type="button" class="admin-dialog__cancel"
                        onclick="document.getElementById('approveDialog').close()">@L["Common_Cancel"]</button>
                <button type="submit" class="admin-btn-success">
                    <i class="fa-solid fa-check" aria-hidden="true"></i> @L["Admin_Application_ApproveDialog_Confirm"]
                </button>
            </div>
        </form>
    </dialog>

    <dialog id="rejectDialog" class="admin-dialog" aria-labelledby="reject-title">
        <form asp-area="Admin" asp-controller="MentorApplications" asp-action="Reject" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ApplicationId" value="@Model.ApplicationId" />
            <div class="admin-dialog__header">
                <span class="admin-dialog__title" id="reject-title">@L["Admin_Application_RejectDialog_Title"]</span>
                <button type="button" class="admin-dialog__close"
                        onclick="document.getElementById('rejectDialog').close()" aria-label="@L["Alert_Close"]">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
            <div class="admin-dialog__body">
                <p>@Html.Raw(string.Format(L["Admin_Application_RejectDialog_Body"], $"<strong>{Model.FullName}</strong>"))</p>
                <div class="reject-field">
                    <label for="rejectReason">
                        @L["Admin_Application_RejectDialog_ReasonLabel"] <span style="color:var(--danger)" aria-hidden="true">*</span>
                    </label>
                    <textarea id="rejectReason" name="Reason" rows="4" maxlength="500"
                              required aria-required="true"
                              placeholder="@L["Admin_Application_RejectDialog_ReasonPlaceholder"]"></textarea>
                    <small>@L["Admin_Application_RejectDialog_ReasonHint"]</small>
                </div>
            </div>
            <div class="admin-dialog__footer">
                <button type="button" class="admin-dialog__cancel"
                        onclick="document.getElementById('rejectDialog').close()">@L["Common_Cancel"]</button>
                <button type="submit" class="admin-btn-danger">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i> @L["Admin_Application_RejectDialog_Confirm"]
                </button>
            </div>
        </form>
    </dialog>
}