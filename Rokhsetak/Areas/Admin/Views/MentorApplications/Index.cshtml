@using Rokhsetak.Areas.Admin.ViewModels.MentorApplications
@model MentorApplicationListViewModel
@{
    ViewData["Title"] = "Mentor Applications";
    ViewData["Subtitle"] = "Pending applications awaiting your review";
    ViewData["ActiveNav"] = "applications";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-card">
    <div class="admin-card__header admin-card__header--bordered">
        <h3>Pending applications <span class="admin-count-badge">@Model.Items.Count</span></h3>
        <small>Approved and rejected applications are not shown here.</small>
    </div>
    <div style="overflow-x:auto">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Applicant</th><th>Email</th><th>Phone</th>
                    <th>License</th><th>City</th><th>Submitted</th>
                    <th>Cert.</th><th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var app in Model.Items)
                {
                    <tr>
                        <td><strong>@app.FullName</strong></td>
                        <td style="color:var(--muted)">@app.Email</td>
                        <td>@(app.PhoneNumber ?? "—")</td>
                        <td>@app.LicenseType</td>
                        <td>@(app.CityName ?? "—")</td>
                        <td style="color:var(--muted);font-size:.82rem">@(app.SubmittedAt?.ToString("dd MMM yyyy") ?? "—")</td>
                        <td>
                            @if (app.HasCertificationFile)
                            {
                                <span class="admin-pill admin-pill--success">
                                    <i class="fa-solid fa-paperclip" aria-hidden="true"></i> Uploaded
                                </span>
                            }
                            else
                            {
                                <span class="admin-pill admin-pill--danger">Missing</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-area="Admin" asp-controller="MentorApplications" asp-action="Details"
                               asp-route-id="@app.ApplicationId" class="admin-row-action">
                                <i class="fa-solid fa-eye" aria-hidden="true"></i> Review
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr class="empty-row"><td colspan="8">No pending applications right now.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
