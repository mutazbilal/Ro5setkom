@using Rokhsetak.Areas.Admin.ViewModels.Mentors
@model MentorDetailViewModel
@{
    ViewData["Title"] = Model.FullName;
    ViewData["Subtitle"] = $"Mentor profile · {Model.LicenseType}";
    ViewData["ActiveNav"] = "mentors";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var initials = string.Join("", Model.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0])).ToUpper();
    var completionPct = Model.TotalSessions > 0 ? (Model.CompletedSessions / (double)Model.TotalSessions) * 100 : 0;
}

<div class="detail-layout">
    @* ── Profile sidebar ──────────────────────────────────── *@
    <div class="admin-card admin-card--padded">
        <div class="admin-profile">
            <div class="admin-profile__avatar" aria-hidden="true">@initials</div>
            <h2 class="admin-profile__name">@Model.FullName</h2>
            <p class="admin-profile__email">@Model.Email</p>
            <div class="admin-profile__badges">
                <span class="admin-pill admin-pill--role">mentor</span>
                @if (Model.IsActive)
                { <span class="admin-pill admin-pill--success">Active</span> }
                else
                { <span class="admin-pill admin-pill--danger">Inactive</span> }
                <span class="admin-pill admin-pill--@Model.ApplicationStatus.ToLower()">@Model.ApplicationStatus</span>
            </div>
        </div>

        <hr class="admin-divider" />
        <dl class="admin-detail-list">
            <dt>Phone</dt>          <dd>@(Model.PhoneNumber ?? "—")</dd>
            <dt>License type</dt>   <dd>@Model.LicenseType</dd>
            <dt>Vehicle</dt>        <dd>@(Model.VehicleType ?? "—")</dd>
            <dt>City</dt>           <dd>@(Model.CityName ?? "—")</dd>
            <dt>Price / session</dt><dd>@(Model.PricePerSession.HasValue ? $"{Model.PricePerSession:0.00} JOD" : "—")</dd>
            <dt>Joined</dt>         <dd>@(Model.CreatedAt?.ToString("dd MMM yyyy") ?? "—")</dd>
        </dl>

        <div class="decision-stack" style="margin-top:18px">
            @if (Model.IsActive)
            {
                <button type="button" class="admin-btn-danger"
                        onclick="document.getElementById('deactivateDialog').showModal()">
                    <i class="fa-solid fa-user-slash" aria-hidden="true"></i> Deactivate mentor
                </button>
            }
            else
            {
                <form asp-area="Admin" asp-controller="Mentors" asp-action="Reactivate" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.MentorId" />
                    <button type="submit" class="admin-btn-success" style="width:100%;justify-content:center">
                        <i class="fa-solid fa-user-check" aria-hidden="true"></i> Reactivate mentor
                    </button>
                </form>
            }
            <a asp-area="Admin" asp-controller="Mentors" asp-action="Index" class="admin-back-link">
                <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Back to mentors
            </a>
        </div>
    </div>

    @* ── Stats + info ─────────────────────────────────────── *@
    <div style="display:flex;flex-direction:column;gap:16px">
        <div class="detail-stats">
            <div class="admin-stat-card">
                <span class="admin-stat-card__label">Avg. Rating</span>
                <span class="admin-stat-card__value">
                    @if (Model.AverageRating > 0)
                    {
                        <i class="fa-solid fa-star" style="color:var(--ag)" aria-hidden="true"></i>
                        @Model.AverageRating.ToString("0.0")
                    }
                    else
                    {
                        <span style="color:var(--muted)">—</span>
                    }
                </span>
                <span class="admin-stat-card__sub">@Model.TotalRatings rating(s)</span>
            </div>
            <div class="admin-stat-card">
                <span class="admin-stat-card__label">Total Sessions</span>
                <span class="admin-stat-card__value">@Model.TotalSessions</span>
                <span class="admin-stat-card__sub">All-time bookings</span>
            </div>
            <div class="admin-stat-card">
                <span class="admin-stat-card__label">Completed</span>
                <span class="admin-stat-card__value">@Model.CompletedSessions</span>
                <span class="admin-stat-card__sub">@completionPct.ToString("0")% completion</span>
            </div>
        </div>

        <div class="admin-card admin-card--padded">
            <p class="admin-section-title">Application history</p>
            <p style="font-size:.88rem;color:var(--muted);margin-bottom:8px">
                This mentor's current application status is
                <span class="admin-pill admin-pill--@Model.ApplicationStatus.ToLower()">@Model.ApplicationStatus</span>.
            </p>
            <p style="font-size:.82rem;color:var(--muted);margin:0">
                To review the original certification submission, find this mentor in the
                <a asp-area="Admin" asp-controller="MentorApplications" asp-action="Index"
                   style="color:var(--ao);font-weight:600">Applications</a> page
                (only pending applications are listed there).
            </p>
        </div>
    </div>
</div>

@if (Model.IsActive)
{
    <dialog id="deactivateDialog" class="admin-dialog" aria-labelledby="deact-title">
        <form asp-area="Admin" asp-controller="Mentors" asp-action="Deactivate" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.MentorId" />
            <div class="admin-dialog__header">
                <span class="admin-dialog__title" id="deact-title">Deactivate mentor?</span>
                <button type="button" class="admin-dialog__close"
                        onclick="document.getElementById('deactivateDialog').close()" aria-label="Close">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
            <div class="admin-dialog__body">
                <p>You're about to deactivate <strong>@Model.FullName</strong>.</p>
                <p style="color:var(--muted)">They'll be blocked from signing in and won't appear in trainee searches. Existing bookings and ratings are preserved. You can reactivate them at any time.</p>
            </div>
            <div class="admin-dialog__footer">
                <button type="button" class="admin-dialog__cancel"
                        onclick="document.getElementById('deactivateDialog').close()">Cancel</button>
                <button type="submit" class="admin-btn-danger">
                    <i class="fa-solid fa-user-slash" aria-hidden="true"></i> Deactivate
                </button>
            </div>
        </form>
    </dialog>
}
