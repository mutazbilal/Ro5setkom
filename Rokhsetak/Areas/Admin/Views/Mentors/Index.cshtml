@using Rokhsetak.Areas.Admin.ViewModels.Mentors
@using Rokhsetak.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResourceMarker> L
@model MentorListViewModel
@{
    ViewData["Title"] = L["Admin_Mentors_Title"];
    ViewData["Subtitle"] = L["Admin_Mentors_Subtitle"];
    ViewData["ActiveNav"] = "mentors";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<form asp-area="Admin" asp-controller="Mentors" asp-action="Index" method="get" class="admin-card admin-card--padded">
    <div class="dash-filter">
        <div class="dash-filter-group" style="flex:2 1 220px">
            <label asp-for="Filter.Search">@L["Admin_Mentors_Filter_Search"]</label>
            <input asp-for="Filter.Search" class="admin-input" placeholder="@L["Admin_Mentors_Filter_SearchPlaceholder"]" />
        </div>
        <div class="dash-filter-group">
            <label asp-for="Filter.Status">@L["Admin_Mentors_Filter_Status"]</label>
            <select asp-for="Filter.Status" class="admin-select">
                <option value="">@L["Admin_Mentors_Filter_Status_All"]</option>
                <option value="active">@L["Admin_Mentors_Filter_Status_Active"]</option>
                <option value="inactive">@L["Admin_Mentors_Filter_Status_Inactive"]</option>
            </select>
        </div>
        <div class="dash-filter-group">
            <label asp-for="Filter.LicenseTypeId">@L["Admin_Mentors_Filter_LicenseType"]</label>
            <select asp-for="Filter.LicenseTypeId" class="admin-select">
                <option value="">@L["Admin_Mentors_Filter_AllLicenseTypes"]</option>
                @foreach (var (id, name) in Model.LicenseTypeOptions)
                {
                    <option value="@id">@name</option>
                }
            </select>
        </div>
        <div class="dash-filter-group">
            <label asp-for="Filter.CityId">@L["Admin_Mentors_Filter_City"]</label>
            <select asp-for="Filter.CityId" class="admin-select" id="citySelect">
                <option value="">@L["Admin_Mentors_Filter_AllCities"]</option>
                @foreach (var city in Model.Cities)
                {
                    <option value="@city.CityId" data-province-id="@city.ProvinceId">@city.DisplayName</option>
                }
            </select>
        </div>
        <button type="submit" class="admin-btn-primary" style="align-self:flex-end">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> @L["Admin_Mentors_Filter_Button"]
        </button>
    </div>
</form>

<div class="admin-card">
    <div class="admin-card__header admin-card__header--bordered">
        <h3>@L["Admin_Mentors_Title"] <span class="admin-count-badge">@Model.TotalCount</span></h3>
    </div>
    <div style="overflow-x:auto">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>@L["Admin_Mentors_Table_Name"]</th>
                    <th>@L["Admin_Mentors_Table_Email"]</th>
                    <th>@L["Admin_Mentors_Table_License"]</th>
                    <th>@L["Admin_Mentors_Table_City"]</th>
                    <th>@L["Admin_Mentors_Table_Rating"]</th>
                    <th>@L["Admin_Mentors_Table_Sessions"]</th>
                    <th>@L["Admin_Mentors_Table_Status"]</th>
                    <th class="text-end">@L["Admin_Mentors_Table_Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model.Items)
                {
                    <tr>
                        <td><strong>@m.FullName</strong></td>
                        <td style="color:var(--muted)">@m.Email</td>
                        <td>@m.LicenseType</td>
                        <td>@(m.CityName ?? "—")</td>
                        <td>
                            @if (m.AverageRating > 0)
                            {
                                <span><i class="fa-solid fa-star" style="color:var(--ag)" aria-hidden="true"></i> @m.AverageRating.ToString("0.0")</span>
                            }
                            else { <span style="color:var(--muted)">—</span> }
                        </td>
                        <td style="font-variant-numeric:tabular-nums">@m.TotalSessions</td>
                        <td>
                            @if (m.IsActive)
                            { <span class="admin-pill admin-pill--success">@L["Admin_Mentors_Table_Status_Active"]</span> }
                            else
                            { <span class="admin-pill admin-pill--danger">@L["Admin_Mentors_Table_Status_Inactive"]</span> }
                        </td>
                        <td class="text-end">
                            <a asp-area="Admin" asp-controller="Mentors" asp-action="Details"
                               asp-route-id="@m.MentorId" class="admin-row-action">
                                <i class="fa-solid fa-eye" aria-hidden="true"></i> @L["Admin_Mentors_Action_View"]
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr class="empty-row"><td colspan="8">@L["Admin_Mentors_NoData"]</td></tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPages > 1)
    {
        var cur = Model.Filter.Page; var tot = Model.TotalPages;
        int s = Math.Max(1, cur - 2); int e = Math.Min(tot, cur + 2);
        <div class="admin-card__footer">
            <small>@string.Format(L["Admin_Pagination_PageOf"], cur, tot)</small>
            <ul class="admin-pagination" aria-label="@L["Admin_Pagination_Aria"]">
                <li class="@(cur <= 1 ? "disabled" : "")">
                    <a asp-area="Admin" asp-controller="Mentors" asp-action="Index"
                       asp-route-Search="@Model.Filter.Search" asp-route-Status="@Model.Filter.Status"
                       asp-route-LicenseTypeId="@Model.Filter.LicenseTypeId" asp-route-Page="@(cur-1)">
                        <i class="fa-solid fa-chevron-left"></i>
                    </a>
                </li>
                @for (int i = s; i <= e; i++)
                {
                    <li class="@(i == cur ? "active" : "")">
                        <a asp-area="Admin" asp-controller="Mentors" asp-action="Index"
                           asp-route-Search="@Model.Filter.Search" asp-route-Status="@Model.Filter.Status"
                           asp-route-LicenseTypeId="@Model.Filter.LicenseTypeId" asp-route-Page="@i">@i</a>
                    </li>
                }
                <li class="@(cur >= tot ? "disabled" : "")">
                    <a asp-area="Admin" asp-controller="Mentors" asp-action="Index"
                       asp-route-Search="@Model.Filter.Search" asp-route-Status="@Model.Filter.Status"
                       asp-route-LicenseTypeId="@Model.Filter.LicenseTypeId" asp-route-Page="@(cur+1)">
                        <i class="fa-solid fa-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </div>
    }
</div>