@using Rokhsetak.Areas.Admin.ViewModels.Exams
@using Rokhsetak.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResourceMarker> L
@model AdminExamAppointmentListViewModel
@{
    ViewData["Title"] = L["Admin_Bookings_Title"];
    ViewData["Subtitle"] = L["Admin_Bookings_Subtitle"];
    ViewData["ActiveNav"] = "bookings";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var activeTab = ViewData["ActiveTab"] as string ?? "exams";

    string StatusPill(string s) => s switch {
        "scheduled" => "admin-pill--scheduled",
        "completed" => "admin-pill--completed",
        "cancelled" => "admin-pill--cancelled",
        _           => ""
    };
}

<ul class="admin-tabs" role="tablist">
    <li>
        <a class="nav-link @(activeTab == "bookings" ? "active" : "")"
           asp-area="Admin" asp-controller="Bookings" asp-action="Index"
           role="tab" aria-selected="@(activeTab == "bookings" ? "true" : "false")">
            <i class="fa-solid fa-calendar-check" aria-hidden="true"></i> @L["Admin_Bookings_Tab_Bookings"]
        </a>
    </li>
    <li>
        <a class="nav-link @(activeTab == "exams" ? "active" : "")"
           asp-area="Admin" asp-controller="Bookings" asp-action="Exams"
           role="tab" aria-selected="@(activeTab == "exams" ? "true" : "false")">
            <i class="fa-solid fa-graduation-cap" aria-hidden="true"></i> @L["Admin_Bookings_Tab_Exams"]
        </a>
    </li>
</ul>

<form asp-area="Admin" asp-controller="Bookings" asp-action="Exams" method="get" class="admin-card admin-card--padded">
    <div class="dash-filter">
        <div class="dash-filter-group" style="flex:2 1 220px">
            <label asp-for="Filter.Search">@L["Admin_Bookings_Filter_Search"]</label>
            <input asp-for="Filter.Search" class="admin-input" placeholder="@L["Admin_Exams_Filter_SearchPlaceholder"]" />
        </div>
        <div class="dash-filter-group">
            <label asp-for="Filter.Status">@L["Admin_Bookings_Filter_Status"]</label>
            <select asp-for="Filter.Status" class="admin-select">
                <option value="">@L["Admin_Exams_Filter_StatusOptions_All"]</option>
                <option value="scheduled">@L["Exam_Status_Scheduled"]</option>
                <option value="completed">@L["Exam_Status_Completed"]</option>
                <option value="cancelled">@L["Exam_Status_Cancelled"]</option>
            </select>
        </div>
        <div class="dash-filter-group">
            <label asp-for="Filter.FromDate">@L["Admin_Bookings_Filter_FromDate"]</label>
            <input asp-for="Filter.FromDate" type="date" class="admin-input" />
        </div>
        <div class="dash-filter-group">
            <label asp-for="Filter.ToDate">@L["Admin_Bookings_Filter_ToDate"]</label>
            <input asp-for="Filter.ToDate" type="date" class="admin-input" />
        </div>
        <div class="dash-filter-group" style="flex:0 1 130px">
            <label asp-for="Filter.TraineeId">@L["Admin_Bookings_Filter_TraineeId"]</label>
            <input asp-for="Filter.TraineeId" type="number" class="admin-input" placeholder="@L["Admin_Filter_IdPlaceholder"]" />
        </div>
        <button type="submit" class="admin-btn-primary" style="align-self:flex-end">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> @L["Admin_Bookings_Filter_Button"]
        </button>
    </div>
</form>

<div class="admin-card">
    <div class="admin-card__header admin-card__header--bordered">
        <h3>@L["Admin_Bookings_Tab_Exams"] <span class="admin-count-badge">@Model.TotalCount</span></h3>
    </div>
    <div style="overflow-x:auto">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>#</th><th>@L["Admin_Bookings_Table_Date"]</th><th>@L["Admin_Bookings_Table_Time"]</th><th>@L["Admin_Bookings_Table_Trainee"]</th>
                    <th>@L["Admin_Bookings_Table_License"]</th><th>@L["Admin_Exams_Table_Center"]</th><th>@L["Admin_Bookings_Table_Type"]</th><th>@L["Admin_Bookings_Table_Status"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ex in Model.Items)
                {
                    <tr>
                        <td style="color:var(--muted);font-size:.8rem">#@ex.ExamAppointmentId</td>
                        <td>@ex.ExamDate.ToString("dd MMM yyyy")</td>
                        <td style="font-variant-numeric:tabular-nums">@ex.ExamTime.ToString("HH:mm")</td>
                        <td><strong>@ex.TraineeName</strong></td>
                        <td>@ex.LicenseType</td>
                        <td>@ex.CenterName</td>
                        <td style="text-transform:capitalize">@L[$"Exam_{ex.ExamType}_Name"]</td>
                        <td><span class="admin-pill @StatusPill(ex.Status)">@L[$"Exam_Status_{char.ToUpper(ex.Status[0]) + ex.Status.Substring(1)}"]</span></td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr class="empty-row"><td colspan="8">@L["Admin_Exams_NoData"]</td></tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        var cur = Model.Filter.Page; var tot = Model.TotalPages;
        int s = Math.Max(1, cur - 2); int e = Math.Min(tot, cur + 2);
        <div class="admin-card__footer">
            <small>@string.Format(L["Admin_Pagination_PageOf"], cur, tot)</small>
            <ul class="admin-pagination" aria-label="@L["Admin_Pagination_Aria"]">
                <li class="@(cur <= 1 ? "disabled" : "")">
                    <a asp-area="Admin" asp-controller="Bookings" asp-action="Exams"
                       asp-route-Search="@Model.Filter.Search" asp-route-Status="@Model.Filter.Status"
                       asp-route-FromDate="@Model.Filter.FromDate" asp-route-ToDate="@Model.Filter.ToDate"
                       asp-route-TraineeId="@Model.Filter.TraineeId" asp-route-Page="@(cur - 1)"
                       aria-label="@L["Admin_Pagination_Previous"]">
                        <i class="fa-solid fa-chevron-left"></i>
                    </a>
                </li>
                @for (int i = s; i <= e; i++)
                {
                    <li class="@(i == cur ? "active" : "")">
                        <a asp-area="Admin" asp-controller="Bookings" asp-action="Exams"
                           asp-route-Search="@Model.Filter.Search" asp-route-Status="@Model.Filter.Status"
                           asp-route-FromDate="@Model.Filter.FromDate" asp-route-ToDate="@Model.Filter.ToDate"
                           asp-route-TraineeId="@Model.Filter.TraineeId" asp-route-Page="@i">@i</a>
                    </li>
                }
                <li class="@(cur >= tot ? "disabled" : "")">
                    <a asp-area="Admin" asp-controller="Bookings" asp-action="Exams"
                       asp-route-Search="@Model.Filter.Search" asp-route-Status="@Model.Filter.Status"
                       asp-route-FromDate="@Model.Filter.FromDate" asp-route-ToDate="@Model.Filter.ToDate"
                       asp-route-TraineeId="@Model.Filter.TraineeId" asp-route-Page="@(cur + 1)"
                       aria-label="@L["Admin_Pagination_Next"]">
                        <i class="fa-solid fa-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </div>
    }
</div>