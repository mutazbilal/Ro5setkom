@using Rokhsetak.Areas.Admin.ViewModels.Bookings
@model AdminBookingListViewModel
@{
    ViewData["Title"] = "Bookings & Exams";
    ViewData["Subtitle"] = "Sessions, exam appointments and their statuses";
    ViewData["ActiveNav"] = "bookings";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var activeTab = ViewData["ActiveTab"] as string ?? "bookings";

    string StatusPill(string s) => s switch {
        "pending"   => "admin-pill--pending",
        "confirmed" => "admin-pill--confirmed",
        "completed" => "admin-pill--completed",
        "cancelled" => "admin-pill--cancelled",
        _           => ""
    };
}

<ul class="admin-tabs" role="tablist">
    <li>
        <a class="nav-link @(activeTab == "bookings" ? "active" : "")"
           asp-area="Admin" asp-controller="Bookings" asp-action="Index"
           role="tab" aria-selected="@(activeTab == "bookings" ? "true" : "false")">
            <i class="fa-solid fa-calendar-check" aria-hidden="true"></i> Bookings
        </a>
    </li>
    <li>
        <a class="nav-link @(activeTab == "exams" ? "active" : "")"
           asp-area="Admin" asp-controller="Bookings" asp-action="Exams"
           role="tab" aria-selected="@(activeTab == "exams" ? "true" : "false")">
            <i class="fa-solid fa-graduation-cap" aria-hidden="true"></i> Exam appointments
        </a>
    </li>
</ul>

<form asp-area="Admin" asp-controller="Bookings" asp-action="Index" method="get" class="admin-card admin-card--padded">
    <div class="dash-filter">
        <div class="dash-filter-group" style="flex:2 1 220px">
            <label asp-for="Filter.Search">Search</label>
            <input asp-for="Filter.Search" class="admin-input" placeholder="Trainee or mentor name" />
        </div>
        <div class="dash-filter-group">
            <label asp-for="Filter.Status">Status</label>
            <select asp-for="Filter.Status" class="admin-select">
                <option value="">All</option>
                <option value="pending">Pending</option>
                <option value="confirmed">Confirmed</option>
                <option value="completed">Completed</option>
                <option value="cancelled">Cancelled</option>
            </select>
        </div>
        <div class="dash-filter-group">
            <label asp-for="Filter.FromDate">From</label>
            <input asp-for="Filter.FromDate" type="date" class="admin-input" />
        </div>
        <div class="dash-filter-group">
            <label asp-for="Filter.ToDate">To</label>
            <input asp-for="Filter.ToDate" type="date" class="admin-input" />
        </div>
        <div class="dash-filter-group" style="flex:0 1 120px">
            <label asp-for="Filter.MentorId">Mentor ID</label>
            <input asp-for="Filter.MentorId" type="number" class="admin-input" placeholder="ID" />
        </div>
        <div class="dash-filter-group" style="flex:0 1 120px">
            <label asp-for="Filter.TraineeId">Trainee ID</label>
            <input asp-for="Filter.TraineeId" type="number" class="admin-input" placeholder="ID" />
        </div>
        <button type="submit" class="admin-btn-primary" style="align-self:flex-end">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> Search
        </button>
    </div>
</form>

<div class="admin-card">
    <div class="admin-card__header admin-card__header--bordered">
        <h3>Bookings <span class="admin-count-badge">@Model.TotalCount</span></h3>
    </div>
    <div style="overflow-x:auto">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>#</th><th>Date</th><th>Time</th><th>Trainee</th>
                    <th>Mentor</th><th>License</th><th>Type</th><th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model.Items)
                {
                    <tr>
                        <td style="color:var(--muted);font-size:.8rem">#@b.BookingId</td>
                        <td>@b.BookingDate.ToString("dd MMM yyyy")</td>
                        <td style="font-variant-numeric:tabular-nums">@b.StartTime.ToString("HH:mm") – @b.EndTime.ToString("HH:mm")</td>
                        <td><strong>@b.TraineeName</strong></td>
                        <td>@b.MentorName</td>
                        <td>@b.LicenseType</td>
                        <td style="text-transform:capitalize">@b.SessionType</td>
                        <td><span class="admin-pill @StatusPill(b.Status)">@b.Status</span></td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr class="empty-row"><td colspan="8">No bookings match your filters.</td></tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        var cur = Model.Filter.Page; var tot = Model.TotalPages;
        int s = Math.Max(1, cur - 2); int e = Math.Min(tot, cur + 2);
        <div class="admin-card__footer">
            <small>Page @cur of @tot</small>
            <ul class="admin-pagination" aria-label="Page navigation">
                <li class="@(cur <= 1 ? "disabled" : "")">
                    <a asp-area="Admin" asp-controller="Bookings" asp-action="Index"
                       asp-route-Search="@Model.Filter.Search" asp-route-Status="@Model.Filter.Status"
                       asp-route-FromDate="@Model.Filter.FromDate" asp-route-ToDate="@Model.Filter.ToDate"
                       asp-route-MentorId="@Model.Filter.MentorId" asp-route-TraineeId="@Model.Filter.TraineeId"
                       asp-route-Page="@(cur - 1)" aria-label="Previous">
                        <i class="fa-solid fa-chevron-left"></i>
                    </a>
                </li>
                @for (int i = s; i <= e; i++)
                {
                    <li class="@(i == cur ? "active" : "")">
                        <a asp-area="Admin" asp-controller="Bookings" asp-action="Index"
                           asp-route-Search="@Model.Filter.Search" asp-route-Status="@Model.Filter.Status"
                           asp-route-FromDate="@Model.Filter.FromDate" asp-route-ToDate="@Model.Filter.ToDate"
                           asp-route-MentorId="@Model.Filter.MentorId" asp-route-TraineeId="@Model.Filter.TraineeId"
                           asp-route-Page="@i">@i</a>
                    </li>
                }
                <li class="@(cur >= tot ? "disabled" : "")">
                    <a asp-area="Admin" asp-controller="Bookings" asp-action="Index"
                       asp-route-Search="@Model.Filter.Search" asp-route-Status="@Model.Filter.Status"
                       asp-route-FromDate="@Model.Filter.FromDate" asp-route-ToDate="@Model.Filter.ToDate"
                       asp-route-MentorId="@Model.Filter.MentorId" asp-route-TraineeId="@Model.Filter.TraineeId"
                       asp-route-Page="@(cur + 1)" aria-label="Next">
                        <i class="fa-solid fa-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </div>
    }
</div>
