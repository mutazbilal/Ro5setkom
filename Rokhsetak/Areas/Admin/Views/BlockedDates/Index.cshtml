@model BlockedDateListViewModel
@{
    ViewData["Title"] = "Blocked dates";
    ViewData["Subtitle"] = "Days on which exam appointments cannot be booked";
}

<div class="row g-3">
    <div class="col-lg-4">
        <div class="admin-card admin-card--padded">
            <h4 class="mb-3"><i class="fa-solid fa-calendar-xmark"></i> Block a new date</h4>
            <form asp-area="Admin" asp-controller="BlockedDates" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label asp-for="NewBlockedDate.Date" class="form-label"></label>
                    <input asp-for="NewBlockedDate.Date" type="date" class="form-control" required />
                    <span asp-validation-for="NewBlockedDate.Date" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="NewBlockedDate.Reason" class="form-label"></label>
                    <input asp-for="NewBlockedDate.Reason" class="form-control" maxlength="255"
                           placeholder="e.g. Public holiday, system maintenance" />
                    <span asp-validation-for="NewBlockedDate.Reason" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn admin-btn-primary w-100">
                    <i class="fa-solid fa-ban"></i> Block date
                </button>
                <p class="text-muted small mt-3 mb-0">
                    Blocking a date prevents new exam appointments from being scheduled on that day.
                    Existing bookings are not affected.
                </p>
            </form>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="admin-card">
            <div class="admin-card__header admin-card__header--bordered">
                <h3>Active blocks <span class="admin-count-badge">@Model.Items.Count</span></h3>
            </div>
            <div class="table-responsive">
                <table class="table admin-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Reason</th>
                            <th>Created by</th>
                            <th>Created</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model.Items)
                        {
                            <tr>
                                <td><strong>@b.Date.ToString("dd MMM yyyy")</strong>
                                    <br /><small class="text-muted">@b.Date.ToString("dddd")</small>
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(b.Reason) ? "—" : b.Reason)</td>
                                <td>@b.CreatedByName</td>
                                <td>@(b.CreatedAt?.ToString("dd MMM yyyy HH:mm") ?? "—")</td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            data-bs-toggle="modal" data-bs-target="#deleteModal-@b.BlockedDateId">
                                        <i class="fa-solid fa-trash"></i> Remove
                                    </button>
                                </td>
                            </tr>
                        }
                        @if (!Model.Items.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted py-5">No blocked dates configured.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@foreach (var b in Model.Items)
{
    <div class="modal fade" id="deleteModal-@b.BlockedDateId" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form asp-area="Admin" asp-controller="BlockedDates" asp-action="Delete" method="post" class="modal-content">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@b.BlockedDateId" />
                <div class="modal-header">
                    <h5 class="modal-title">Remove blocked date?</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>You're about to remove the block on <strong>@b.Date.ToString("dd MMM yyyy")</strong>.</p>
                    <p class="text-muted small mb-0">
                        Trainees will be able to schedule new exam appointments for this date.
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn admin-btn-danger">
                        <i class="fa-solid fa-trash"></i> Remove
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
